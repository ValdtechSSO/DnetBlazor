FROM mcr.microsoft.com/dotnet/aspnet:11.0.0-alpine3.24 AS base
EXPOSE 80

# Blazor WASM Client
FROM mcr.microsoft.com/dotnet/sdk:11.0.100-alpine3.24 AS publishwasm
WORKDIR /workspace
COPY global.json Directory.Build.props ./
COPY src/Dnet.Blazor/Dnet.Blazor.csproj src/Dnet.Blazor/
COPY samples/Dnet.Shared/Dnet.App.Shared.csproj samples/Dnet.Shared/
COPY samples/Dnet.ClientSide/Dnet.App.ClientSide.csproj samples/Dnet.ClientSide/
RUN dotnet restore samples/Dnet.ClientSide/Dnet.App.ClientSide.csproj

COPY src/Dnet.Blazor/ src/Dnet.Blazor/
COPY samples/Dnet.Shared/ samples/Dnet.Shared/
COPY samples/Dnet.ClientSide/ samples/Dnet.ClientSide/
ARG DNET_DEMO_VERSION
RUN dotnet publish samples/Dnet.ClientSide/Dnet.App.ClientSide.csproj -c Release --no-restore -o /app/wasm/publish

# Kestrel
FROM mcr.microsoft.com/dotnet/sdk:11.0.100-alpine3.24 AS publishkestrel
WORKDIR /workspace
COPY global.json Directory.Build.props ./
COPY samples/Dnet.App.KestrelServer/Dnet.App.KestrelServer.csproj samples/Dnet.App.KestrelServer/
RUN dotnet restore samples/Dnet.App.KestrelServer/Dnet.App.KestrelServer.csproj

COPY samples/Dnet.App.KestrelServer/ samples/Dnet.App.KestrelServer/
RUN dotnet publish samples/Dnet.App.KestrelServer/Dnet.App.KestrelServer.csproj -c Release --no-restore -o /app/publish
COPY --from=publishwasm /app/wasm/publish/wwwroot /app/publish/wwwroot

FROM base AS final
WORKDIR /app
COPY --from=publishkestrel /app/publish .
ENTRYPOINT ["dotnet", "Dnet.App.KestrelServer.dll"]
