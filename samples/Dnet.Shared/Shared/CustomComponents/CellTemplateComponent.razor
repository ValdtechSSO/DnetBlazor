@using Dnet.App.Shared.Infrastructure.Entities
@using Dnet.Blazor.Components.Grid.Infrastructure.Entities

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

@if (RowNode.RowData.IsActive)
{
    <span style="color: green">@S.Display(RowNode.RowData.IsActive)</span>

}
else
{
    <span style="color: red">@S.Display(RowNode.RowData.IsActive)</span>
}

@code {

    [Parameter]
    public RowNode<Person> RowNode { get; set; }
}
