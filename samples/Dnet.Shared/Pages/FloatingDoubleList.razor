@page "/FloatingDoubleList"
@using Dnet.Blazor.Components.Button
@using Dnet.Blazor.Components.FloatingDoubleList
@using Dnet.Blazor.Components.FloatingDoubleList.Infrastructure.Models
@using Dnet.Blazor.Components.Form
@using Dnet.Blazor.Components.List

<DnetLocalizationObserver OnChanged="RefreshSampleLanguage" />

<DemoPage Id="demo-floating-doublelist" Title="@S["FloatingDoubleList.FloatingDoubleList"]" Category="@S["FloatingDoubleList.SelectionAndAssignment"]"
          Description="@S["FloatingDoubleList.OrganizeATeamFromACompactFieldOpen"]"
          Badge="@S["FloatingDoubleList.SearchAssignReview"]">
    <DemoCard Id="floating-doublelist-assignment" Title="@S["FloatingDoubleList.OneTeamOnTheSamePage"]" Eyebrow="@S["FloatingDoubleList.01ProjectAssignment"]"
              Description="@S["FloatingDoubleList.ChooseWhoJoinsProjectAtlasChangesAppearImmediately"]">
        <ChildContent>
            <div class="floating-doublelist-workspace">
                <div class="demo-stack">
                    <div class="floating-doublelist-context"><span class="floating-doublelist-tag">@S["FloatingDoubleList.ProjectAtlas"]</span><span class="demo-info">@S["FloatingDoubleList.10People1FixedLead"]</span></div>
                    <EditForm Model="_form">
                        <div id="floating-doublelist-field">
                            <DnetFormField Label="@S["FloatingDoubleList.AssignedPeople"]" IsRequired="true">
                                <ChildContent>
                                    <DnetFloatingDoubleList @key="_fieldRevision" TItem="Contact" @bind-Value="_form.Selection"
                                                            LeftItems="_availablePeople" RightItems="_assignedPeople"
                                                            LeftListOptions="_availableOptions" RightListOptions="_assignedOptions"
                                                            SearchControlOptions="SearchLabels" EqualityComparer="Comparer"
                                                            DisplayValueConverter="person => person.Name" DisplayName="@S["FloatingDoubleList.AssignedPeople"]"
                                                            SideForSelections="ListToShow.Right" DisabledClearButton="true"
                                                            Width="450px" Height="430px" MaxWidth="calc(100vw - 24px)" MaxHeight="calc(100dvh - 64px)"
                                                            InputItemHeight="24" OnSelectionChanged="SelectionChanged">
                                        <ItemPrefixContent Context="person"><span class="floating-doublelist-avatar" aria-hidden="true">@Initials(person.Name)</span></ItemPrefixContent>
                                        <ListItemContent Context="person">
                                            <span class="floating-doublelist-person-copy">
                                                <span class="dnet-list-item-headline floating-doublelist-person-name">@person.Name</span>
                                                <span class="dnet-list-item-supporting-text floating-doublelist-person-role">@(person.IsLocked ? S.Text("Fixed · ") : null)@S.Display(person.Role)</span>
                                            </span>
                                        </ListItemContent>
                                    </DnetFloatingDoubleList>
                                </ChildContent>
                            </DnetFormField>
                        </div>
                    </EditForm>
                    <p id="floating-doublelist-status" class="demo-status" role="status">@S.Display(_lastAction)</p>
                    <p class="demo-info">@S["FloatingDoubleList.YourSelectionStaysWhenThePanelClosesAnd"]</p>
                </div>
                <aside class="floating-doublelist-guide" aria-labelledby="floating-doublelist-guide-title">
                    <span class="floating-doublelist-guide-eyebrow">@S["FloatingDoubleList.HowItWorks"]</span>
                    <h3 id="floating-doublelist-guide-title">@S["FloatingDoubleList.FromDirectoryToTeam"]</h3>
                    <ol class="floating-doublelist-steps">
                        <li><span aria-hidden="true">1</span><div><strong>@S["FloatingDoubleList.FindThePerson"]</strong><p>@S["FloatingDoubleList.SearchByNameInAvailableOrAssignedPeople"]</p></div></li>
                        <li><span aria-hidden="true">2</span><div><strong>@S["FloatingDoubleList.ChangeTheirAssignment"]</strong><p>@S["FloatingDoubleList.ClickTheirNameToMoveThemOnDesktop"]</p></div></li>
                        <li><span aria-hidden="true">3</span><div><strong>@S["FloatingDoubleList.ReviewTheResult"]</strong><p>@S["FloatingDoubleList.OnMobileUseThePanelToggleToSwitch"]</p></div></li>
                    </ol>
                </aside>
            </div>
        </ChildContent>
        <Footer>
            <div class="floating-doublelist-metrics" role="status">
                <span id="floating-doublelist-available-count"><strong>@S.Display(_availablePeople.Count)</strong> @S["FloatingDoubleList.Available"]</span>
                <span id="floating-doublelist-assigned-count"><strong>@S.Display(_assignedPeople.Count)</strong> @S["FloatingDoubleList.Assigned"]</span>
                <span><strong>1</strong> @S["FloatingDoubleList.FixedLead"]</span>
            </div>
        </Footer>
    </DemoCard>

    <div class="demo-grid">
        <DemoCard Id="floating-doublelist-team" Title="@S["FloatingDoubleList.TheAtlasTeam"]" Eyebrow="@S["FloatingDoubleList.02LiveSummary"]"
                  Description="@S["FloatingDoubleList.ThesePeopleHaveAccessToTheProjectThe"]">
            <ChildContent>
                <ul id="floating-doublelist-roster" class="floating-doublelist-roster">
                    @foreach (var person in _assignedPeople.OrderBy(person => person.Name))
                    {
                        <li @key="person.Id">
                            <span class="floating-doublelist-avatar" aria-hidden="true">@Initials(person.Name)</span>
                            <span class="floating-doublelist-person-copy"><strong>@person.Name</strong><span>@S.Display(person.Role)</span></span>
                            @if (person.IsLocked) { <span class="floating-doublelist-fixed">@S["PickList.Fixed"]</span> }
                        </li>
                    }
                </ul>
                <div class="demo-actions floating-doublelist-reset"><DnetButton id="floating-doublelist-reset" Variant="DnetButtonVariant.Outlined" OnClick="ResetAssignment">@S["FloatingDoubleList.RestoreTheInitialTeam"]</DnetButton></div>
            </ChildContent>
            <Footer><span class="demo-info">@S["FloatingDoubleList.RestoreTheOriginalFivePeopleAndClearThe"]</span></Footer>
        </DemoCard>

        <DemoCard Id="floating-doublelist-readonly-card" Title="@S["FloatingDoubleList.AReadOnlySelection"]" Eyebrow="@S["FloatingDoubleList.03DisabledState"]"
                  Description="@S["FloatingDoubleList.TheSameTeamCanAppearInADisabled"]">
            <div class="demo-stack">
                <EditForm Model="_form">
                    <div id="floating-doublelist-readonly">
                        <DnetFormField Label="@S["FloatingDoubleList.CurrentTeam"]">
                            <DnetFloatingDoubleList @key="_selectionRevision" TItem="Contact" @bind-Value="_form.Selection"
                                                    LeftItems="_availablePeople" RightItems="_assignedPeople"
                                                    LeftListOptions="_availableOptions" RightListOptions="_assignedOptions"
                                                    DisplayValueConverter="person => person.Name" DisplayName="@S["FloatingDoubleList.CurrentTeam"]"
                                                    SideForSelections="ListToShow.Right" Disabled="true" DisabledClearButton="true" InputItemHeight="24" />
                        </DnetFormField>
                    </div>
                </EditForm>
                <div class="floating-doublelist-readonly-note"><strong>@S["FloatingDoubleList.VisibleReadOnly"]</strong><p>@S["FloatingDoubleList.TheFieldFollowsChangesInTheMainExample"]</p></div>
                <p class="demo-info">@S["FloatingDoubleList.NamesStayOnASingleLineTheTeam"]</p>
            </div>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private Task RefreshSampleLanguage() => InvokeAsync(() =>
    {
        _availableOptions.HeaderText = S.Text(_availableOptions.HeaderText);
        _assignedOptions.HeaderText = S.Text(_assignedOptions.HeaderText);
        SearchLabels.LeftLabel = S.Text(SearchLabels.LeftLabel);
        SearchLabels.RightLabel = S.Text(SearchLabels.RightLabel);
        SearchLabels.LeftPlaceHolder = S.Text(SearchLabels.LeftPlaceHolder);
        SearchLabels.RightPlaceHolder = S.Text(SearchLabels.RightPlaceHolder);
        StateHasChanged();
    });

    #nullable enable

    private readonly Contact[] _people =
    [
        new(1, "Alex Rivera", "Diseño de producto"),
        new(2, "Sam Chen", "Desarrollo frontend"),
        new(3, "Casey Brooks", "Investigación UX"),
        new(4, "Morgan Patel", "Calidad y pruebas"),
        new(5, "Jamie Torres", "Gestión de producto"),
        new(6, "Taylor Morgan", "Responsable del proyecto", true),
        new(7, "Riley Parker", "Desarrollo backend"),
        new(8, "Jordan Lee", "Análisis de datos"),
        new(9, "Avery Scott", "Diseño de contenido"),
        new(10, "Cameron Reed", "Plataforma e infraestructura")
    ];
    private static readonly IEqualityComparer<Contact> Comparer = new ContactComparer();
    private readonly SearchControlOptions SearchLabels = new()
    {
        LeftLabel = "Buscar", LeftPlaceHolder = "Por nombre",
        RightLabel = "Buscar", RightPlaceHolder = "Por nombre"
    };
    private readonly SelectionForm _form = new();
    private List<Contact> _availablePeople = [];
    private List<Contact> _assignedPeople = [];
    private ListOptions<Contact> _availableOptions = new();
    private ListOptions<Contact> _assignedOptions = new();
    private int _fieldRevision;
    private int _selectionRevision;
    private string _lastAction = "Abre el selector para organizar el equipo de Atlas.";

    protected override void OnInitialized()
    {
        _availableOptions = CreateOptions("Disponibles");
        _assignedOptions = CreateOptions("Asignados");
        RestorePeople();
        _ = RefreshSampleLanguage();
    }

    private ListOptions<Contact> CreateOptions(string title) => new()
    {
        DisplayValueConverter = person => person.Name,
        SupportTextValueConverter = person => S.Text(person.Role),
        SearchValueConverter = person => person.Name,
        SortedData = person => person.Name,
        DisableItem = person => person.IsLocked,
        HeaderText = S.Text(title),
        ItemSize = 56,
        PageSize = 10,
        EnableServerSide = false,
        EnableSearching = true,
        EnableSorting = true,
        EnablePagingination = false,
        ShowHeader = true,
        ShowFooter = false,
        CheckboxSelectionColumn = false,
        MultiSelect = true
    };

    private void SelectionChanged(TransferredItems<Contact> transfer)
    {
        var previous = _assignedPeople.Count;
        // The panel owns mutable lists. Keep snapshots so reopening preserves the assignment.
        _availablePeople = transfer.LeftItems.ToList();
        _assignedPeople = transfer.RightItems.ToList();
        var difference = _assignedPeople.Count - previous;
        _lastAction = difference > 0
            ? $"Equipo actualizado: {difference} {(difference == 1 ? "persona añadida" : "personas añadidas")} al proyecto."
            : $"Equipo actualizado: {-difference} {(difference == -1 ? "persona devuelta" : "personas devueltas")} a disponibles.";
        UpdateSelectionSummary();
    }

    private void UpdateSelectionSummary()
    {
        _form.Selection = string.Join(", ", _assignedPeople.Select(person => person.Name));
        _selectionRevision++;
    }

    private void RestorePeople()
    {
        _availablePeople = _people.Take(5).ToList();
        _assignedPeople = _people.Skip(5).ToList();
        UpdateSelectionSummary();
    }

    private void ResetAssignment()
    {
        RestorePeople();
        _fieldRevision++;
        _lastAction = "Se ha restaurado el equipo inicial. Las búsquedas y la selección del panel se han limpiado.";
    }

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0]));

    private sealed record Contact(int Id, string Name, string Role, bool IsLocked = false);
    private sealed class SelectionForm { public string Selection { get; set; } = string.Empty; }
    private sealed class ContactComparer : IEqualityComparer<Contact>
    {
        public bool Equals(Contact? first, Contact? second) => first?.Id == second?.Id;
        public int GetHashCode(Contact person) => person.Id;
    }
}
