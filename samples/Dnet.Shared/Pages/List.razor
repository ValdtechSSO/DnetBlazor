@page "/List"
@using Dnet.App.Shared.Infrastructure.Entities
@using Dnet.App.Shared.Infrastructure.Services
@using Dnet.Blazor.Components.List
@using Dnet.Blazor.Components.Checkbox
@using Dnet.Blazor.Components.Button

@inject IApplicationServiceService ApplicationServiceService

<DemoPage Id="demo-list" Title="List" Category="Data display"
          Description="Browse a contact directory, narrow the results and build a selection across pages." Badge="Search · Select · Page">
    <div class="demo-grid">
        <DemoCard Id="list-directory-card" Title="Contact directory" Eyebrow="Interactive list"
                  Description="Search by name, select available contacts and use the footer to explore the directory.">
            <ChildContent>
                @if (_loading)
                {
                    <div class="list-loading" role="status">Loading contacts…</div>
                }
                else if (_loadFailed)
                {
                    <div class="list-loading" role="status">The contact directory could not be loaded.</div>
                }
                else
                {
                    <div id="list-directory" class="list-stage">
                        <DnetList @key="_listRevision" TItem="Person" Items="_items" ListOptions="_listOptions"
                                  Label="Search contacts" PlaceHolder="Type a name" OnSelectionChange="SelectionChanged">
                            <ItemPrefixContent Context="person"><span class="list-avatar" aria-hidden="true">@Initials(person.Name)</span></ItemPrefixContent>
                            <ListItemContent Context="person">
                                <div class="list-contact" @onclick:stopPropagation="true">
                                    <span class="dnet-list-item-headline @(person.IsActive ? "disabled" : null)">@person.Name</span>
                                    <span class="dnet-list-item-supporting-text @(person.IsActive ? "disabled" : null)">@person.Address</span>
                                </div>
                            </ListItemContent>
                        </DnetList>
                    </div>
                }
            </ChildContent>
            <Footer><span id="list-directory-value" role="status">@_items.Count contacts available · @_selectedItems.Count selected</span></Footer>
        </DemoCard>

        <div class="demo-stack">
            <DemoCard Id="list-options" Title="Make it your own" Description="Change the directory controls. Changing an option starts a fresh selection.">
                <div class="list-option-grid">
                    <div class="demo-option-row"><DnetInputCheckbox id="list-option-search" @bind-Value="_searching" @bind-Value:after="ApplyOptions">Search</DnetInputCheckbox></div>
                    <div class="demo-option-row"><DnetInputCheckbox id="list-option-checkboxes" @bind-Value="_checkboxes" @bind-Value:after="ApplyOptions">Selection checkboxes</DnetInputCheckbox></div>
                    <div class="demo-option-row"><DnetInputCheckbox id="list-option-sorting" @bind-Value="_sorting" @bind-Value:after="ApplyOptions">Sorting</DnetInputCheckbox></div>
                    <div class="demo-option-row"><DnetInputCheckbox id="list-option-header" @bind-Value="_header" @bind-Value:after="ApplyOptions">Header</DnetInputCheckbox></div>
                    <div class="demo-option-row"><DnetInputCheckbox id="list-option-pagination" @bind-Value="_pagination" @bind-Value:after="PaginationOptionChanged">Pagination</DnetInputCheckbox></div>
                    <div class="demo-option-row"><DnetInputCheckbox id="list-option-footer" @bind-Value="_footer" @bind-Value:after="FooterOptionChanged">Footer</DnetInputCheckbox></div>
                </div>
                <p class="demo-info">Select the Contacts header to change the sort order. Unavailable contacts appear dimmed.</p>
            </DemoCard>
            <DemoCard Id="list-selection" Title="Your selection" Description="Selected contacts appear here as you work through the directory.">
                <ChildContent>
                    @if (_selectedItems.Count == 0)
                    {
                        <div class="list-empty"><strong>No contacts selected</strong><p class="demo-muted">Choose a contact in the directory to build your selection.</p></div>
                    }
                    else
                    {
                        <ul id="list-selected-names" class="demo-bullets">
                            @foreach (var person in _selectedItems.Take(6))
                            {
                                <li>@person.Name</li>
                            }
                        </ul>
                        @if (_selectedItems.Count > 6)
                        {
                            <p class="demo-info">And @(_selectedItems.Count - 6) more contacts.</p>
                        }
                    }
                    <div class="demo-actions list-selection-actions"><DnetButton Variant="DnetButtonVariant.Outlined" id="list-reset" disabled="@(_loading || _loadFailed)" OnClick="ResetDirectory">Reset directory</DnetButton></div>
                </ChildContent>
                <Footer><span id="list-selected-count" role="status">@_selectedItems.Count selected</span></Footer>
            </DemoCard>
        </div>
    </div>
</DemoPage>

@code {
    private List<Person> _items = new();
    private List<Person> _selectedItems = new();
    private ListOptions<Person> _listOptions = new();
    private bool _loading = true;
    private bool _loadFailed;
    private bool _searching = true;
    private bool _checkboxes = true;
    private bool _sorting = true;
    private bool _header = true;
    private bool _pagination = true;
    private bool _footer = true;
    private int _listRevision;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = (await ApplicationServiceService.GetPersons()).OrderBy(person => person.Name).ToList();
            _listOptions = CreateOptions();
        }
        catch (HttpRequestException)
        {
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private ListOptions<Person> CreateOptions() => new()
    {
        DisplayValueConverter = person => person.Name,
        SupportTextValueConverter = person => person.Address,
        SortedData = person => person.Name,
        SearchValueConverter = person => person.Name,
        DisableItem = person => person.IsActive,
        HeaderText = "Contacts",
        ItemSize = 56,
        MultiSelect = true,
        DebounceTime = 250,
        EnableServerSide = false,
        EnableSearching = _searching,
        EnableSorting = _sorting,
        PageSize = _pagination ? 5 : Math.Max(_items.Count, 1),
        EnablePagingination = _pagination,
        CheckboxSelectionColumn = _checkboxes,
        ShowHeader = _header,
        ShowFooter = _footer
    };

    private void SelectionChanged(List<Person> selected) => _selectedItems = selected;

    private void ApplyOptions()
    {
        _listOptions = CreateOptions();
        ResetDirectory();
    }

    private void PaginationOptionChanged()
    {
        if (_pagination) _footer = true;
        ApplyOptions();
    }

    private void FooterOptionChanged()
    {
        if (!_footer) _pagination = false;
        ApplyOptions();
    }

    private void ResetDirectory()
    {
        _selectedItems = new();
        _listRevision++;
    }

    private static string Initials(string name)
        => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();
}
