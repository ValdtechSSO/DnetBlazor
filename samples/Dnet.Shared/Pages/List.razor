@page "/List"
@using Dnet.App.Shared.Infrastructure.Entities
@using Dnet.App.Shared.Infrastructure.Services
@using Dnet.Blazor.Components.List
@using Dnet.Blazor.Components.Checkbox
@using Dnet.Blazor.Components.Button

@inject IApplicationServiceService ApplicationServiceService

<DnetLocalizationObserver OnChanged="RefreshSampleLanguage" />

<DemoPage Id="demo-list" Title="@S["List.List"]" Category="@S["Tree.DataDisplay"]"
          Description="@S["List.BrowseAContactDirectoryNarrowTheResultsAnd"]" Badge="@S["List.SearchSelectPage"]">
    <div class="demo-grid">
        <DemoCard Id="list-directory-card" Title="@S["List.ContactDirectory"]" Eyebrow="@S["List.InteractiveList"]"
                  Description="@S["List.SearchByNameSelectAvailableContactsAndUse"]">
            <ChildContent>
                @if (_loading)
                {
                    <div class="list-loading" role="status">@S["List.LoadingContacts"]</div>
                }
                else if (_loadFailed)
                {
                    <div class="list-loading" role="status">@S["List.TheContactDirectoryCouldNotBeLoaded"]</div>
                }
                else
                {
                    <div id="list-directory" class="list-stage">
                        <DnetList @key="_listRevision" TItem="Person" Items="_items" ListOptions="_listOptions"
                                  Label="@S["List.SearchContacts"]" PlaceHolder="@S["List.TypeAName"]" OnSelectionChange="SelectionChanged">
                            <ItemPrefixContent Context="person"><span class="list-avatar" aria-hidden="true">@Initials(person.Name)</span></ItemPrefixContent>
                            <ListItemContent Context="person">
                                <div class="list-contact" @onclick:stopPropagation="true">
                                    <span class="dnet-list-item-headline @(person.IsActive ? "disabled" : null)">@person.Name</span>
                                    <span class="dnet-list-item-supporting-text @(person.IsActive ? "disabled" : null)">@person.Address</span>
                                </div>
                            </ListItemContent>
                        </DnetList>
                    </div>
                }
            </ChildContent>
            <Footer><span id="list-directory-value" role="status">@S.Format("Common.0ContactsAvailable1Selected", _items.Count, _selectedItems.Count)</span></Footer>
        </DemoCard>

        <div class="demo-stack">
            <DemoCard Id="list-options" Title="@S["List.MakeItYourOwn"]" Description="@S["List.ChangeTheDirectoryControlsChangingAnOptionStarts"]">
                <div class="list-option-grid">
                    <div class="demo-option-row"><DnetInputCheckbox id="list-option-search" @bind-Value="_searching" @bind-Value:after="ApplyOptions">@S["List.Search"]</DnetInputCheckbox></div>
                    <div class="demo-option-row"><DnetInputCheckbox id="list-option-checkboxes" @bind-Value="_checkboxes" @bind-Value:after="ApplyOptions">@S["List.SelectionCheckboxes"]</DnetInputCheckbox></div>
                    <div class="demo-option-row"><DnetInputCheckbox id="list-option-sorting" @bind-Value="_sorting" @bind-Value:after="ApplyOptions">@S["List.Sorting"]</DnetInputCheckbox></div>
                    <div class="demo-option-row"><DnetInputCheckbox id="list-option-header" @bind-Value="_header" @bind-Value:after="ApplyOptions">@S["List.Header"]</DnetInputCheckbox></div>
                    <div class="demo-option-row"><DnetInputCheckbox id="list-option-pagination" @bind-Value="_pagination" @bind-Value:after="PaginationOptionChanged">@S["List.Pagination"]</DnetInputCheckbox></div>
                    <div class="demo-option-row"><DnetInputCheckbox id="list-option-footer" @bind-Value="_footer" @bind-Value:after="FooterOptionChanged">@S["List.Footer"]</DnetInputCheckbox></div>
                </div>
                <p class="demo-info">@S["List.SelectTheContactsHeaderToChangeTheSort"]</p>
            </DemoCard>
            <DemoCard Id="list-selection" Title="@S["List.YourSelection"]" Description="@S["List.SelectedContactsAppearHereAsYouWorkThrough"]">
                <ChildContent>
                    @if (_selectedItems.Count == 0)
                    {
                        <div class="list-empty"><strong>@S["List.NoContactsSelected"]</strong><p class="demo-muted">@S["List.ChooseAContactInTheDirectoryToBuild"]</p></div>
                    }
                    else
                    {
                        <ul id="list-selected-names" class="demo-bullets">
                            @foreach (var person in _selectedItems.Take(6))
                            {
                                <li>@person.Name</li>
                            }
                        </ul>
                        @if (_selectedItems.Count > 6)
                        {
                            <p class="demo-info">@S.Format("Common.And0MoreContacts", _selectedItems.Count - 6)</p>
                        }
                    }
                    <div class="demo-actions list-selection-actions"><DnetButton Variant="DnetButtonVariant.Outlined" id="list-reset" disabled="@(_loading || _loadFailed)" OnClick="ResetDirectory">@S["List.ResetDirectory"]</DnetButton></div>
                </ChildContent>
                <Footer><span id="list-selected-count" role="status">@S.Format("Common.0Selected", _selectedItems.Count)</span></Footer>
            </DemoCard>
        </div>
    </div>
</DemoPage>

@code {
    private Task RefreshSampleLanguage() => InvokeAsync(() =>
    {
        _listOptions.HeaderText = S.Text(_listOptions.HeaderText);
        StateHasChanged();
    });

    private List<Person> _items = new();
    private List<Person> _selectedItems = new();
    private ListOptions<Person> _listOptions = new();
    private bool _loading = true;
    private bool _loadFailed;
    private bool _searching = true;
    private bool _checkboxes = true;
    private bool _sorting = true;
    private bool _header = true;
    private bool _pagination = true;
    private bool _footer = true;
    private int _listRevision;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = (await ApplicationServiceService.GetPersons()).OrderBy(person => person.Name).ToList();
            _listOptions = CreateOptions();
        }
        catch (HttpRequestException)
        {
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private ListOptions<Person> CreateOptions() => new()
    {
        DisplayValueConverter = person => person.Name,
        SupportTextValueConverter = person => S.Text(person.Address),
        SortedData = person => person.Name,
        SearchValueConverter = person => person.Name,
        DisableItem = person => person.IsActive,
        HeaderText = S.Text("Contacts"),
        ItemSize = 56,
        MultiSelect = true,
        DebounceTime = 250,
        EnableServerSide = false,
        EnableSearching = _searching,
        EnableSorting = _sorting,
        PageSize = _pagination ? 5 : Math.Max(_items.Count, 1),
        EnablePagingination = _pagination,
        CheckboxSelectionColumn = _checkboxes,
        ShowHeader = _header,
        ShowFooter = _footer
    };

    private void SelectionChanged(List<Person> selected) => _selectedItems = selected;

    private void ApplyOptions()
    {
        _listOptions = CreateOptions();
        ResetDirectory();
    }

    private void PaginationOptionChanged()
    {
        if (_pagination) _footer = true;
        ApplyOptions();
    }

    private void FooterOptionChanged()
    {
        if (!_footer) _pagination = false;
        ApplyOptions();
    }

    private void ResetDirectory()
    {
        _selectedItems = new();
        _listRevision++;
    }

    private static string Initials(string name)
        => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();
}
