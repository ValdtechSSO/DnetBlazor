@page "/Forms"
@using System.Globalization
@using Dnet.App.Shared.Infrastructure.Entities
@using Dnet.App.Shared.Infrastructure.Services
@using Dnet.Blazor.Components.Autocomplete
@using Dnet.Blazor.Components.DatePicker
@using Dnet.Blazor.Components.Form
@using Dnet.Blazor.Components.Select
@using Dnet.Blazor.Infrastructure.Services

@inject IApplicationServiceService ApplicationServiceService

<div id="forms-page" class="forms-page" aria-labelledby="forms-title">
    <header class="forms-header">
        <div>
            <p class="forms-eyebrow">Components / Forms</p>
            <h1 id="forms-title" class="forms-title">Form controls</h1>
            <p class="forms-description">A place for every detail. Explore text fields, selections and dates with a consistent look and feel.</p>
        </div>
        <a class="forms-validation-link" href="FormValidation">Explore validation <span aria-hidden="true">↗</span></a>
    </header>

    <section id="forms-appearance" class="forms-appearance" aria-labelledby="forms-appearance-title">
        <span class="forms-appearance-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="M7 9h10M7 13h6" /></svg>
        </span>
        <div class="forms-appearance-copy">
            <h2 id="forms-appearance-title">Make it your own</h2>
            <p>Switch the field style as you explore. Your values stay in place.</p>
        </div>
        <div class="forms-appearance-control">
            <label for="form-appearance-select">Field appearance</label>
            <select id="form-appearance-select" @bind="_appearance">
                <option value="@FormAppearance.Fill">Filled background</option>
                <option value="@FormAppearance.Standard">Transparent</option>
            </select>
        </div>
    </section>

    <EditForm id="forms-example" EditContext="_editContext" class="forms-example-form">
        <DataAnnotationsValidator />
        <section id="forms-contact" class="forms-card" aria-labelledby="forms-contact-title">
            <div class="forms-card-header">
                <span class="forms-card-icon" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="3.5" /><path d="M5 21v-2a7 7 0 0 1 14 0v2" /></svg>
                </span>
                <div><p class="forms-card-kicker">01 / Profile</p><h2 id="forms-contact-title">Contact details</h2><p>Text, autocomplete and selection in one place.</p></div>
            </div>
            <div class="forms-card-body forms-fields">
                <div class="forms-field">
                    <DnetFormField Appearance="_appearance" Label="Last name" UseClearButton="true" IsRequired="true">
                        <ChildContent><DnetInputText id="forms-last-name" @bind-Value="_person.LastName" aria-label="Last name" autocomplete="family-name" /></ChildContent>
                        <HintContent>Clear this field to disable email.</HintContent>
                        <ErrorContent><ValidationMessage For="@(() => _person.LastName)" /></ErrorContent>
                    </DnetFormField>
                </div>
                <div class="forms-field">
                    <DnetFormField Appearance="_appearance" Label="Name" UseClearButton="true" IsRequired="true">
                        <ChildContent>
                            <DnetAutocomplete TValue="string" TItem="Person" @bind-Value="_person.Name" Items="_items"
                                              DisplayValueConverter="value => value.Name" ValueConverter="value => value.Name"
                                              InputTextToUpper="true" SortBy="_sortBy" FilterBy="_filterBy" aria-label="Name" />
                        </ChildContent>
                        <HintContent>Search the sample contacts.</HintContent>
                        <ErrorContent><ValidationMessage For="@(() => _person.Name)" /></ErrorContent>
                    </DnetFormField>
                </div>
                <div class="forms-field forms-field-wide">
                    <DnetFormField Appearance="_appearance" Label="Email" UseClearButton="true" IsRequired="true">
                        <ChildContent><DnetInputText id="forms-email" @bind-Value="_person.Email" Disabled="@(string.IsNullOrEmpty(_person.LastName))" aria-label="Email" autocomplete="email" /></ChildContent>
                        <ErrorContent><ValidationMessage For="@(() => _person.Email)" /></ErrorContent>
                    </DnetFormField>
                </div>
                <div class="forms-field forms-field-wide">
                    <DnetFormField Appearance="_appearance" Label="Gender" IsRequired="true">
                        <ChildContent>
                            <DnetSelect TValue="string" TItem="Gender" @bind-Value="_person.Gender" Items="_genders"
                                        DisplayValueConverter="value => value.Name" ValueConverter="value => value.Name"
                                        ResponsiveLabel="Gender" />
                        </ChildContent>
                        <ErrorContent><ValidationMessage For="@(() => _person.Gender)" /></ErrorContent>
                    </DnetFormField>
                </div>
            </div>
        </section>

        <section id="forms-dates" class="forms-card" aria-labelledby="forms-dates-title">
            <div class="forms-card-header">
                <span class="forms-card-icon" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M7 3v4m10-4v4M3 11h18M7 15h3m4 0h3" /></svg>
                </span>
                <div><p class="forms-card-kicker">02 / Details</p><h2 id="forms-dates-title">Dates &amp; values</h2><p>Pick a day, enter a number or set an amount.</p></div>
            </div>
            <div class="forms-card-body forms-fields">
                <div class="forms-field forms-field-wide">
                    <DnetFormField Appearance="_appearance" Label="Departure day" UseClearButton="true">
                        <ChildContent>
                            <DnetDatePicker @bind-Value="_person.StartDate" MaxDayValue="DateTime.Now" MinDayValue="DateTime.Now.AddDays(-10)"
                                            FirstDayToShow="DateTime.Now" DatepickerFilter="day => day.DayIndex == 0" aria-label="Departure day" />
                        </ChildContent>
                        <SufixContent><div class="dnet-datepicker-icon-wrapper"><span class="dnet-datepicker-icon" aria-hidden="true"></span></div></SufixContent>
                        <HintContent>A calendar with a limited date range.</HintContent>
                        <ErrorContent><ValidationMessage For="@(() => _person.StartDate)" /></ErrorContent>
                    </DnetFormField>
                </div>
                <div class="forms-field forms-field-wide">
                    <DnetFormField Appearance="_appearance" Label="Birthday">
                        <ChildContent><DnetInputDate @bind-Value="_person.Birthday" aria-label="Birthday" autocomplete="bday" /></ChildContent>
                        <HintContent>Choose a date using the native date picker.</HintContent>
                        <ErrorContent><ValidationMessage For="@(() => _person.Birthday)" /></ErrorContent>
                    </DnetFormField>
                </div>
                <div class="forms-field">
                    <DnetFormField Appearance="_appearance" Label="Age">
                        <ChildContent><DnetInputNumber @bind-Value="_person.Age" Min="0" Max="50" Step="1" aria-label="Age" /></ChildContent>
                        <HintContent>Between 0 and 50 years.</HintContent>
                        <ErrorContent><ValidationMessage For="@(() => _person.Age)" /></ErrorContent>
                    </DnetFormField>
                </div>
                <div class="forms-field">
                    <DnetFormField Appearance="_appearance" Label="Amount">
                        <ChildContent><DnetInputNumber TValue="double?" @bind-Value="_person.Amount" ImmediateResponse="true" aria-label="Amount in euros" /></ChildContent>
                        <SufixContent><span aria-hidden="true">€</span></SufixContent>
                        <HintContent>A numeric field with a suffix.</HintContent>
                        <ErrorContent><ValidationMessage For="@(() => _person.Amount)" /></ErrorContent>
                    </DnetFormField>
                </div>
            </div>
        </section>

        <section id="forms-address" class="forms-card forms-address-card" aria-labelledby="forms-address-title">
            <div class="forms-card-header">
                <span class="forms-card-icon" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                </span>
                <div><p class="forms-card-kicker">03 / More space</p><h2 id="forms-address-title">Address</h2><p>A multiline field for the details that need a little more room.</p></div>
            </div>
            <div class="forms-card-body">
                <div class="forms-field">
                    <DnetFormField Appearance="_appearance" Label="Address" IsRequired="true">
                        <ChildContent><DnetInputTextArea id="forms-address-input" @bind-Value="_person.Address" rows="3" ImmediateResponse="false" MaxCharacters="500" aria-label="Address" autocomplete="street-address" /></ChildContent>
                        <HintContent>Street, city and postal code.</HintContent>
                        <ErrorContent><ValidationMessage For="@(() => _person.Address)" /></ErrorContent>
                    </DnetFormField>
                </div>
            </div>
        </section>
    </EditForm>

    <section id="forms-reference" class="forms-card forms-reference" aria-labelledby="spacing-reference-title">
        <div class="forms-card-header">
            <span class="forms-card-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
            </span>
            <div><p class="forms-card-kicker">Reference gallery</p><h2 id="spacing-reference-title">The details, side by side</h2><p>Compare empty fields, values, icons and supporting text. These examples always use the filled style.</p></div>
        </div>
        <div class="forms-card-body">
            <div id="forms-reference-grid" class="forms-reference-grid">
                <DnetFormField id="spacing-empty" Label="Label text" Appearance="FormAppearance.Fill">
                    <ChildContent><DnetInputText @bind-Value="_spacingEmpty" aria-label="Label text, empty field example" /></ChildContent>
                    <HintContent>Empty field</HintContent>
                </DnetFormField>
                <DnetFormField id="spacing-value" Label="Label text" Appearance="FormAppearance.Fill">
                    <ChildContent><DnetInputText @bind-Value="_spacingValue" aria-label="Label text, filled field example" /></ChildContent>
                    <HintContent>With a value</HintContent>
                </DnetFormField>
                <DnetFormField id="spacing-icons-empty" Label="Label text" Appearance="FormAppearance.Fill">
                    <PrefixContent><span class="dnet-component-icon dnet-component-search-icon" aria-hidden="true"></span></PrefixContent>
                    <ChildContent><DnetInputText @bind-Value="_spacingIconsEmpty" aria-label="Label text, leading icon example" /></ChildContent>
                    <HintContent>Leading icon</HintContent>
                </DnetFormField>
                <DnetFormField id="spacing-icons-value" Label="Label text" Appearance="FormAppearance.Fill" UseClearButton="true">
                    <PrefixContent><span class="dnet-component-icon dnet-component-search-icon" aria-hidden="true"></span></PrefixContent>
                    <ChildContent><DnetInputText @bind-Value="_spacingIconsValue" aria-label="Label text, icon and clear action example" /></ChildContent>
                    <HintContent>Icon and clear action</HintContent>
                </DnetFormField>
                <DnetFormField id="spacing-support" Label="Label text" Appearance="FormAppearance.Fill">
                    <ChildContent><DnetInputText @bind-Value="_spacingSupport" aria-label="Label text, supporting text example" /></ChildContent>
                    <HintContent>Supporting text</HintContent>
                </DnetFormField>
                <DnetFormField id="spacing-counter" Label="Label text" Appearance="FormAppearance.Fill">
                    <ChildContent><DnetInputTextArea @bind-Value="_spacingCounter" rows="1" MaxCharacters="20" aria-label="Label text, character counter example" /></ChildContent>
                    <HintContent>Supporting text</HintContent>
                </DnetFormField>
            </div>
        </div>
    </section>

    <section id="forms-resource" class="forms-resource" aria-labelledby="forms-resource-title">
        <div><h2 id="forms-resource-title">Ready to add validation?</h2><p>See required fields, inline feedback and a complete save flow in action.</p></div>
        <a class="forms-validation-link" href="FormValidation">Open validation demo <span aria-hidden="true">→</span></a>
    </section>
</div>

@code {
    private FormAppearance _appearance = FormAppearance.Fill;
    private string _spacingEmpty = string.Empty;
    private string _spacingValue = "Input text";
    private string _spacingIconsEmpty = string.Empty;
    private string _spacingIconsValue = "Input text";
    private string _spacingSupport = string.Empty;
    private string _spacingCounter = "Input";
    private Person _person = default!;
    private EditContext _editContext = default!;
    private List<Person> _items = [];
    private readonly List<Gender> _genders = [new() { GenderId = 1, Name = "Female" }, new() { GenderId = 2, Name = "Male" }];
    private readonly CustomFilter<Person> _filterBy = CustomFilter<Person>
        .FilterBy(person => person.Name, CustomFilterOperator.Contains)
        .ThenFilterBy(person => person.Company, CustomFilterOperator.Contains);
    private readonly CustomSort<Person> _sortBy = CustomSort<Person>
        .ByAscending<string>(person => person.Name)
        .ThenDescending<string>(person => person.LastName);

    protected override void OnInitialized()
    {
        _person = new Person
        {
            Name = "John", LastName = "Doe", Email = "john.doe@datalnet.com", Age = 34,
            Address = "597 Frost Street, Brogan, Indiana, 8687", Amount = 1250,
            Birthday = new DateTime(1990, 6, 18), StartDate = DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
        };
        _editContext = new EditContext(_person);
    }

    protected override async Task OnInitializedAsync() => _items = await ApplicationServiceService.GetPersons();

    public sealed class Gender
    {
        public int GenderId { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}
