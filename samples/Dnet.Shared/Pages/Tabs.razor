@page "/Tabs"
@using Dnet.Blazor.Components.Tabs
@using Dnet.Blazor.Components.Tabs.Infrastructure.Models

<DemoPage Id="demo-tabs" Title="Tabs" Category="Navigation"
          Description="Keep related views in one workspace, with a clear active section and room for longer navigation." Badge="18 sections">
    <div class="demo-stack">
    <DemoCard Id="tabs-workspace" Title="Project workspace" Eyebrow="Scrollable navigation"
              Description="Choose a section to change the view. Billing is unavailable in this workspace.">
        <ChildContent>
            <div class="tabs-stage">
                <DnetTabGroup mat-align-tabs="start" OnTabClicked="TabClicked" TabHeaderBorder="false">
                    @foreach (var section in _sections)
                    {
                        <DnetTab Label="@section.Title" Disabled="@(section.Title == "Billing")">
                            <div class="tabs-panel">
                                <p class="tabs-panel-eyebrow">Northstar workspace</p>
                                <h3>@section.Title</h3>
                                <p class="demo-muted">@section.Description</p>
                                <div class="tabs-metrics">
                                    <div><span class="demo-info">Project</span><strong>Website launch</strong></div>
                                    <div><span class="demo-info">Workspace status</span><strong>On track</strong></div>
                                </div>
                            </div>
                        </DnetTab>
                    }
                </DnetTabGroup>
            </div>
        </ChildContent>
        <Footer><span class="demo-value" id="tabs-current-label" role="status">Active section: <strong>@_activeSection</strong></span></Footer>
    </DemoCard>

    <div class="demo-grid">
        <DemoCard Id="tabs-navigation-guide" Title="Explore every section" Description="Long navigation stays together in a single row.">
            <p class="demo-muted">Use the arrows at the ends of the tab strip to reveal more sections, then choose the view you need.</p>
        </DemoCard>
        <DemoCard Id="tabs-keyboard-guide" Title="Keyboard navigation" Description="Move through available tabs without leaving the keyboard.">
            <ul class="demo-bullets">
                <li>Use the arrow keys to move between tabs.</li>
                <li>Home and End move to the first and last available section.</li>
                <li>Disabled sections stay visible and cannot be selected.</li>
            </ul>
        </DemoCard>
    </div>
    </div>
</DemoPage>

@code {
    private string _activeSection = "Overview";

    private readonly WorkspaceSection[] _sections =
    [
        new("Overview", "A shared view of the launch, upcoming milestones and the work that matters this week."),
        new("Activity", "Follow recent updates, decisions and conversations from the project team."),
        new("Billing", "Billing is managed by the workspace owner."),
        new("Members", "See who is collaborating on the launch and how responsibilities are shared."),
        new("Files", "Keep design assets, documents and project resources together."),
        new("Tasks", "Review planned work and track the next deliverables."),
        new("Calendar", "Plan reviews, handoffs and release dates in one place."),
        new("Messages", "Catch up on the conversations behind the work."),
        new("Reports", "Explore project progress and recent delivery trends."),
        new("Milestones", "Check the checkpoints that lead to a successful release."),
        new("Approvals", "Review the decisions waiting for a team member."),
        new("Integrations", "Connect the tools used throughout the project."),
        new("Resources", "Find the people and materials available to the team."),
        new("Notes", "Capture context, meeting notes and working ideas."),
        new("Automations", "Review the routines that keep work moving."),
        new("Permissions", "Understand access across the workspace."),
        new("Archive", "Browse completed work and previous releases."),
        new("Settings", "Manage the preferences for this project workspace.")
    ];

    private void TabClicked(TabClikedEventData change)
    {
        if (change.TabId > 0 && change.TabId <= _sections.Length)
            _activeSection = _sections[change.TabId - 1].Title;
    }

    private sealed record WorkspaceSection(string Title, string Description);
}
