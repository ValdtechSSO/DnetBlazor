
<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />
<div class="tooltip-person">
    <span class="tooltip-person-avatar" aria-hidden="true">@S["Dialog.TM"]</span>
    <div><strong>@S.Display(Title)</strong><span>@S["TestTooltipContent.ProductDesignerLondon"]</span><small>@S["TestTooltipContent.PartOfTheDesignTeam"]</small></div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Taylor Morgan";
}
