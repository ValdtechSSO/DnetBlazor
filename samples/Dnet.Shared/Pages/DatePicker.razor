@page "/DatePicker"

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Dnet.Blazor.Components.DatePicker.Infrastructure.Models
@using Dnet.Blazor.Components.DatePicker.Infrastructure.Enums
@using Dnet.Blazor.Components.DatePicker
@using Dnet.Blazor.Components.Form
@using Dnet.Blazor.Components.DatePickerWeek
@using Dnet.Blazor.Components.DatePickerWeekRaw
@using Dnet.Blazor.Infrastructure.Enums

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-date-picker" Title="@S["DatePicker.DatePicker"]" Category="@S["DatePicker.DateAndTime"]"
          Description="@S["DatePicker.ChooseADayPlanADateRangeOr"]"
          Badge="@S["DatePicker.DaysRangesWeeks"]">
    <div class="demo-grid">
        <DemoCard Id="date-picker-single" Title="@S["DatePicker.RecordADepartureDay"]"
                  Description="@S["DatePicker.TypeADateOrOpenTheCalendarThis"]">
            <ChildContent>
                <EditForm Model="_formData">
                    <DataAnnotationsValidator />
                    <div class="demo-stack">
                        <DnetFormField Label="@S["DatePicker.DepartureDay"]" UseClearButton="true" IsRequired="true">
                            <ChildContent>
                                <DnetDatePicker @bind-Value="_formData.DepartureDay"
                                                OnDaySelected="DaySelected" PlaceHolder="@S["DatePicker.DepartureDay"]"
                                                aria-label="@S["DatePicker.DepartureDay"]"
                                                Format="@_datepickerFormat" MaxDayValue="DateTime.Today"
                                                Formats="@_acceptedFormats" />
                            </ChildContent>
                            <SufixContent>
                                <button class="dnet-datepicker-icon-wrapper date-picker-trigger" type="button" aria-label="@S["DatePicker.OpenDepartureCalendar"]">
                                    <span class="dnet-datepicker-icon" aria-hidden="true"></span>
                                </button>
                            </SufixContent>
                            <ErrorContent>
                                <SampleValidationMessage For="@(() => _formData.DepartureDay)" />
                            </ErrorContent>
                        </DnetFormField>
                        <p class="demo-status" role="status">@S.Display(_calendarSelectionStatus)</p>
                    </div>
                </EditForm>
            </ChildContent>
            <Footer>
                <span class="demo-value" role="status">@S.Format("Common.Departure0", S.Text(SelectedDateLabel))</span>
            </Footer>
        </DemoCard>

        <DemoCard Id="date-picker-range" Title="@S["DatePicker.PlanATrip"]"
                  Description="@S["DatePicker.ChooseTheStartAndEndOfAnUpcoming"]">
            <ChildContent>
                <EditForm Model="_formData">
                    <DnetFormField Label="@S["DatePicker.TravelDates"]" UseClearButton="true">
                        <ChildContent>
                            <DnetDateRangePicker @bind-Value="_formData.TravelRange"
                                                 StartPlaceholder="@S["DatePicker.Start"]" EndPlaceholder="@S["DatePicker.End"]"
                                                 Format="dd/MM/yyyy"
                                                 Min="@DateOnly.FromDateTime(DateTime.Today)"
                                                 ShowActions="true" />
                        </ChildContent>
                        <SufixContent>
                            <button class="dnet-datepicker-icon-wrapper date-picker-trigger" type="button" aria-label="@S["DatePicker.OpenTravelDatesCalendar"]">
                                <span class="dnet-datepicker-icon" aria-hidden="true"></span>
                            </button>
                        </SufixContent>
                    </DnetFormField>
                </EditForm>
            </ChildContent>
            <Footer>
                <span class="demo-value" role="status">@S.Display(TravelRangeLabel)</span>
            </Footer>
        </DemoCard>

        <DemoCard Title="@S["DatePicker.CalendarInThePage"]"
                  Description="@S["DatePicker.KeepTheMonthVisibleWhenChoosingADay"]">
            <ChildContent>
                <div class="date-calendar-preview">
                    <DnetCalendar @bind-Value="_inlineDate"
                                  StartAt="@(new DateOnly(2026, 8, 1))"
                                  StartView="DnetCalendarView.Month"
                                  DateClass="@(date => date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? "sample-weekend" : null)" />
                </div>
            </ChildContent>
            <Footer>
                <span class="demo-value" role="status">@S.Format("Common.SelectedDay0", _inlineDate?.ToString("dd MMMM yyyy", S.Culture) ?? S.Text("No date selected"))</span>
            </Footer>
        </DemoCard>

        <DemoCard Title="@S["DatePicker.ChooseTheDisplayFormat"]"
                  Description="@S["DatePicker.ChangeHowTheDepartureDayIsWrittenThe"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="demo-actions" role="group" aria-label="@S["DatePicker.DepartureDateFormat"]">
                        @foreach (var format in _displayFormats)
                        {
                            <button type="button" class="date-format-option"
                                    aria-pressed="@(_datepickerFormat == format ? "true" : "false")"
                                    @onclick="@(() => ChangeDateFormat(format))">@S.Display(format)</button>
                        }
                    </div>
                    <div class="demo-preview">
                        <span class="demo-info">@S["DatePicker.ActiveFormat"]</span>
                        <p class="demo-value">@S.Display(_datepickerFormat)</p>
                        <span class="demo-muted">@S["DatePicker.TheSelectedDayIsPreservedWhenYouChange"]</span>
                    </div>
                </div>
            </ChildContent>
        </DemoCard>

        <DemoCard Id="date-picker-week" Title="@S["DatePicker.SelectAWholeWeek"]"
                  Description="@S["DatePicker.OpenTheWeekPickerAndChooseADay"]">
            <ChildContent>
                <EditForm Model="_weekFormData">
                    <DataAnnotationsValidator />
                    <DnetFormField Label="@S["DatePicker.CurrentWeek"]">
                        <ChildContent>
                            <DnetDatePickerWeek @bind-Value="_weekFormData.DepartureDay"
                                                OnWeekSelected="DaySelectedWeek"
                                                PlaceHolder="@S["DatePicker.CurrentWeek"]" Format="@_datepickerFormat"
                                                FirstDayToShow="DateTime.Today"
                                                DatepickerFilter="@(day => day.DayIndex == 0)"
                                                ComponentTheme="ComponentTheme.Raw" />
                        </ChildContent>
                        <ErrorContent>
                            <SampleValidationMessage For="@(() => _weekFormData.DepartureDay)" />
                        </ErrorContent>
                    </DnetFormField>
                </EditForm>
            </ChildContent>
            <Footer>
                <span class="demo-value" role="status">@S.Display(_weekSelectionLabel)</span>
            </Footer>
        </DemoCard>

        <DemoCard Id="date-picker-week-inline" Title="@S["DatePicker.WeekCalendarInThePage"]"
                  Description="@S["DatePicker.BrowseTheCalendarAndSelectAWeekWithout"]">
            <ChildContent>
                <div class="date-calendar-preview">
                    <DnetDatePickerWeekRaw OnWeekSelected="DaySelectedWeekRaw" Format="@_datepickerFormat" />
                </div>
            </ChildContent>
            <Footer>
                <span class="demo-value" role="status">@S.Display(_inlineWeekSelectionLabel)</span>
            </Footer>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private readonly FormData _formData = new();
    private readonly FormData _weekFormData = new();
    private string _datepickerFormat = "dd/MM/yyyy";
    private DateOnly? _inlineDate = new DateOnly(2026, 8, 15);
    private string _calendarSelectionStatus = "Dates after today are unavailable.";
    private (DateTime Start, DateTime End)? _weekDates;
    private string _weekSelectionLabel => _weekDates is { } w ? FormatWeek(w.Start, w.End) : S.Text("No week selected");
    private (DateTime Start, DateTime End)? _inlineWeekDates;
    private string _inlineWeekSelectionLabel => _inlineWeekDates is { } w ? FormatWeek(w.Start, w.End) : string.Empty;

    private readonly string[] _displayFormats = ["dd/MM/yyyy", "MM/dd/yyyy", "yyyy-MM-dd"];
    private readonly string[] _acceptedFormats = ["dd/MM/yyyy", "d/M/yyyy", "MM/dd/yyyy", "yyyy-MM-dd", "yyyy/MM/dd", "yyyy/M/d"];

    private string SelectedDateLabel => string.IsNullOrWhiteSpace(_formData.DepartureDay)
        ? "No date selected" : _formData.DepartureDay;

    private string TravelRangeLabel
    {
        get
        {
            var range = _formData.TravelRange;
            if (range is null || range.IsEmpty) return "No travel dates selected";
            if (range.Start is null) return $"End: {range.End?.ToString("dd MMM yyyy", S.Culture)} · Choose a start date";
            if (range.End is null) return $"Start: {range.Start?.ToString("dd MMM yyyy", S.Culture)} · Choose an end date";
            return $"{range.Start?.ToString("dd MMM yyyy", S.Culture)} – {range.End?.ToString("dd MMM yyyy", S.Culture)}";
        }
    }

    protected override void OnInitialized()
    {
        _formData.DepartureDay = DateTime.Today.ToString(_datepickerFormat, CultureInfo.InvariantCulture);
        var today = DateTime.Today;
        var monday = today.AddDays(-((int)today.DayOfWeek + 6) % 7);
        _inlineWeekDates = (monday, monday.AddDays(6));
        _weekDates = _inlineWeekDates;
    }

    private void ChangeDateFormat(string format)
    {
        if (DateTime.TryParseExact(_formData.DepartureDay, _datepickerFormat, CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var selectedDate))
        {
            _formData.DepartureDay = selectedDate.ToString(format, CultureInfo.InvariantCulture);
        }
        _datepickerFormat = format;
    }

    private void DaySelected(Dnet.Blazor.Components.DatePicker.Infrastructure.Models.CalendarDay day) =>
        _calendarSelectionStatus = $"Picked from the calendar: {day.FormattedDate}";

    private void DaySelectedWeek(List<Dnet.Blazor.Components.DatePickerWeek.Infrastructure.Models.CalendarDay> days)
    {
        if (days.Count > 0) _weekDates = (days.Min(day => day.Date), days.Max(day => day.Date));
    }

    private void DaySelectedWeekRaw(List<Dnet.Blazor.Components.DatePickerWeekRaw.Infrastructure.Models.CalendarDay> days)
    {
        if (days.Count > 0) _inlineWeekDates = (days.Min(day => day.Date), days.Max(day => day.Date));
    }

    private string FormatWeek(DateTime start, DateTime end) =>
        $"{start.ToString("dd MMM yyyy", S.Culture)} – {end.ToString("dd MMM yyyy", S.Culture)}";

    private sealed class FormData
    {
        [Required(ErrorMessage = "Choose a departure day.")]
        public string DepartureDay { get; set; } = string.Empty;

        public DnetDateRange? TravelRange { get; set; }
    }
}
