@page "/Expansion"
@using Dnet.Blazor.Components.Button
@using Dnet.Blazor.Components.ExpansionPanel

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-expansion" Title="@S["Expansion.ExpansionPanels"]" Category="@S["Expansion.Disclosure"]"
          Description="@S["Expansion.RevealSupportingDetailsWhenTheyAreNeededWhile"]" Badge="@S["Expansion.MultipleOrSingleOpen"]">
    <div class="demo-stack">
    <DemoCard Id="expansion-faq-card" Title="@S["Expansion.WorkspaceQuestions"]" Eyebrow="@S["Expansion.MultiplePanels"]"
              Description="@S["Expansion.OpenSeveralAnswersAtOnceOrUseThe"]">
        <ChildContent>
            <div class="demo-actions expansion-actions">
                <DnetButton Variant="DnetButtonVariant.Outlined" id="expansion-expand-all" OnClick="() => ExpandAll(true)">@S["Tree.ExpandAll"]</DnetButton>
                <DnetButton Variant="DnetButtonVariant.Outlined" id="expansion-collapse-all" OnClick="() => ExpandAll(false)">@S["Tree.CollapseAll"]</DnetButton>
            </div>
            <DnetExpansionPanel @ref="_faqPanel" id="expansion-faq" OnExpandedChanged="ExpandedChanged"
                                ExpansionPanelDisplayMode="ExpansionPanelDisplayMode.Spacing">
                <DnetExpansionPanelItem Title="@S["Expansion.InviteYourTeam"]" Description="@S["Expansion.Members"]">
                    <div class="expansion-answer"><p>@S["Expansion.InviteCollaboratorsFromTheMembersSectionOfYour"]</p><ul class="demo-bullets"><li>@S["Expansion.EditorsCanContributeToProjectWork"]</li><li>@S["Expansion.ViewersCanFollowProgressAndReadSharedUpdates"]</li></ul></div>
                </DnetExpansionPanelItem>
                <DnetExpansionPanelItem Title="@S["Expansion.ChangeYourPlan"]" Description="@S["Expansion.Billing"]">
                    <div class="expansion-answer"><p>@S["Expansion.WorkspaceOwnersCanReviewPlansFromBillingYour"]</p></div>
                </DnetExpansionPanelItem>
                <DnetExpansionPanelItem Title="@S["Expansion.KeepFilesOrganized"]" Description="@S["Expansion.Files"]">
                    <div class="expansion-answer"><p>@S["Expansion.GroupRelatedResourcesByProjectAndUseClear"]</p></div>
                </DnetExpansionPanelItem>
                <DnetExpansionPanelItem Title="@S["Expansion.ManageNotifications"]" Description="@S["Expansion.Preferences"]">
                    <div class="expansion-answer"><p>@S["Expansion.ChooseTheProjectUpdatesYouWantToReceive"]</p></div>
                </DnetExpansionPanelItem>
            </DnetExpansionPanel>
        </ChildContent>
        <Footer><span id="expansion-faq-value" role="status">@S.Display(_faqStatus)</span></Footer>
    </DemoCard>

    <div class="demo-grid">
        <DemoCard Id="expansion-single-card" Title="@S["Expansion.AccountPreferences"]" Eyebrow="@S["Expansion.OnePanelAtATime"]"
                  Description="@S["Expansion.OpeningAPreferenceClosesThePreviousOneRestricted"]">
            <DnetExpansionPanel id="expansion-single" Multi="false" OnExpandedChanged="PreferenceChanged">
                <DnetExpansionPanelItem Title="@S["Expansion.Profile"]" Description="@S["Expansion.Personal"]">
                    <div class="expansion-answer"><p>@S["Expansion.YourNameAndProfilePhotoHelpColleaguesRecognize"]</p></div>
                </DnetExpansionPanelItem>
                <DnetExpansionPanelItem Title="@S["Expansion.Security"]" Description="@S["Expansion.Access"]">
                    <div class="expansion-answer"><p>@S["Expansion.ReviewActiveSessionsAndKeepYourSignIn"]</p></div>
                </DnetExpansionPanelItem>
                <DnetExpansionPanelItem Title="@S["Expansion.AdvancedAccess"]" Description="@S["Expansion.Restricted"]" Disabled="true">
                    <div class="expansion-answer"><p>@S["Expansion.ThisSettingIsManagedByYourAdministrator"]</p></div>
                </DnetExpansionPanelItem>
            </DnetExpansionPanel>
            <p id="expansion-single-value" class="demo-info expansion-preference-status" role="status">@S.Display(_preferenceStatus)</p>
        </DemoCard>
        <DemoCard Id="expansion-guide" Title="@S["Expansion.DetailsAtTheRightMoment"]" Description="@S["Expansion.UseExpansionPanelsForRelatedInformationThatDoes"]">
            <ul class="demo-bullets">
                <li>@S["Expansion.AllowSeveralPanelsWhenPeopleNeedToCompare"]</li>
                <li>@S["Expansion.UseASingleOpenPanelForAFocused"]</li>
                <li>@S["Expansion.KeepTitlesSpecificSoTheContentIsEasy"]</li>
            </ul>
        </DemoCard>
    </div>
    </div>
</DemoPage>

@code {
    private DnetExpansionPanel? _faqPanel;
    private string _faqStatus = "Choose a question to read its answer.";
    private string _preferenceStatus = "No preference is open.";

    private void ExpandAll(bool expand)
    {
        _faqPanel?.ExpandAll(expand);
        _faqStatus = expand ? "All four answers are expanded." : "All answers are collapsed.";
    }

    private void ExpandedChanged(DnetExpansionPanelItem panel)
        => _faqStatus = $"{panel.Title}: {(panel.IsExpanded() ? "expanded" : "collapsed")}.";

    private void PreferenceChanged(DnetExpansionPanelItem panel)
        => _preferenceStatus = panel.IsExpanded() ? $"Open preference: {panel.Title}." : "No preference is open.";
}
