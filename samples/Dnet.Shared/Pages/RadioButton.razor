@page "/RadioButton"

@using Dnet.Blazor.Components.RadioButton

<DemoPage Id="demo-radio-button" Title="Radio button" Category="Selection controls"
          Description="Present a small set of alternatives and let people choose exactly one."
          Badge="Single choice">
    <div class="demo-grid">
        <DemoCard Id="radio-delivery" Title="Choose a delivery option"
                  Description="Compare the available methods. Selecting another option updates your delivery summary.">
            <ChildContent>
                <fieldset class="radio-options">
                    <legend>Delivery method</legend>
                    <DnetInputRadioGroup Name="delivery-method" @bind-Value="_delivery">
                        <div class="demo-option-row">
                            <DnetInputRadioButton Name="delivery-method" Value="DeliveryMethod.Standard">Standard delivery</DnetInputRadioButton>
                        </div>
                        <p class="demo-info">Arrives in 3–5 business days · Free</p>
                        <div class="demo-option-row">
                            <DnetInputRadioButton Name="delivery-method" Value="DeliveryMethod.Express">Express delivery</DnetInputRadioButton>
                        </div>
                        <p class="demo-info">Arrives the next business day · €9.00</p>
                        <div class="demo-option-row">
                            <DnetInputRadioButton Name="delivery-method" Value="DeliveryMethod.Collection" Disabled="true" TextPlacedBefore="true">Collect in store</DnetInputRadioButton>
                        </div>
                        <p class="demo-info">Currently unavailable for this order.</p>
                    </DnetInputRadioGroup>
                </fieldset>
            </ChildContent>
            <Footer>
                <span class="demo-value" role="status">Selected: @DeliveryLabel</span>
            </Footer>
        </DemoCard>

        <DemoCard Title="Delivery summary" Description="A single value represents the choice for the entire group.">
            <div class="demo-stack">
                <div class="demo-preview" role="status">
                    <span class="demo-info">Your delivery</span>
                    <p class="demo-value">@DeliveryLabel</p>
                    <span class="demo-muted">@DeliveryDescription</span>
                </div>
                <ul class="demo-bullets">
                    <li>Click an option or its label to select it.</li>
                    <li>Choose one option from the group at a time.</li>
                    <li>Use radio buttons when all alternatives should be visible.</li>
                </ul>
            </div>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private DeliveryMethod _delivery = DeliveryMethod.Standard;

    private string DeliveryLabel => _delivery == DeliveryMethod.Express ? "Express delivery" : "Standard delivery";
    private string DeliveryDescription => _delivery == DeliveryMethod.Express
        ? "Next business day · €9.00"
        : "3–5 business days · Free";

    private enum DeliveryMethod { Standard, Express, Collection }
}
