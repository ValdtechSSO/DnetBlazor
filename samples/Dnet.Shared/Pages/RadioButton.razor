@page "/RadioButton"

@using Dnet.Blazor.Components.RadioButton

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-radio-button" Title="@S["RadioButton.RadioButton"]" Category="@S["SlideToggle.SelectionControls"]"
          Description="@S["RadioButton.PresentASmallSetOfAlternativesAndLet"]"
          Badge="@S["RadioButton.SingleChoice"]">
    <div class="demo-grid">
        <DemoCard Id="radio-delivery" Title="@S["RadioButton.ChooseADeliveryOption"]"
                  Description="@S["RadioButton.CompareTheAvailableMethodsSelectingAnotherOptionUpdates"]">
            <ChildContent>
                <fieldset class="radio-options">
                    <legend>@S["RadioButton.DeliveryMethod"]</legend>
                    <DnetInputRadioGroup Name="delivery-method" @bind-Value="_delivery">
                        <div class="demo-option-row">
                            <DnetInputRadioButton Name="delivery-method" Value="DeliveryMethod.Standard">@S["RadioButton.StandardDelivery"]</DnetInputRadioButton>
                        </div>
                        <p class="demo-info">@S["RadioButton.ArrivesIn35BusinessDaysFree"]</p>
                        <div class="demo-option-row">
                            <DnetInputRadioButton Name="delivery-method" Value="DeliveryMethod.Express">@S["RadioButton.ExpressDelivery"]</DnetInputRadioButton>
                        </div>
                        <p class="demo-info">@S["RadioButton.ArrivesTheNextBusinessDay900"]</p>
                        <div class="demo-option-row">
                            <DnetInputRadioButton Name="delivery-method" Value="DeliveryMethod.Collection" Disabled="true" TextPlacedBefore="true">@S["RadioButton.CollectInStore"]</DnetInputRadioButton>
                        </div>
                        <p class="demo-info">@S["RadioButton.CurrentlyUnavailableForThisOrder"]</p>
                    </DnetInputRadioGroup>
                </fieldset>
            </ChildContent>
            <Footer>
                <span class="demo-value" role="status">@S.Format("Common.Selected0", S.Text(DeliveryLabel))</span>
            </Footer>
        </DemoCard>

        <DemoCard Title="@S["RadioButton.DeliverySummary"]" Description="@S["RadioButton.ASingleValueRepresentsTheChoiceForThe"]">
            <div class="demo-stack">
                <div class="demo-preview" role="status">
                    <span class="demo-info">@S["RadioButton.YourDelivery"]</span>
                    <p class="demo-value">@S.Display(DeliveryLabel)</p>
                    <span class="demo-muted">@S.Display(DeliveryDescription)</span>
                </div>
                <ul class="demo-bullets">
                    <li>@S["RadioButton.ClickAnOptionOrItsLabelToSelect"]</li>
                    <li>@S["RadioButton.ChooseOneOptionFromTheGroupAtA"]</li>
                    <li>@S["RadioButton.UseRadioButtonsWhenAllAlternativesShouldBe"]</li>
                </ul>
            </div>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private DeliveryMethod _delivery = DeliveryMethod.Standard;

    private string DeliveryLabel => _delivery == DeliveryMethod.Express ? "Express delivery" : "Standard delivery";
    private string DeliveryDescription => _delivery == DeliveryMethod.Express
        ? "Next business day · €9.00"
        : "3–5 business days · Free";

    private enum DeliveryMethod { Standard, Express, Collection }
}
