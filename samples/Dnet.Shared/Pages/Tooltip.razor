@page "/Tooltip"
@using Dnet.App.Shared.Pages.TooltipContent
@using Dnet.Blazor.Components.Tooltip.Infrastructure.Interfaces
@using Dnet.Blazor.Components.Tooltip.Infrastructure.Models
@using Dnet.Blazor.Components.Overlay.Infrastructure.Models
@using Dnet.Blazor.Components.Overlay.Infrastructure.Services
@inject ITooltipService TooltipService
@implements IDisposable

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-tooltip" Title="@S["Tooltip.Tooltip"]" Category="@S["Toast.ComponentsFeedback"]" Description="@S["Tooltip.OfferALittleMoreContextAtJustThe"]" Badge="@S["Tooltip.PointerKeyboard"]">
    <div class="demo-grid-three">
        <DemoCard Id="tooltip-basic" Title="@S["Tooltip.AUsefulHint"]" Eyebrow="@S["Tooltip.01Immediate"]" Description="@S["Tooltip.ShortHelpfulContextThatAppearsAsSoonAs"]">
            <ChildContent><div class="tooltip-stage demo-preview"><button id="tooltip-basic-trigger" @ref="_basicTarget" class="tooltip-trigger" type="button" @onmouseenter="() => SetHover(0, true)" @onmouseleave="() => SetHover(0, false)" @onfocus="() => SetFocus(0, true)" @onblur="() => SetFocus(0, false)" @onkeydown="args => HandleKey(0, args)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7v1" /></svg><span>@S["Tooltip.ShowTooltip"]</span></button></div></ChildContent>
            <Footer>@S["Tooltip.AppearsImmediatelyNoDelay"]</Footer>
        </DemoCard>
        <DemoCard Id="tooltip-delay" Title="@S["Tooltip.GiveItAMoment"]" Eyebrow="@S["Tooltip.02Delayed"]" Description="@S["Tooltip.ABriefPauseKeepsHintsFromAppearingAs"]">
            <ChildContent><div class="tooltip-stage demo-preview"><button id="tooltip-delay-trigger" @ref="_delayTarget" class="tooltip-trigger" type="button" @onmouseenter="() => SetHover(1, true)" @onmouseleave="() => SetHover(1, false)" @onfocus="() => SetFocus(1, true)" @onblur="() => SetFocus(1, false)" @onkeydown="args => HandleKey(1, args)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg><span>@S["Tooltip.ShowTooltipWithDelay"]</span></button></div></ChildContent>
            <Footer>@S["Tooltip.Waits500msLeavingCancelsTheHint"]</Footer>
        </DemoCard>
        <DemoCard Id="tooltip-component" Title="@S["Tooltip.ARicherIntroduction"]" Eyebrow="@S["Tooltip.03CustomContent"]" Description="@S["Tooltip.UseASmallComponentWhenANameNeeds"]">
            <ChildContent><div class="tooltip-stage demo-preview"><button id="tooltip-component-trigger" @ref="_componentTarget" class="tooltip-trigger" type="button" @onmouseenter="() => SetHover(2, true)" @onmouseleave="() => SetHover(2, false)" @onfocus="() => SetFocus(2, true)" @onblur="() => SetFocus(2, false)" @onkeydown="args => HandleKey(2, args)"><span class="tooltip-trigger-avatar" aria-hidden="true">@S["Dialog.TM"]</span><span>@S["Tooltip.ShowTooltipWithComponent"]</span></button></div></ChildContent>
            <Footer>@S["Tooltip.CustomContentA300msPause"]</Footer>
        </DemoCard>
    </div>
    <div class="tooltip-keyboard-note"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false" style="flex-shrink:0"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M6 9h2m3 0h2m3 0h2M6 12h2m3 0h2m3 0h2M7 15h10" /></svg><p><strong>@S["Tooltip.TryItWithYourKeyboard"]</strong> @S["Tooltip.TabToAnyExampleToRevealItsHint"]</p></div>
</DemoPage>

@code {
    private ElementReference _basicTarget;
    private ElementReference _delayTarget;
    private ElementReference _componentTarget;
    private readonly OverlayReference?[] _references = new OverlayReference?[3];
    private readonly bool[] _hovered = new bool[3];
    private readonly bool[] _focused = new bool[3];
    private bool _disposed;

    private void SetHover(int index, bool active) { _hovered[index] = active; UpdateTooltip(index); }
    private void SetFocus(int index, bool active) { _focused[index] = active; UpdateTooltip(index); }
    private void UpdateTooltip(int index)
    {
        if (_disposed) return;
        if (!_hovered[index] && !_focused[index]) { CloseTooltip(index); return; }
        if (_references[index] is not null) return;
        var target = index switch { 1 => _delayTarget, 2 => _componentTarget, _ => _basicTarget };
        var config = new TooltipConfig { MaxWidth = "280px", ShowDelay = index switch { 1 => 500, 2 => 300, _ => 0 } };
        if (index == 2)
            _references[index] = TooltipService.Show<TestTooltipContent>(config, new Dictionary<string, object> { ["Title"] = "Taylor Morgan" }, target);
        else
        {
            var text = index == 0 ? "Helpful context, right where you need it." : "A little patience reveals this extra detail.";
            _references[index] = TooltipService.Show<SampleTooltipText>(config, new Dictionary<string, object> { ["Text"] = text }, target);
        }
    }
    private void HandleKey(int index, KeyboardEventArgs args) { if (args.Key == "Escape") CloseTooltip(index); }
    private void CloseTooltip(int index)
    {
        var reference = _references[index];
        _references[index] = null;
        if (reference is not null) TooltipService.Close(new OverlayResult { OverlayReferenceId = reference.GetOverlayReferenceId() });
    }
    public void Dispose() { _disposed = true; for (var index = 0; index < _references.Length; index++) CloseTooltip(index); }
}
