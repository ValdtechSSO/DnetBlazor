@page "/Localization"
@using Dnet.Blazor.Localization
@using Dnet.Blazor.Components.Button
@using Dnet.Blazor.Components.DatePicker
@using Dnet.Blazor.Components.Form
@using Dnet.Blazor.Components.Paginator
@using Dnet.Blazor.Components.PickList
@using Dnet.Blazor.Components.Spoiler
@using Dnet.Blazor.Components.TimePicker
@using Dnet.Blazor.Components.Toast.Infrastructure.Interfaces
@using Dnet.Blazor.Components.Toast.Infrastructure.Models
@inject IDnetLocalizer Localizer
@inject IToastService ToastService

<DnetLocalizationObserver OnChanged="RefreshLanguage" />
<DemoPage Id="demo-localization" Title="@S["Common.OneLanguageForEveryControl"]"
          Category="@S["Common.LanguagesAndFormats"]"
          Description="@S["Common.UseTheLanguageSelectorInTheHeaderControlsUpdate"]"
          Badge="@S["Localization.EspaOlEnglish"]">
    <div class="demo-grid">
        <DemoCard Id="localization-selection" Title="@S["Common.ChooseYourTeam"]"
                  Eyebrow="@S["Common.01AutomaticText"]"
                  Description="@S["Common.SelectPeopleSearchOrChangePagesBeforeSwitchingLanguages"]">
            <ChildContent>
                <div id="localization-picklist">
                    <PickList TItem="string" TKey="string" Items="_people" ItemKey="person => person"
                              SearchTextSelector="person => person" @bind-SelectedKeys="_selected" PageSize="3">
                        <ItemTemplate Context="person">@S.Display(person)</ItemTemplate>
                    </PickList>
                </div>
            </ChildContent>
            <Footer><span id="localization-selection-value" class="demo-value" role="status">@string.Join(", ", _selected.Order())</span></Footer>
        </DemoCard>

        <DemoCard Id="localization-dates" Title="@S["Common.DatesAndTimesYourWay"]"
                  Eyebrow="@S["Common.02RegionalCulture"]"
                  Description="@S["Common.OpenTheCalendarAndSwitchLanguagesTheOpenPanel"]">
            <ChildContent>
                <EditForm Model="_form">
                    <div class="demo-stack">
                        <div id="localization-date">
                            <DnetFormField Label="@S["DatePicker.DepartureDay"]">
                                <DnetDatePicker @bind-Value="_form.Date" Format="yyyy-MM-dd" />
                            </DnetFormField>
                        </div>
                        <div id="localization-time">
                            <DnetFormField Label="@S["TimePicker.DepartureTime"]">
                                <DnetTimePicker @bind-Value="_form.Time" TouchUi="true" />
                            </DnetFormField>
                        </div>
                    </div>
                </EditForm>
            </ChildContent>
            <Footer><span id="localization-format-value" class="demo-value">@(new DateOnly(2026, 10, 16).ToString("D", Localizer.Culture)) · @(1234.56m.ToString("N2", Localizer.Culture))</span></Footer>
        </DemoCard>

        <DemoCard Id="localization-content" Title="@S["Common.HelpfulMessages"]"
                  Eyebrow="@S["Common.03ContentAndNotifications"]"
                  Description="@S["Common.ControlTextAndAccessibleLabelsFollowTheSelectedLanguage"]">
            <div class="demo-stack">
                <DnetSpoiler id="localization-spoiler" MaxHeight="48">
                    <p>@S["Common.ATeamSharesDatesIdeasAndDecisionsEachPerson"]</p>
                    <p>@S["Common.ChangingLanguagePreservesControlStateYouCanContinueWorking"]</p>
                </DnetSpoiler>
                <div class="demo-actions"><DnetButton id="localization-show-toast" OnClick="ShowNotification">@S["Common.ShowNotification"]</DnetButton></div>
            </div>
        </DemoCard>

        <DemoCard Id="localization-overrides" Title="@S["Common.YourWordingTakesPriority"]"
                  Eyebrow="@S["Common.04CustomWording"]"
                  Description="@S["Common.ThisExampleKeepsItsCustomTextOtherLabelsContinue"]">
            <ChildContent>
                <div id="localization-custom-picklist">
                    <PickList TItem="string" TKey="string" Items="_people" ItemKey="person => person"
                              SearchTextSelector="person => person" @bind-SelectedKeys="_customSelected" PageSize="3"
                              Strings="_customStrings">
                        <ItemTemplate Context="person">@S.Display(person)</ItemTemplate>
                    </PickList>
                </div>
            </ChildContent>
            <Footer><span class="demo-info">@S["Common.VaciarMiSelecciNIsWordingSuppliedByThis"]</span></Footer>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private readonly string[] _people = ["Alex Rivera", "Taylor Morgan", "Sam Chen", "Riley Parker", "Jordan Lee", "Avery Scott"];
    private IReadOnlySet<string> _selected = new HashSet<string> { "Taylor Morgan" };
    private IReadOnlySet<string> _customSelected = new HashSet<string> { "Alex Rivera" };
    private readonly PickListStrings _customStrings = new() { ClearLabel = "Vaciar mi selección" };
    private readonly FormModel _form = new();
    private Task RefreshLanguage() => InvokeAsync(StateHasChanged);
    private string Text(string spanish, string english) => Localizer.Culture.TwoLetterISOLanguageName == "en" ? english : spanish;

    private void ShowNotification() => ToastService.Show(new ToastConfig { TextLocalizer = S.Message,
        Title = "Team updated",
        Text = "Switch language while this notification is open to check its close button.",
        Duration = null
    });

    private sealed class FormModel
    {
        public string Date { get; set; } = "2026-10-16";
        public TimeOnly? Time { get; set; } = new(14, 30);
    }
}
