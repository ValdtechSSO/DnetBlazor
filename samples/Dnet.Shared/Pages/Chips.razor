@page "/Chips"
@using Dnet.Blazor.Components.Chips
@using Dnet.Blazor.Components.Button
<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-chips" Title="@S["Chips.Chips"]" Category="@S["SlideToggle.SelectionControls"]"
          Description="@S["Chips.KeepChoicesCompactMakeFiltersEasyToScan"]"
          Badge="@S["Chips.SelectRemoveCustomize"]">
    <div class="demo-grid">
        <DemoCard Id="chips-topics" Title="@S["Chips.FilterByTopic"]" Eyebrow="@S["Chips.MultipleChoices"]"
                  Description="@S["Chips.ChooseTheTopicsYouWantToFollowSelect"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="chips-stage demo-preview" role="group" aria-label="@S["Chips.TopicFilters"]">
                        <DnetChipList Multi="true" OnSelectionChange="TopicsChanged">
                            @foreach (var topic in _topics)
                            {
                                <DnetChip @key="topic" Value="@topic" ChipSize="ChipSize.Large"
                                          Selected="@_selectedTopics.Contains(topic)" Removable="false" ><span>@S.Text(topic)</span></DnetChip>
                            }
                        </DnetChipList>
                    </div>
                    <div class="demo-actions">
                        <DnetButton Variant="DnetButtonVariant.Outlined" id="chips-clear-topics" disabled="@(_selectedTopics.Count == 0)" OnClick="ClearTopics">@S["Chips.ClearFilters"]</DnetButton>
                    </div>
                    <p class="demo-muted">@S["Chips.CombineSeveralTopicsWithoutLeavingThisView"]</p>
                </div>
            </ChildContent>
            <Footer><span id="chips-topics-value" class="demo-value" role="status">@S.Message(TopicSummary)</span></Footer>
        </DemoCard>

        <DemoCard Id="chips-priority" Title="@S["Chips.SetAProjectPriority"]" Eyebrow="@S["RadioButton.SingleChoice"]"
                  Description="@S["Chips.ChooseOnePriorityForTheProjectSelectingThe"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="chips-stage demo-preview" role="group" aria-label="@S["Chips.ProjectPriority"]">
                        <DnetChipList OnSelectionChange="PriorityChanged">
                            @foreach (var priority in _priorities)
                            {
                                <DnetChip @key="priority" Value="@priority" ChipSize="ChipSize.Medium"
                                          Selected="@(_priority == priority)" Removable="false" ><span>@S.Text(priority)</span></DnetChip>
                            }
                        </DnetChipList>
                    </div>
                    <div class="chips-priority-preview">
                        <span class="demo-info">@S["Chips.WebsiteLaunch"]</span>
                        <p class="demo-value">@S["Chips.MakeRoomForTheWorkThatMatters"]</p>
                        <span class="demo-muted">@S["Chips.YourChoiceStaysVisibleInTheProjectSummary"]</span>
                    </div>
                </div>
            </ChildContent>
            <Footer><span id="chips-priority-value" class="demo-value" role="status">@S.Message(_priority.Length == 0 ? "No priority selected" : $"Priority: {_priority}")</span></Footer>
        </DemoCard>

        <DemoCard Id="chips-people" Title="@S["Chips.PeopleInThisProject"]" Eyebrow="@S["Chips.RemovableItems"]"
                  Description="@S["Chips.KeepTheProjectTeamInViewRemoveA"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="chips-stage demo-preview" role="group" aria-label="@S["Chips.ProjectTeam"]">
                        @if (_people.Count == 0)
                        {
                            <div id="chips-people-empty" class="chips-empty">
                                <strong>@S["Chips.NoTeammatesYet"]</strong>
                                <p class="demo-muted">@S["Chips.RestoreTheTeamToBringEveryoneBack"]</p>
                            </div>
                        }
                        <DnetChipList>
                            @foreach (var person in _people)
                            {
                                <DnetChip @key="person.Name" Value="@person.Name" ChipSize="ChipSize.Medium"
                                          Selectable="false" OnRemoved="RemovePerson"
                                          RemoveIcon="@(person.Initials == "TM" ? "dnet-app-chips-remove" : null)">
                                    <span class="chips-person"><span class="chips-person-avatar" aria-hidden="true">@person.Initials</span><span>@person.Name</span></span>
                                </DnetChip>
                            }
                        </DnetChipList>
                    </div>
                    <div class="demo-actions">
                        <DnetButton Variant="DnetButtonVariant.Outlined" id="chips-restore-team" disabled="@(_people.Count == 3)" OnClick="RestorePeople">@S["Chips.RestoreTeam"]</DnetButton>
                    </div>
                    <p id="chips-people-action" class="demo-status" role="status">@S.Message(_peopleAction)</p>
                </div>
            </ChildContent>
            <Footer><span id="chips-people-value" class="demo-value" role="status">@S.Format("Common.0TeammatesInThisProject", _people.Count)</span></Footer>
        </DemoCard>

        <DemoCard Id="chips-appearance" Title="@S["Chips.ContextAtAGlance"]" Eyebrow="@S["Chips.IconsAndStates"]"
                  Description="@S["Chips.AddARecognizableSymbolGiveAnItemEmphasis"]">
            <div class="demo-stack">
                <div class="chips-state-row">
                    <DnetChipList>
                        <DnetChip Value="Commerce" ChipSize="ChipSize.Small" Selectable="false" Removable="false"
                                  AvatarIcon="dnet-app-chips-avatar"
                                  BackgroungColor="var(--dnet-sys-primary-emphasis)" Color="var(--dnet-sys-on-primary)" ><span>@S.Text("Commerce")</span></DnetChip>
                    </DnetChipList>
                    <p class="demo-info">@S["Chips.ALeadingIconAddsContextToACategory"]</p>
                </div>
                <div class="chips-state-row">
                    <span class="chips-disabled" aria-disabled="true">
                        <DnetChipList>
                            <DnetChip Value="Managed label" ChipSize="ChipSize.Small" Disabled="true" ><span>@S.Text("Managed label")</span></DnetChip>
                        </DnetChipList>
                    </span>
                    <p class="demo-info">@S["Chips.ThisLabelIsManagedByTheWorkspaceOwner"]</p>
                </div>
                <ul class="demo-bullets">
                    <li>@S["Chips.UseEnterOrSpaceToSelectAFocused"]</li>
                    <li>@S["Chips.TheTrailingRemoveIconIsASeparateAction"]</li>
                    <li>@S["Chips.KeepLabelsShortSoChoicesAreEasyTo"]</li>
                </ul>
            </div>
        </DemoCard>

        <div class="demo-span-all">
            <DemoCard Id="chips-sizes" Title="@S["Chips.FindTheRightFit"]" Eyebrow="@S["Chips.FourSizes"]"
                      Description="@S["Chips.UseTheSameLabelToCompareEachSize"]">
                <div class="chips-sizes">
                    @foreach (var size in _sizes)
                    {
                        <div class="chips-size-cell">
                            <div class="chips-size-label"><strong>@S.Text(size.Label)</strong><span>@size.Abbreviation</span></div>
                            <div class="chips-size-preview">
                                <DnetChipList>
                                    <DnetChip Value="Design" ChipSize="size.Size" Selected="@(size.Size == ChipSize.Large)"
                                              Selectable="false" Removable="false" ><span>@S.Text("Design")</span></DnetChip>
                                </DnetChipList>
                            </div>
                        </div>
                    }
                </div>
            </DemoCard>
        </div>
    </div>
</DemoPage>

@code {
    private readonly string[] _topics = ["Design", "Engineering", "Research", "Operations"];
    private readonly string[] _priorities = ["Low", "Normal", "High"];
    private HashSet<string> _selectedTopics = new(StringComparer.Ordinal);
    private string _priority = string.Empty;
    private List<Teammate> _people = CreatePeople();
    private string _peopleAction = "Use the remove icon beside a name to update the team.";
    private readonly SizeExample[] _sizes =
    [
        new(ChipSize.ExtraSmall, "Extra small", "XS"),
        new(ChipSize.Small, "Small", "S"),
        new(ChipSize.Medium, "Medium", "M"),
        new(ChipSize.Large, "Large", "L")
    ];

    private string TopicSummary => _selectedTopics.Count == 0
        ? "No topic filters applied"
        : $"{_selectedTopics.Count} selected · {string.Join(", ", _topics.Where(_selectedTopics.Contains).Select(S.Text))}";

    // Page renders reapply Selected; discard stale list entries after clearing.
    private void TopicsChanged(List<DnetChip> chips) => _selectedTopics = chips
        .Where(chip => chip.IsSelected() && chip.Value is not null)
        .Select(chip => chip.Value!).ToHashSet(StringComparer.Ordinal);

    private void ClearTopics() => _selectedTopics.Clear();

    private void PriorityChanged(List<DnetChip> chips) =>
        _priority = chips.FirstOrDefault(chip => chip.IsSelected())?.Value ?? string.Empty;

    private void RemovePerson(DnetChip chip)
    {
        _people.RemoveAll(person => person.Name == chip.Value);
        _peopleAction = $"{chip.Value} removed from the project.";
    }

    private void RestorePeople()
    {
        _people = CreatePeople();
        _peopleAction = "Team restored · everyone is back in the project.";
    }

    private static List<Teammate> CreatePeople() =>
    [
        new("Taylor Morgan", "TM"), new("Alex Rivera", "AR"), new("Sam Chen", "SC")
    ];

    private sealed record Teammate(string Name, string Initials);
    private sealed record SizeExample(ChipSize Size, string Label, string Abbreviation);
}
