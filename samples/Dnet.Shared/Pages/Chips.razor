@page "/Chips"
@using Dnet.Blazor.Components.Chips
@using Dnet.Blazor.Components.Button

<DemoPage Id="demo-chips" Title="Chips" Category="Selection controls"
          Description="Keep choices compact, make filters easy to scan and give related items a clear place in your workspace."
          Badge="Select · Remove · Customize">
    <div class="demo-grid">
        <DemoCard Id="chips-topics" Title="Filter by topic" Eyebrow="Multiple choices"
                  Description="Choose the topics you want to follow. Select a chip again to remove it from your filters.">
            <ChildContent>
                <div class="demo-stack">
                    <div class="chips-stage demo-preview" role="group" aria-label="Topic filters">
                        <DnetChipList Multi="true" OnSelectionChange="TopicsChanged">
                            @foreach (var topic in _topics)
                            {
                                <DnetChip @key="topic" Value="@topic" ChipSize="ChipSize.Large"
                                          Selected="@_selectedTopics.Contains(topic)" Removable="false" />
                            }
                        </DnetChipList>
                    </div>
                    <div class="demo-actions">
                        <DnetButton id="chips-clear-topics" disabled="@(_selectedTopics.Count == 0)" OnClick="ClearTopics">Clear filters</DnetButton>
                    </div>
                    <p class="demo-muted">Combine several topics without leaving this view.</p>
                </div>
            </ChildContent>
            <Footer><span id="chips-topics-value" class="demo-value" role="status">@TopicSummary</span></Footer>
        </DemoCard>

        <DemoCard Id="chips-priority" Title="Set a project priority" Eyebrow="Single choice"
                  Description="Choose one priority for the project. Selecting the active chip again clears the choice.">
            <ChildContent>
                <div class="demo-stack">
                    <div class="chips-stage demo-preview" role="group" aria-label="Project priority">
                        <DnetChipList OnSelectionChange="PriorityChanged">
                            @foreach (var priority in _priorities)
                            {
                                <DnetChip @key="priority" Value="@priority" ChipSize="ChipSize.Medium"
                                          Selected="@(_priority == priority)" Removable="false" />
                            }
                        </DnetChipList>
                    </div>
                    <div class="chips-priority-preview">
                        <span class="demo-info">Website launch</span>
                        <p class="demo-value">Make room for the work that matters</p>
                        <span class="demo-muted">Your choice stays visible in the project summary below.</span>
                    </div>
                </div>
            </ChildContent>
            <Footer><span id="chips-priority-value" class="demo-value" role="status">@(_priority.Length == 0 ? "No priority selected" : $"Priority: {_priority}")</span></Footer>
        </DemoCard>

        <DemoCard Id="chips-people" Title="People in this project" Eyebrow="Removable items"
                  Description="Keep the project team in view. Remove a person with the trailing icon, then restore the example to try again.">
            <ChildContent>
                <div class="demo-stack">
                    <div class="chips-stage demo-preview" role="group" aria-label="Project team">
                        @if (_people.Count == 0)
                        {
                            <div id="chips-people-empty" class="chips-empty">
                                <strong>No teammates yet</strong>
                                <p class="demo-muted">Restore the team to bring everyone back.</p>
                            </div>
                        }
                        <DnetChipList>
                            @foreach (var person in _people)
                            {
                                <DnetChip @key="person.Name" Value="@person.Name" ChipSize="ChipSize.Medium"
                                          Selectable="false" OnRemoved="RemovePerson"
                                          RemoveIcon="@(person.Initials == "TM" ? "dnet-app-chips-remove" : null)">
                                    <span class="chips-person"><span class="chips-person-avatar" aria-hidden="true">@person.Initials</span><span>@person.Name</span></span>
                                </DnetChip>
                            }
                        </DnetChipList>
                    </div>
                    <div class="demo-actions">
                        <DnetButton id="chips-restore-team" disabled="@(_people.Count == 3)" OnClick="RestorePeople">Restore team</DnetButton>
                    </div>
                    <p id="chips-people-action" class="demo-status" role="status">@_peopleAction</p>
                </div>
            </ChildContent>
            <Footer><span id="chips-people-value" class="demo-value" role="status">@_people.Count @(_people.Count == 1 ? "teammate" : "teammates") in this project</span></Footer>
        </DemoCard>

        <DemoCard Id="chips-appearance" Title="Context at a glance" Eyebrow="Icons and states"
                  Description="Add a recognizable symbol, give an item emphasis or explain why an option is unavailable.">
            <div class="demo-stack">
                <div class="chips-state-row">
                    <DnetChipList>
                        <DnetChip Value="Commerce" ChipSize="ChipSize.Small" Selectable="false" Removable="false"
                                  AvatarIcon="dnet-app-chips-avatar"
                                  BackgroungColor="var(--dnet-sys-primary-emphasis)" Color="var(--dnet-sys-on-primary)" />
                    </DnetChipList>
                    <p class="demo-info">A leading icon adds context to a category.</p>
                </div>
                <div class="chips-state-row">
                    <span class="chips-disabled" aria-disabled="true">
                        <DnetChipList>
                            <DnetChip Value="Managed label" ChipSize="ChipSize.Small" Disabled="true" />
                        </DnetChipList>
                    </span>
                    <p class="demo-info">This label is managed by the workspace owner. It cannot be selected or removed.</p>
                </div>
                <ul class="demo-bullets">
                    <li>Use Enter or Space to select a focused chip.</li>
                    <li>The trailing remove icon is a separate action.</li>
                    <li>Keep labels short so choices are easy to compare.</li>
                </ul>
            </div>
        </DemoCard>

        <div class="demo-span-all">
            <DemoCard Id="chips-sizes" Title="Find the right fit" Eyebrow="Four sizes"
                      Description="Use the same label to compare each size. The large example shows the selected appearance.">
                <div class="chips-sizes">
                    @foreach (var size in _sizes)
                    {
                        <div class="chips-size-cell">
                            <div class="chips-size-label"><strong>@size.Label</strong><span>@size.Abbreviation</span></div>
                            <div class="chips-size-preview">
                                <DnetChipList>
                                    <DnetChip Value="Design" ChipSize="size.Size" Selected="@(size.Size == ChipSize.Large)"
                                              Selectable="false" Removable="false" />
                                </DnetChipList>
                            </div>
                        </div>
                    }
                </div>
            </DemoCard>
        </div>
    </div>
</DemoPage>

@code {
    private readonly string[] _topics = ["Design", "Engineering", "Research", "Operations"];
    private readonly string[] _priorities = ["Low", "Normal", "High"];
    private HashSet<string> _selectedTopics = new(StringComparer.Ordinal);
    private string _priority = string.Empty;
    private List<Teammate> _people = CreatePeople();
    private string _peopleAction = "Use the remove icon beside a name to update the team.";
    private readonly SizeExample[] _sizes =
    [
        new(ChipSize.ExtraSmall, "Extra small", "XS"),
        new(ChipSize.Small, "Small", "S"),
        new(ChipSize.Medium, "Medium", "M"),
        new(ChipSize.Large, "Large", "L")
    ];

    private string TopicSummary => _selectedTopics.Count == 0
        ? "No topic filters applied"
        : $"{_selectedTopics.Count} selected · {string.Join(", ", _topics.Where(_selectedTopics.Contains))}";

    // Page renders reapply Selected; discard stale list entries after clearing.
    private void TopicsChanged(List<DnetChip> chips) => _selectedTopics = chips
        .Where(chip => chip.IsSelected() && chip.Value is not null)
        .Select(chip => chip.Value!).ToHashSet(StringComparer.Ordinal);

    private void ClearTopics() => _selectedTopics.Clear();

    private void PriorityChanged(List<DnetChip> chips) =>
        _priority = chips.FirstOrDefault(chip => chip.IsSelected())?.Value ?? string.Empty;

    private void RemovePerson(DnetChip chip)
    {
        _people.RemoveAll(person => person.Name == chip.Value);
        _peopleAction = $"{chip.Value} removed from the project.";
    }

    private void RestorePeople()
    {
        _people = CreatePeople();
        _peopleAction = "Team restored · everyone is back in the project.";
    }

    private static List<Teammate> CreatePeople() =>
    [
        new("Taylor Morgan", "TM"), new("Alex Rivera", "AR"), new("Sam Chen", "SC")
    ];

    private sealed record Teammate(string Name, string Initials);
    private sealed record SizeExample(ChipSize Size, string Label, string Abbreviation);
}
