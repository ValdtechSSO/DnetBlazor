@page "/Timeline"
@using Dnet.Blazor.Components.Timeline
@using Dnet.Blazor.Components.Button

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-timeline" Title="@S["Timeline.Timeline"]" Category="@S["Timeline.StoriesAndProcesses"]"
          Description="@S["Timeline.GiveContextToEveryMomentFollowAnOrder"]"
          Badge="@S["Timeline.MomentsStatesPeople"]">
    <DemoCard Id="timeline-order-card" Title="@S["Timeline.YourOrderStepByStep"]" Eyebrow="@S["Timeline.Order2048"]"
              Description="@S["Timeline.AClearViewOfWhatHasHappenedWhat"]">
        <ChildContent>
            <div class="timeline-order-layout">
                <div class="timeline-order-story">
                    <DnetTimeline AriaLabel="@S["Timeline.Order2048Tracking"]" id="timeline-default">
                        <DnetTimelineItem Title="@S["Timeline.OrderConfirmed"]" Status="OrderStatus(0)" StatusLabel="@S.Text(OrderStatusLabel(0))"
                                          Timestamp="@S["Common.Oct160915"]" DateTime="2026-10-16T09:15:00+02:00" id="timeline-confirmed">
                            <ChildContent><p>@S["Timeline.WeReceivedYourOrderAndThePaymentWas"]</p></ChildContent>
                        </DnetTimelineItem>
                        <DnetTimelineItem Title="@S["Timeline.PreparingYourPackage"]" Status="OrderStatus(1)" StatusLabel="@S.Text(OrderStatusLabel(1))"
                                          Timestamp="@S["Common.Oct161030"]" DateTime="2026-10-16T10:30:00+02:00" id="timeline-preparing">
                            <ChildContent>
                                <p>@S.Text(_orderStage > 1 ? "Productos revisados y paquete listo para salir del almacén." : "Estamos reuniendo tus productos y preparando todo para el envío.")</p>
                                <a href="/PillTabs" id="timeline-event-link" class="timeline-related-link">@S["Timeline.ExploreOtherWaysToOrganizeStates"]</a>
                            </ChildContent>
                        </DnetTimelineItem>
                        <DnetTimelineItem Title="@S["Timeline.OnTheWay"]" Status="OrderStatus(2)" StatusLabel="@S.Text(OrderStatusLabel(2))"
                                          Timestamp="@(_orderStage >= 2 ? S.Text("16 oct · 15:30") : S.Text("Próxima actualización"))"
                                          DateTime="@(_orderStage >= 2 ? "2026-10-16T15:30:00+02:00" : null)" id="timeline-shipping">
                            <ChildContent><p>@S.Text(_orderStage > 2 ? "Tu paquete ha llegado al centro de reparto de destino." : _orderStage == 2 ? "Tu paquete ya ha salido del almacén y está en camino." : "Te avisaremos cuando el paquete salga del almacén.")</p></ChildContent>
                        </DnetTimelineItem>
                        <DnetTimelineItem Title="@S["Timeline.Delivery"]" Status="OrderStatus(3)" StatusLabel="@S.Text(OrderStatusLabel(3))"
                                          Timestamp="@(_orderStage == 4 ? S.Text("17 oct · 10:15") : S.Text("17 oct · de 09:00 a 14:00"))"
                                          DateTime="@(_orderStage == 4 ? "2026-10-17T10:15:00+02:00" : null)" id="timeline-delivery">
                            <ChildContent><p>@S.Display(_orderStage == 4 ? "Pedido entregado. Todo listo para disfrutar de tus productos." : "El último paso: recibir tu pedido en la dirección que has elegido.")</p></ChildContent>
                        </DnetTimelineItem>
                    </DnetTimeline>
                </div>
                <aside class="timeline-order-details" aria-labelledby="timeline-order-details-title">
                    <span class="timeline-tag">@S["Timeline.InteractiveExample"]</span>
                    <h3 id="timeline-order-details-title">@S["Timeline.EverythingUnderControl"]</h3>
                    <dl class="timeline-order-facts">
                        <div><dt>@S["Timeline.OrderStatus"]</dt><dd id="timeline-order-state">@S.Display(OrderState)</dd></div>
                        <div><dt>@S["Timeline.ExpectedDelivery"]</dt><dd>@S["Timeline.October1709001400"]</dd></div>
                        <div><dt>@S["Timeline.Method"]</dt><dd>@S["Timeline.HomeDelivery"]</dd></div>
                    </dl>
                    <div class="timeline-progress">
                        <label for="timeline-order-progress">@S.Format("Common.0Of4StepsCompleted", _orderStage)</label>
                        <progress id="timeline-order-progress" max="4" value="@_orderStage">@S.Format("Common.0Of4", _orderStage)</progress>
                    </div>
                    <div class="demo-actions">
                        <DnetButton id="timeline-advance" disabled="@(_orderStage == 4)" OnClick="AdvanceOrder">@S.Display(NextAction)</DnetButton>
                        <DnetButton Variant="DnetButtonVariant.Outlined" id="timeline-reset" disabled="@(_orderStage == 1)" OnClick="ResetOrder">@S["Timeline.Reset"]</DnetButton>
                    </div>
                    <p class="demo-status">@S["Timeline.AdvanceTheExampleToSeeTheOrderChange"]</p>
                </aside>
            </div>
        </ChildContent>
        <Footer><span id="timeline-order-value" class="demo-value" role="status">@S.Format("Common.0Of4StepsCompleted1", _orderStage, S.Text(OrderState))</span></Footer>
    </DemoCard>

    <DemoCard Id="timeline-project-card" Title="@S["Timeline.AGrowingProject"]" Eyebrow="@S["Timeline.ProjectMilestones"]"
              Description="@S["Timeline.ASharedStoryWithRoomForAchievementsAnd"]">
        <ChildContent>
            <DnetTimeline Alignment="DnetTimelineAlignment.Alternate" AriaLabel="@S["Timeline.ProjectHistory"]" id="timeline-alternate">
                <DnetTimelineItem Title="@S["Timeline.TheFirstIdea"]" Status="DnetTimelineItemStatus.Completed" StatusLabel="@S["Timeline.Completed"]"
                                  Timestamp="@S["Common.January12"]" DateTime="2026-01-12" id="timeline-alternate-first">
                    <ChildContent><p>@S["Timeline.ASmallTeamImaginedAnEasierWayTo"]</p></ChildContent>
                    <OppositeContent><div class="timeline-milestone"><span class="timeline-tag">@S["Timeline.January2026"]</span><strong>@S["Timeline.DiscoverTheProblem"]</strong><span>@S["Timeline.ProductAndDesignFirstProposal"]</span></div></OppositeContent>
                </DnetTimelineItem>
                <DnetTimelineItem Title="@S["Timeline.APlaceForEveryone"]" Status="DnetTimelineItemStatus.Current" StatusLabel="@S["Timeline.InProgress"]"
                                  Timestamp="@S["Common.October16"]" DateTime="2026-10-16" id="timeline-alternate-second">
                    <ChildContent><p>@S["Timeline.WeTryTheFirstExperiencesWithThePeople"]</p></ChildContent>
                    <OppositeContent><div class="timeline-milestone"><span class="timeline-tag">@S["Timeline.October2026"]</span><strong>@S["Timeline.ListenAndImprove"]</strong><span>@S["Timeline.ExperienceTeamUserResearch"]</span></div></OppositeContent>
                </DnetTimelineItem>
                <DnetTimelineItem Title="@S["Timeline.TheNextChapter"]" Status="DnetTimelineItemStatus.Pending" StatusLabel="@S["Timeline.Pending"]"
                                  Timestamp="@S["Common.NextMilestone"]" id="timeline-alternate-third">
                    <ChildContent><p>@S["Timeline.WeWillOpenTheDoorToNewIdeas"]</p></ChildContent>
                    <OppositeContent><div class="timeline-milestone"><span class="timeline-tag">@S["Timeline.ComingNext"]</span><strong>@S["Timeline.ShareTheResult"]</strong><span>@S["Timeline.TheWholeTeamNextLaunch"]</span></div></OppositeContent>
                </DnetTimelineItem>
            </DnetTimeline>
        </ChildContent>
        <Footer><span class="demo-info">@S["Timeline.OneCompletedMilestoneOneInProgressAndA"]</span></Footer>
    </DemoCard>

    <div class="demo-grid">
        <DemoCard Id="timeline-activity-card" Title="@S["Timeline.ThePeopleBehindTheChange"]" Eyebrow="@S["Timeline.TeamActivity"]"
                  Description="@S["Timeline.CustomMarkersGiveEachUpdateAnIdentityEvery"]">
            <ChildContent>
                <DnetTimeline Alignment="DnetTimelineAlignment.End" AriaLabel="@S["Timeline.TeamActivity"]" id="timeline-end">
                    <DnetTimelineItem Title="@S["Timeline.AnaUpdatedTheProposal"]" Status="DnetTimelineItemStatus.Completed" StatusLabel="@S["Timeline.Completed"]"
                                      Timestamp="@S["Common.Oct161010"]" DateTime="2026-10-16T10:10:00+02:00" id="timeline-activity-ana">
                        <BulletContent>@S["Timeline.A"]</BulletContent>
                        <ChildContent><p>@S["Timeline.TheNewSketchesAreReadyToShareWith"]</p></ChildContent>
                    </DnetTimelineItem>
                    <DnetTimelineItem Title="@S["Timeline.LucasIsReviewingTheDetails"]" Status="DnetTimelineItemStatus.Current" StatusLabel="@S["Timeline.InProgress"]"
                                      Timestamp="@S["Common.Oct161030"]" DateTime="2026-10-16T10:30:00+02:00" id="timeline-activity-lucas">
                        <BulletContent>@S["Timeline.L"]</BulletContent>
                        <ChildContent><p>@S["Timeline.AFinalLookBeforeTheNextStep"]</p></ChildContent>
                    </DnetTimelineItem>
                    <DnetTimelineItem Title="@S["Timeline.MarinaWillPrepareTheLaunch"]" Status="DnetTimelineItemStatus.Pending" StatusLabel="@S["Timeline.Pending"]"
                                      Timestamp="@S["Common.NextReview"]" id="timeline-activity-marina">
                        <BulletContent>@S["Timeline.M"]</BulletContent>
                        <ChildContent><p>@S["Timeline.TheNextMeetingWillHelpUsShareThe"]</p></ChildContent>
                    </DnetTimelineItem>
                </DnetTimeline>
            </ChildContent>
            <Footer><span class="demo-info">@S["Timeline.ThreePeopleOneSharedStory"]</span></Footer>
        </DemoCard>

        <DemoCard Id="timeline-direction-card" Title="@S["Timeline.TheSameStoryInAnotherDirection"]" Eyebrow="@S["Timeline.RightToLeftReading"]"
                  Description="@S["Timeline.ThisArabicRequestKeepsTheEventOrderAnd"]">
            <ChildContent>
                <DnetTimeline AriaLabel="@S["Common.RequestTracking"]" dir="rtl" lang="@S.Culture.TwoLetterISOLanguageName" id="timeline-rtl">
                    <DnetTimelineItem Title="@S["Common.RequestReceived"]" Status="DnetTimelineItemStatus.Completed" StatusLabel="@S["Common.Completed"]"
                                      Timestamp="09:00" DateTime="2026-10-16T09:00:00+02:00" id="timeline-rtl-received">
                        <ChildContent><p>@S["Common.AllDocumentsHaveArrivedWeCanStartTheReview"]</p></ChildContent>
                    </DnetTimelineItem>
                    <DnetTimelineItem Title="@S["Common.ReviewInProgress"]" Status="DnetTimelineItemStatus.Current" StatusLabel="@S["Common.InProgress"]"
                                      Timestamp="10:45" DateTime="2026-10-16T10:45:00+02:00" id="timeline-rtl-review">
                        <ChildContent><p>@S["Common.TheTeamIsCheckingTheInformationBeforeReplying"]</p></ChildContent>
                    </DnetTimelineItem>
                    <DnetTimelineItem Title="@S["Common.FinalDecision"]" Status="DnetTimelineItemStatus.Pending" StatusLabel="@S["Common.Pending2"]"
                                      Timestamp="@S["Common.NextUpdate"]" id="timeline-rtl-resolution">
                        <ChildContent><p>@S["Common.YouWillReceiveConfirmationWhenYourRequestHasBeen"]</p></ChildContent>
                    </DnetTimelineItem>
                </DnetTimeline>
            </ChildContent>
            <Footer><span class="demo-info">@S["Timeline.EventsKeepTheirOrderInEveryDirection"]</span></Footer>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private int _orderStage = 1;

    private string OrderState => _orderStage switch
    {
        1 => "Preparando tu paquete",
        2 => "En camino",
        3 => "En reparto",
        _ => "Pedido entregado"
    };

    private string NextAction => _orderStage switch
    {
        1 => "Enviar paquete",
        2 => "Iniciar reparto",
        3 => "Completar entrega",
        _ => "Pedido entregado"
    };

    private DnetTimelineItemStatus OrderStatus(int step) => step < _orderStage
        ? DnetTimelineItemStatus.Completed
        : step == _orderStage ? DnetTimelineItemStatus.Current : DnetTimelineItemStatus.Pending;

    private string OrderStatusLabel(int step) => OrderStatus(step) switch
    {
        DnetTimelineItemStatus.Completed => "Completado",
        DnetTimelineItemStatus.Current => "En curso",
        _ => "Pendiente"
    };

    private void AdvanceOrder()
    {
        if (_orderStage < 4) _orderStage++;
    }

    private void ResetOrder() => _orderStage = 1;
}
