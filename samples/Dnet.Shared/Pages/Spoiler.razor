@page "/Spoiler"
@using Dnet.Blazor.Components.Spoiler
@using Dnet.Blazor.Components.Button
@using Dnet.Blazor.Components.Form

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-spoiler" Title="@S["Spoiler.Spoiler"]" Category="@S["Spoiler.ContentAndReading"]"
          Description="@S["Spoiler.OfferAFirstGlimpseAndLetPeopleChoose"]"
          Badge="@S["Spoiler.DiscoverExpandContinue"]">
    <DemoCard Id="spoiler-article-card" Title="@S["Spoiler.AWeekendToDiscoverSomethingNew"]" Eyebrow="@S["Spoiler.InspiringReads"]"
              Description="@S["Spoiler.APreviewToSparkCuriosityWithTheFull"]">
        <ChildContent>
            <div class="spoiler-article-layout">
                <div class="demo-stack">
                    <div class="spoiler-article-meta"><span class="spoiler-tag">@S["Spoiler.UnhurriedGetaways"]</span><span class="demo-muted">@S["Spoiler.EditorialTeamOct162026"]</span></div>
                    <div class="spoiler-reading-preview">
                        <DnetSpoiler MaxHeight="110" ShowLabel="@S["Spoiler.ReadTheFullArticle"]" HideLabel="@S["Spoiler.ShowOnlyTheSummary"]"
                                     AriaLabel="@S["Spoiler.SampleArticle"]" id="spoiler-basic">
                            @Article
                        </DnetSpoiler>
                    </div>
                </div>
                <aside class="spoiler-reading-guide" aria-labelledby="spoiler-guide-title">
                    <span class="spoiler-tag">@S["Spoiler.APauseToRead"]</span>
                    <h3 id="spoiler-guide-title">@S["Spoiler.IdeasThatLeaveRoom"]</h3>
                    <p class="demo-muted">@S["Spoiler.AWalkAConversationAndASharedPlan"]</p>
                    <ul class="demo-bullets">
                        <li>@S["Spoiler.FindAnIdeaForNextWeekend"]</li>
                        <li>@S["Spoiler.ReadTheArticleAtYourOwnPace"]</li>
                        <li>@S["Spoiler.ReturnToTheSummaryToKeepExploring"]</li>
                    </ul>
                </aside>
            </div>
        </ChildContent>
        <Footer><span class="demo-info">@S["Spoiler.ContentExpandsOnTheSamePageWithoutInterrupting"]</span></Footer>
    </DemoCard>

    <div class="demo-grid">
        <DemoCard Id="spoiler-details-card" Title="@S["Spoiler.DetailsWhenYouNeedThem"]" Eyebrow="@S["Spoiler.ControlsWorkingTogether"]"
                  Description="@S["Spoiler.ExpandOrCollapseFromEitherControlYourLinks"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="demo-actions"><DnetButton Variant="DnetButtonVariant.Outlined" id="spoiler-external-toggle" OnClick="ToggleDetails">@S.Display(_expanded ? "Cerrar detalles" : "Abrir detalles")</DnetButton></div>
                    <div class="demo-preview">
                        <DnetSpoiler MaxHeight="90" @bind-Expanded="_expanded" ShowLabel="@S["Spoiler.ShowAllDetails"]" HideLabel="@S["Spoiler.HideDetails"]"
                                     AriaLabel="@S["Spoiler.DetailsAndLinks"]" id="spoiler-controlled">
                            <p class="spoiler-visible-resource"><a href="/PillTabs" id="spoiler-visible-link">@S["Spoiler.ExplorePillTabs"]</a></p>
                            <p class="spoiler-interactive-copy">@S["Spoiler.ReadMoreBeforeContinuingOpenTheDetailsTo"]</p>
                            <div class="spoiler-extra-details">
                                <a href="/theming" id="spoiler-hidden-link">@S["Spoiler.ExploreTheLibraryThemes"]</a>
                                <DnetFormField Label="@S["Skeleton.AnIdeaToRemember"]">
                                    <DnetInputText id="spoiler-note" @bind-Value="_note" PlaceHolder="@S["Spoiler.WriteANote"]" />
                                </DnetFormField>
                                <button type="button" inert id="spoiler-original-inert" class="spoiler-unavailable">@S["Spoiler.ActionUnavailable"]</button>
                                <p class="demo-info">@S["Spoiler.YourNoteStaysWhenYouCollapseTheContent"]</p>
                            </div>
                        </DnetSpoiler>
                    </div>
                </div>
            </ChildContent>
            <Footer>
                <div class="spoiler-state-summary">
                    <span id="spoiler-controlled-state" class="demo-value" role="status">@S.Format("Common.State0", S.Text(_expanded ? "expanded" : "collapsed"))</span>
                    <span id="spoiler-note-value" class="demo-info">@S.Format("Common.Note0", string.IsNullOrWhiteSpace(_note) ? S.Text("No notes") : _note)</span>
                </div>
            </Footer>
        </DemoCard>

        <DemoCard Id="spoiler-dynamic-card" Title="@S["Spoiler.ADescriptionThatCanGrow"]" Eyebrow="@S["Spoiler.DynamicContent"]"
                  Description="@S["Spoiler.StartWithAShortNoteAndAddThe"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="demo-actions"><DnetButton Variant="DnetButtonVariant.Outlined" id="spoiler-change-content" OnClick="ChangeContent">@S.Display(_longContent ? "Mostrar texto corto" : "Añadir texto largo")</DnetButton></div>
                    <div class="demo-preview">
                        <DnetSpoiler MaxHeight="100" ShowLabel="@S["Spoiler.ReadTheFullDescription"]" HideLabel="@S["Spoiler.SummarizeTheDescription"]" id="spoiler-dynamic">
                            @if (_longContent)
                            {
                                @Article
                            }
                            else
                            {
                                <p class="spoiler-short-copy">@S["Spoiler.ThereAreNoAdditionalDetailsYet"]</p>
                            }
                        </DnetSpoiler>
                    </div>
                    <p class="demo-status">@S["Spoiler.IfYouAlreadyExpandedTheDescriptionItWill"]</p>
                </div>
            </ChildContent>
            <Footer><span id="spoiler-content-state" class="demo-value" role="status">@S.Display(_longContent ? "Artículo completo disponible" : "Descripción breve")</span></Footer>
        </DemoCard>

        <DemoCard Id="spoiler-short-card" Title="@S["Spoiler.WhenAFewWordsAreEnough"]" Eyebrow="@S["Spoiler.ShortContent"]"
                  Description="@S["Spoiler.TheWholeMessageIsVisibleThereIsNothing"]">
            <ChildContent>
                <div class="demo-stack">
                    <span class="spoiler-tag">@S["Spoiler.FullReading"]</span>
                    <div class="demo-preview">
                        <DnetSpoiler ShowLabel="@S["Spoiler.ShowMore"]" HideLabel="@S["Spoiler.ShowLess"]" id="spoiler-short">
                            <p class="spoiler-short-copy">@S["Spoiler.ThisContentIsShortAndFullyVisible"]</p>
                        </DnetSpoiler>
                    </div>
                    <p class="demo-muted spoiler-short-note">@S["Spoiler.TheSameComponentAdaptsToTheContentLength"]</p>
                </div>
            </ChildContent>
            <Footer><span class="demo-info">@S["Spoiler.NoExtraStepsForAShortMessage"]</span></Footer>
        </DemoCard>

        <DemoCard Id="spoiler-direction-card" Title="@S["Spoiler.OpenFromTheStart"]" Eyebrow="@S["Spoiler.RightToLeft"]"
                  Description="@S["Spoiler.ThisArabicTextStartsExpandedReadingAndControls"]">
            <ChildContent>
                <div class="demo-preview">
                    <DnetSpoiler MaxHeight="70" DefaultExpanded="true" ShowLabel="@S["Common.ShowMore"]" HideLabel="@S["Common.ShowLess"]"
                                 AriaLabel="@S["Common.AJourneyToDiscoverNewPlaces"]" dir="rtl" lang="@S.Culture.TwoLetterISOLanguageName"
                                 style="--dnet-spoiler-gap: 12px;" id="spoiler-rtl">
                        <div class="spoiler-article-text">
                            <p>@S["Common.TheJourneyStartsWithQuietStepsAlongNewStreets"]</p>
                            <p>@S["Common.InTheAfternoonWeShareATableExchangeIdeas"]</p>
                            <p>@S["Common.AtTheEndOfTheDayWeReturnWith"]</p>
                        </div>
                    </DnetSpoiler>
                </div>
            </ChildContent>
            <Footer><span class="demo-info">@S["Spoiler.YouCanSummarizeItAndReopenItWith"]</span></Footer>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private bool _expanded;
    private bool _longContent;
    private string _note = string.Empty;

    private void ToggleDetails() => _expanded = !_expanded;
    private void ChangeContent() => _longContent = !_longContent;

    private RenderFragment Article => @<div class="spoiler-article-text">
        <p>@S["Common.SometimesADifferentPathLeadsToAPlaceWe"]</p>
        <p>@S["Common.ThePlanStartsInTheMorningWithTimeTo"]</p>
        <p>@S["Common.InTheAfternoonVisitTheParkPrepareASnack"]</p>
        <p>@S["Common.WhenWeReturnThePhotographsStoriesAndDesireTo"]</p>
    </div>;
}
