@page "/PickList"
@using Dnet.Blazor.Components.PickList

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-picklist" Title="@S["PickList.PickList"]" Category="@S["SlideToggle.SelectionControls"]"
          Description="@S["PickList.TurnALongListIntoAFocusedSelection"]"
          Badge="@S["PickList.SearchSelectKeep"]">
    <div class="demo-grid">
        <DemoCard Id="picklist-local" Title="@S["PickList.ChooseParticipatingTeams"]" Eyebrow="@S["PickList.LocalCollection"]"
                  Description="@S["PickList.BuildTheLineupForYourNextCompetitionSearch"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="picklist-context"><span class="picklist-tag">@S["PickList.Season2026"]</span><span class="demo-muted">@S["PickList.7TeamsAvailable"]</span></div>
                    <PickList TItem="Team" TKey="int" Items="@_teams"
                              ItemKey="team => team.Id" SearchTextSelector="SearchableText"
                              @bind-SelectedKeys="_localSelectedKeys" PageSize="4">
                        <ItemTemplate Context="team">
                            <span class="picklist-team">
                                <span class="picklist-avatar" aria-hidden="true">@team.Initials</span>
                                <span class="picklist-copy"><span class="picklist-name">@team.Name</span><span class="picklist-city">@S.Display(team.City)</span></span>
                            </span>
                        </ItemTemplate>
                    </PickList>
                    <p class="demo-status">@S["PickList.YourSelectionStaysWithYouWhenYouSearch"]</p>
                </div>
            </ChildContent>
            <Footer>
                <div id="picklist-local-value" class="picklist-summary" role="status">
                    <span class="demo-info">@S.Message(SelectionCount(_localSelectedKeys.Count))</span>
                    <span class="demo-value">@S.Message(SelectionSummary(_localSelectedKeys))</span>
                </div>
            </Footer>
        </DemoCard>

        <DemoCard Id="picklist-provider" Title="@S["PickList.ExploreTheTeamDirectory"]" Eyebrow="@S["PickList.PagedCollection"]"
                  Description="@S["PickList.BrowseTheDirectoryThreeTeamsAtATime"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="picklist-context"><span class="picklist-tag">@S["PickList.LeagueDirectory"]</span><span class="demo-muted">@S["PickList.3TeamsPerPage"]</span></div>
                    <PickList TItem="Team" TKey="int" ItemsProvider="LoadTeamsAsync"
                              ItemKey="team => team.Id" @bind-SelectedKeys="_providerSelectedKeys" PageSize="3">
                        <ItemTemplate Context="team">
                            <span class="picklist-team">
                                <span class="picklist-avatar" aria-hidden="true">@team.Initials</span>
                                <span class="picklist-copy"><span class="picklist-name">@team.Name</span><span class="picklist-city">@S.Display(team.City)</span></span>
                            </span>
                        </ItemTemplate>
                    </PickList>
                    <p id="picklist-provider-note" class="demo-status">@S.Display(_providerSelectedKeys.Contains(99)
                        ? "An archived team is still on your shortlist. Clear the selection to remove it."
                        : "Selections remain available even when their teams are outside the current results.")</p>
                </div>
            </ChildContent>
            <Footer>
                <div id="picklist-provider-value" class="picklist-summary" role="status">
                    <span class="demo-info">@S.Message(SelectionCount(_providerSelectedKeys.Count))</span>
                    <span class="demo-value">@S.Message(SelectionSummary(_providerSelectedKeys))</span>
                </div>
            </Footer>
        </DemoCard>

        <div class="demo-span-all">
            <DemoCard Id="picklist-localized" Title="@S["PickList.ASelectionForYourLeague"]" Eyebrow="@S["PickList.LocalizedExperience"]"
                      Description="@S["PickList.EverySearchActionAndPageControlCanSpeak"]">
                <ChildContent>
                    <div class="picklist-localized-layout">
                        <div class="demo-stack">
                            <PickList TItem="Team" TKey="int" Items="@_teams" ItemKey="team => team.Id"
                                      SearchTextSelector="SearchableText" IsItemDisabled="team => team.Id == 1"
                                      @bind-SelectedKeys="_localizedSelectedKeys" Strings="@SpanishStrings" PageSize="4">
                                <ItemTemplate Context="team">
                                    <span class="picklist-team">
                                        <span class="picklist-avatar" aria-hidden="true">@team.Initials</span>
                                        <span class="picklist-copy"><span class="picklist-name">@team.Name</span><span class="picklist-city">@S.Display(team.City)</span></span>
                                        @if (team.Id == 1)
                                        {
                                            <span class="picklist-locked">@S["PickList.Fixed"]</span>
                                        }
                                    </span>
                                </ItemTemplate>
                            </PickList>
                        </div>
                        <aside class="picklist-guide" aria-labelledby="picklist-guide-title">
                            <span class="picklist-tag">@S["PickList.ReadyForYourTeam"]</span>
                            <h3 id="picklist-guide-title">@S["PickList.YourLeagueYourTeams"]</h3>
                            <p class="demo-muted">@S["PickList.SearchByNameOrCityAndBringTogether"]</p>
                            <ul class="demo-bullets">
                                <li>@S["PickList.SelectPageAddsTheVisibleTeams"]</li>
                                <li>@S["PickList.YourSelectedTeamsStaySelectedAsYouSearch"]</li>
                                <li>@S["PickList.AlicanteThunderIsFixedAndStaysSelectedWhen"]</li>
                            </ul>
                            <p class="demo-info">@S["PickList.WhenNothingMatchesTheListShowsAHelpful"]</p>
                        </aside>
                    </div>
                </ChildContent>
                <Footer>
                    <div id="picklist-localized-value" class="picklist-summary" role="status">
                        <span class="demo-info">@S.Format("Common.0TeamsSelected1Fixed", _localizedSelectedKeys.Count)</span>
                        <span class="demo-value">@S.Message(SelectionSummary(_localizedSelectedKeys))</span>
                    </div>
                </Footer>
            </DemoCard>
        </div>
    </div>
</DemoPage>

@code {
    private readonly List<Team> _teams =
    [
        new(1, "Alicante Thunder", "Alicante", "AT"),
        new(2, "Bilbao Titans", "Bilbao", "BT"),
        new(3, "Burgos Bears", "Burgos", "BB"),
        new(4, "Cádiz Sharks", "Cádiz", "CS"),
        new(5, "Denia Waves", "Denia", "DW"),
        new(6, "Ebro Wolves", "Zaragoza", "EW"),
        new(7, "Faro Eagles", "Huelva", "FE")
    ];

    private IReadOnlySet<int> _localSelectedKeys = new HashSet<int> { 1, 4 };
    private IReadOnlySet<int> _providerSelectedKeys = new HashSet<int> { 2, 99 };
    private IReadOnlySet<int> _localizedSelectedKeys = new HashSet<int> { 1 };

    private PickListStrings SpanishStrings => new()
    {
        SearchPlaceholder = S.Text("Buscar equipos"),
        SelectedLabel = S.Text("Seleccionados"),
        SelectVisibleLabel = S.Text("Seleccionar página"),
        ClearLabel = S.Text("Limpiar"),
        EmptyLabel = S.Text("No hay equipos"),
        NoResultsLabel = S.Text("No se encontraron equipos"),
        PaginationLabel = S.Text("Paginación de equipos"),
        PageText = S.Text("Página"),
        OfText = S.Text("de"),
        FirstPageLabel = S.Text("Primera página"),
        PreviousPageLabel = S.Text("Página anterior"),
        PageLabelFormat = S.Text("Página {0}"),
        NextPageLabel = S.Text("Página siguiente"),
        LastPageLabel = S.Text("Última página"),
        LoadingLabel = S.Text("Cargando…")
    };

    private static string SearchableText(Team team) => $"{team.Name} {team.City}";
    private static string SelectionCount(int count) => count == 1 ? "1 team selected" : $"{count} teams selected";

    private string SelectionSummary(IReadOnlySet<int> keys)
    {
        if (keys.Count == 0) return "No teams selected";
        var names = _teams.Where(team => keys.Contains(team.Id)).Select(team => team.Name);
        return string.Join(", ", keys.Contains(99) ? names.Append(S.Text("Archived team")) : names);
    }

    private async ValueTask<PickListItemsProviderResult<Team>> LoadTeamsAsync(PickListItemsProviderRequest request)
    {
        await Task.Delay(180, request.CancellationToken);
        var filtered = string.IsNullOrWhiteSpace(request.SearchText)
            ? _teams
            : _teams.Where(team => SearchableText(team).Contains(request.SearchText, StringComparison.OrdinalIgnoreCase)).ToList();

        return new PickListItemsProviderResult<Team>(
            filtered.Skip(request.PageIndex * request.PageSize).Take(request.PageSize).ToArray(),
            request.RequestTotalCount ? _teams.Count : null,
            request.RequestFilteredCount ? filtered.Count : null);
    }

    private sealed record Team(int Id, string Name, string City, string Initials);
}
