@using System.ComponentModel.DataAnnotations
@using Dnet.Blazor.Components.Button
@using Dnet.Blazor.Components.Form
@using Dnet.Blazor.Components.Dialog.Infrastructure.Interfaces
@using Dnet.Blazor.Components.FloatingPanel.Infrastructure.Interfaces
@using Dnet.Blazor.Components.Overlay.Infrastructure.Enums
@using Dnet.Blazor.Components.Overlay.Infrastructure.Services
@inject IDialogService DialogService
@inject IFloatingPanelService FloatingPanelService

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<div class="profile-editor @(Floating ? "profile-editor-floating" : string.Empty)">
    @if (Floating)
    {
        <header class="profile-editor-header"><p>@S["Autocomplete.ContactDetails"]</p><h2 id="showcase-profile-heading">@S["ProfileEditorContent.EditProfile"]</h2></header>
    }
    <p class="profile-editor-description">@S["ProfileEditorContent.KeepThisContactSDetailsUpToDate"]</p>
    <EditForm Model="_profile" OnValidSubmit="SaveProfile" class="profile-editor-form">
        <DataAnnotationsValidator />
        <div class="profile-editor-fields">
            <div class="profile-editor-field"><DnetFormField Label="@S["ProfileEditorContent.FullName"]" IsRequired="true"><ChildContent><DnetInputText id="showcase-profile-name" @bind-Value="_profile.Name" aria-label="@S["ProfileEditorContent.FullName"]" autocomplete="name" /></ChildContent><ErrorContent><SampleValidationMessage For="@(() => _profile.Name)" /></ErrorContent></DnetFormField></div>
            <div class="profile-editor-field"><DnetFormField Label="@S["ProfileEditorContent.EmailAddress"]" IsRequired="true"><ChildContent><DnetInputText id="showcase-profile-email" @bind-Value="_profile.Email" aria-label="@S["ProfileEditorContent.EmailAddress"]" autocomplete="email" /></ChildContent><ErrorContent><SampleValidationMessage For="@(() => _profile.Email)" /></ErrorContent></DnetFormField></div>
            <div class="profile-editor-field"><DnetFormField Label="@S["FormValidation.JobTitle"]"><ChildContent><DnetInputText id="showcase-profile-role" @bind-Value="_profile.Role" aria-label="@S["FormValidation.JobTitle"]" autocomplete="organization-title" /></ChildContent></DnetFormField></div>
        </div>
        <footer class="profile-editor-actions"><DnetButton id="showcase-profile-cancel" Variant="DnetButtonVariant.Outlined" OnClick="Cancel">@S["Theming.Cancel"]</DnetButton><DnetButton id="showcase-profile-save" class="profile-editor-save" ButtonType="submit">@S["FormValidation.SaveProfile"]</DnetButton></footer>
    </EditForm>
</div>

@code {
    [CascadingParameter] private int OverlayReferenceId { get; set; }
    [Parameter] public bool Floating { get; set; }
    private readonly Profile _profile = new();

    private void SaveProfile() => Close(CloseReason.Ok, $"{_profile.Name} · {_profile.Email}");
    private void Cancel() => Close(CloseReason.Cancel, null);
    private void Close(CloseReason reason, string? value)
    {
        var result = new OverlayResult { OverlayReferenceId = OverlayReferenceId, CloseReason = reason, ComponentData = value! };
        if (Floating) FloatingPanelService.Close(result);
        else DialogService.Close(result);
    }

    private sealed class Profile
    {
        [Required(ErrorMessage = "Enter a full name.")] public string Name { get; set; } = "Taylor Morgan";
        [Required(ErrorMessage = "Enter an email address."), EmailAddress(ErrorMessage = "Enter a valid email address.")] public string Email { get; set; } = "taylor.morgan@example.com";
        public string Role { get; set; } = "Product designer";
    }
}
