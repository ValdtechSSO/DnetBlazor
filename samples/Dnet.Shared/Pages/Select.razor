@page "/Select"

@using System.ComponentModel.DataAnnotations
@using Dnet.Blazor.Components.Form
@using Dnet.Blazor.Components.Select

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-select" Title="@S["Select.Select"]" Category="@S["SlideToggle.SelectionControls"]"
          Description="@S["Select.ChooseFromAFocusedListOfOptionsConnect"]"
          Badge="@S["Select.TypedSelections"]">
    <div class="demo-grid">
        <DemoCard Id="select-dependent" Title="@S["Select.ConnectedSelections"]"
                  Description="@S["Select.ChooseAnAPIResourceFirstThenSelectOne"]">
            <ChildContent>
                <EditForm Model="_right">
                    <DataAnnotationsValidator />
                    <div class="demo-stack">
                        <DnetFormField Label="@S["Select.APIResource"]" IsRequired="true">
                            <ChildContent>
                                <DnetSelect Value="@_right.ApiResourceName" TValue="string"
                                            ValueChanged="ApiResourceChangeHandler"
                                            ValueExpression="@(() => _right.ApiResourceName)"
                                            Items="_apiResources" TItem="ApiResourceDto"
                                            DisplayValueConverter="@(value => value.Name)"
                                            ValueConverter="@(value => value.Name)"
                                            OnItemSelected="ApiResourceItemSelected"
                                            PlaceHolder="@S["Select.SelectAResource"]" />
                            </ChildContent>
                            <ErrorContent>
                                <SampleValidationMessage For="@(() => _right.ApiResourceName)" />
                            </ErrorContent>
                        </DnetFormField>

                        <DnetFormField Label="@S["Select.ResourceType"]" IsRequired="true">
                            <ChildContent>
                                <DnetSelect Value="@_right.ResourceType" TValue="string"
                                            ValueChanged="ApiResourceObjectChangeHandler"
                                            ValueExpression="@(() => _right.ResourceType)"
                                            Items="_apiResourceObjects" TItem="ApiResourceObjectDto"
                                            DisplayValueConverter="@(value => value.Name)"
                                            ValueConverter="@(value => value.Name)"
                                            OnItemSelected="ApiResourceObjectItemSelected"
                                            PlaceHolder="@S["Select.SelectAResourceType"]"
                                            @ref="_apiResourceObjectReference" />
                            </ChildContent>
                            <ErrorContent>
                                <SampleValidationMessage For="@(() => _right.ResourceType)" />
                            </ErrorContent>
                        </DnetFormField>
                        <p class="demo-muted">@S["Select.ChangingTheResourceClearsThePreviousResourceType"]</p>
                    </div>
                </EditForm>
            </ChildContent>
            <Footer>
                <span class="demo-value" role="status">@S.Format("Common.Resource0Type1", S.Text(SelectionLabel(_right.ApiResourceName)), S.Text(SelectionLabel(_right.ResourceType)))</span>
            </Footer>
        </DemoCard>

        <DemoCard Id="select-numeric" Title="@S["Select.DisplayANameStoreAnID"]"
                  Description="@S["Select.ShowTheSameReadableOptionsWhileBindingAn"]">
            <ChildContent>
                <EditForm Model="_numericSelection">
                    <DataAnnotationsValidator />
                    <div class="demo-stack">
                        <DnetFormField Label="@S["Select.APIResource"]" IsRequired="true">
                            <ChildContent>
                                <DnetSelect TValue="int" @bind-Value="_numericSelection.ApiResourceId"
                                            Items="_apiResources" TItem="ApiResourceDto"
                                            DisplayValueConverter="@(value => value.Name)"
                                            ValueConverter="@(value => value.ApiResourceId)"
                                            PlaceHolder="@S["Select.SelectAResource"]" />
                            </ChildContent>
                            <ErrorContent>
                                <SampleValidationMessage For="@(() => _numericSelection.ApiResourceId)" />
                            </ErrorContent>
                        </DnetFormField>
                        <div class="demo-preview">
                            <span class="demo-info">@S["Select.SelectedResource"]</span>
                            <p class="demo-value">@S.Display(NumericResourceName)</p>
                            <span class="demo-muted">@S["Select.TheFormValueIsTheNumericIdentifierRather"]</span>
                        </div>
                    </div>
                </EditForm>
            </ChildContent>
            <Footer>
                <span class="demo-value" role="status">@S.Format("Common.ResourceID0", S.Display(_numericSelection.ApiResourceId == 0 ? "Not selected" : _numericSelection.ApiResourceId.ToString()))</span>
            </Footer>
        </DemoCard>

        <DemoCard Title="@S["Select.AFocusedChoice"]" Description="@S["Select.UseASelectWhenPeopleNeedOneValue"]">
            <ul class="demo-bullets">
                <li>@S["Select.OpenAFieldToBrowseItsAvailableOptions"]</li>
                <li>@S["Select.UseTheArrowKeysToMoveEnterTo"]</li>
                <li>@S["Select.DependentOptionsAreRefreshedWhenTheParentSelection"]</li>
            </ul>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private readonly ResourceSelection _right = new();
    private readonly NumericResourceSelection _numericSelection = new();
    private DnetSelect<ApiResourceObjectDto, string>? _apiResourceObjectReference;
    private List<ApiResourceObjectDto> _apiResourceObjects = [];

    private readonly List<ApiResourceDto> _apiResources =
    [
        new() { ApiResourceId = 1, Name = "APi_1" },
        new() { ApiResourceId = 2, Name = "APi_2" }
    ];

    private readonly List<ApiResourceObjectDto> _allResourceObjects =
    [
        new() { ApiResourceObjectId = 1, Name = "ApiResourceObject1_1", ApiResourceId = 1 },
        new() { ApiResourceObjectId = 2, Name = "ApiResourceObject1_2", ApiResourceId = 1 },
        new() { ApiResourceObjectId = 3, Name = "ApiResourceObject2_1", ApiResourceId = 2 },
        new() { ApiResourceObjectId = 4, Name = "ApiResourceObject2_2", ApiResourceId = 2 }
    ];

    private string NumericResourceName => _apiResources
        .FirstOrDefault(resource => resource.ApiResourceId == _numericSelection.ApiResourceId)?.Name ?? "No resource selected";

    private static string SelectionLabel(string? value) => string.IsNullOrWhiteSpace(value) ? "Not selected" : value;

    private void ApiResourceChangeHandler(string? value) => _right.ApiResourceName = value ?? string.Empty;

    private void ApiResourceObjectChangeHandler(string? value) => _right.ResourceType = value ?? string.Empty;

    private void ApiResourceItemSelected(ApiResourceDto item)
    {
        _right.ApiResourceName = item.Name;
        _right.ResourceType = string.Empty;
        _right.ApiResourceObjectId = null;
        _apiResourceObjects = _allResourceObjects.Where(resource => resource.ApiResourceId == item.ApiResourceId).ToList();
        _apiResourceObjectReference?.RefreshData(_apiResourceObjects);
    }

    private void ApiResourceObjectItemSelected(ApiResourceObjectDto item) =>
        _right.ApiResourceObjectId = item.ApiResourceObjectId;

    public sealed class ApiResourceDto
    {
        public int ApiResourceId { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    public sealed class ApiResourceObjectDto
    {
        public int ApiResourceObjectId { get; set; }
        public string Name { get; set; } = string.Empty;
        public int ApiResourceId { get; set; }
    }

    public sealed class ResourceSelection
    {
        [Required]
        public string ApiResourceName { get; set; } = string.Empty;

        [Required]
        public string ResourceType { get; set; } = string.Empty;

        public int? ApiResourceObjectId { get; set; }
    }

    public sealed class NumericResourceSelection
    {
        [Range(1, int.MaxValue, ErrorMessage = "Choose an API resource.")]
        public int ApiResourceId { get; set; }
    }
}
