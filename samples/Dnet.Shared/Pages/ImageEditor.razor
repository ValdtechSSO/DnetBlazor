@page "/ImageEditor"
@using System.IO
@using Dnet.Blazor.Components.Button
@using Dnet.Blazor.Components.ImageEditor
@using Dnet.Blazor.Components.ImageEditor.Infrastructure.Constants
@using Dnet.Blazor.Components.ImageEditor.Infrastructure.Enums
@implements IDisposable
@inject IHttpClientFactory ClientFactory

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-image-editor" Title="@S["ImageEditor.ImageEditor"]" Category="@S["ImageEditor.ImagesAndContent"]"
          Description="@S["ImageEditor.FindTheFramingAdjustTheOrientationAndPrepare"]"
          Badge="@S["ImageEditor.Experimental"]">
    <DemoCard Id="image-editor-upload-card" Title="@S["ImageEditor.AGoodResultStartsWithYourImage"]" Eyebrow="@S["ImageEditor.01ChooseAndEdit"]"
              Description="@S["ImageEditor.OpenAnImageAndPreviewYourSelectionBefore"]">
        <ChildContent>
            <div class="image-workspace">
                <div class="image-upload-zone">
                    <span class="image-upload-symbol" aria-hidden="true">
                        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="24" height="22" rx="4" /><circle cx="11" cy="12" r="2.5" /><path d="m5 23 7-7 5 5 4-4 6 6" /></svg>
                    </span>
                    <h3>@S["ImageEditor.MakeRoomForANewImage"]</h3>
                    <p>@S["ImageEditor.ChooseAPhotoOrGraphicToGetStarted"]</p>
                    <label class="image-file-action" aria-disabled="@(_isLoading ? "true" : "false")">
                        <span>@S.Display(_isLoading ? "Preparando imagen…" : "Seleccionar imagen")</span>
                        <InputFile id="image-editor-file" class="image-file-input" OnChange="LoadFiles"
                                   accept="image/png,image/jpeg,.png,.jpg,.jpeg" disabled="@_isLoading"
                                   aria-label="@S["ImageEditor.SelectAPNGOrJPEGImage"]" aria-describedby="image-editor-file-help" />
                    </label>
                    <span id="image-editor-file-help" class="image-upload-hint">@S["ImageEditor.PNGOrJPEGUpTo15MBPer"]</span>
                    <div class="image-demo-action">
                        <DnetButton Variant="DnetButtonVariant.Outlined" id="image-editor-demo" OnClick="LoadDemoImage" disabled="@_isLoading">@S["ImageEditor.TryTheLogo"]</DnetButton>
                    </div>
                </div>
                <aside class="image-workflow" aria-labelledby="image-editor-guide-title">
                    <span class="image-tag">@S["ImageEditor.FromStartToFinish"]</span>
                    <h3 id="image-editor-guide-title">@S["ImageEditor.YourImageInThreeSteps"]</h3>
                    <ol class="image-steps">
                        <li><span class="image-step-number" aria-hidden="true">1</span><div><strong>@S["ImageEditor.ChooseTheFile"]</strong><p>@S["ImageEditor.WorkWithAnImageFromYourDeviceOr"]</p></div></li>
                        <li><span class="image-step-number" aria-hidden="true">2</span><div><strong>@S["ImageEditor.RefineTheFraming"]</strong><p>@S["ImageEditor.AdjustTheSelectionRotateOrFlipTheImage"]</p></div></li>
                        <li><span class="image-step-number" aria-hidden="true">3</span><div><strong>@S["ImageEditor.ApplyAndDownload"]</strong><p>@S["ImageEditor.ConfirmWithApplyYourResultWillAppearHere"]</p></div></li>
                    </ol>
                    <p class="image-local-note">@S["ImageEditor.EditingTakesPlaceInYourBrowser"]</p>
                </aside>
            </div>
        </ChildContent>
        <Footer>
            <p id="image-editor-status" class="demo-status" role="status">@S.Display(_status)</p>
            @if (!string.IsNullOrEmpty(_error))
            {
                <p id="image-editor-error" class="image-error" role="alert">@S.Display(_error)</p>
            }
        </Footer>
    </DemoCard>

    <div class="demo-grid">
        <DemoCard Id="image-editor-result-card" Title="@S["ImageEditor.YourImageReady"]" Eyebrow="@S["ImageEditor.02ReviewTheResult"]"
                  Description="@S["ImageEditor.YourLastConfirmedEditStaysHereWhileYou"]">
            <ChildContent>
                <div class="demo-stack">
                    @if (string.IsNullOrEmpty(_imageUrl))
                    {
                        <div id="image-editor-result-empty" class="image-result-empty">
                            <svg aria-hidden="true" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="24" height="22" rx="4" /><path d="m10 17 4 4 8-9" /></svg>
                            <strong>@S["ImageEditor.YourNextCropGoesHere"]</strong>
                            <p>@S["ImageEditor.ApplyChangesInTheEditorToPreviewAnd"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="image-result-preview">
                            <img id="image-editor-result-image" src="@_imageUrl" alt="@S.Format("Common.EditedImageOf0", _resultName)" />
                        </div>
                        <dl class="image-result-facts">
                            <div><dt>@S["ImageEditor.File"]</dt><dd id="image-editor-result-name">@_resultName</dd></div>
                            <div><dt>@S["ImageEditor.Format"]</dt><dd id="image-editor-result-format">@S.Display(_resultMime == ImageFormat.PNG ? "PNG" : "JPEG")</dd></div>
                            <div><dt>@S["ImageEditor.Size"]</dt><dd id="image-editor-result-size">@FormatSize(_resultBytes.Length)</dd></div>
                        </dl>
                        <div class="demo-actions">
                            <a id="image-editor-download" class="image-download" href="@_imageUrl" download="@_resultName">@S["ImageEditor.DownloadImage"] <span aria-hidden="true">↓</span></a>
                            <DnetButton Variant="DnetButtonVariant.Outlined" id="image-editor-reopen" OnClick="ReopenResult" disabled="@_isLoading">@S["ImageEditor.EditAgain"]</DnetButton>
                            <DnetButton Variant="DnetButtonVariant.Outlined" id="image-editor-clear" OnClick="ClearResult" disabled="@_isLoading">@S["ImageEditor.RemoveImage"]</DnetButton>
                        </div>
                    }
                </div>
            </ChildContent>
            <Footer><span class="demo-info">@S["ImageEditor.CancellingAnEditPreservesYourLastConfirmedResult"]</span></Footer>
        </DemoCard>

        <DemoCard Id="image-editor-tools-card" Title="@S["ImageEditor.SmallAdjustmentsADifferentView"]" Eyebrow="@S["ImageEditor.ExploreTheTools"]"
                  Description="@S["ImageEditor.EverythingYouNeedToPrepareTheFramingIn"]">
            <ChildContent>
                <div class="image-tool-list">
                    <div><span class="image-tool-symbol" aria-hidden="true">@CropIcon</span><div><h3>@S["ImageEditor.FindTheRightRatio"]</h3><p>@S["ImageEditor.ChooseAFreeSquare43Or16"]</p></div></div>
                    <div><span class="image-tool-symbol" aria-hidden="true">@RotateIcon</span><div><h3>@S["ImageEditor.ChangeOrientation"]</h3><p>@S["ImageEditor.RotateLeftOrRightAndFlipHorizontallyOr"]</p></div></div>
                    <div><span class="image-tool-symbol" aria-hidden="true">@ZoomIcon</span><div><h3>@S["ImageEditor.GetCloserToTheDetail"]</h3><p>@S["ImageEditor.UseZoomForPreciseAdjustmentsAndCheckThe"]</p></div></div>
                    <div><span class="image-tool-symbol" aria-hidden="true">@ResetIcon</span><div><h3>@S["ImageEditor.TryWithConfidence"]</h3><p>@S["ImageEditor.ResetRestoresTheImageYouOpenedCancelCloses"]</p></div></div>
                </div>
            </ChildContent>
            <Footer><span class="demo-info">@S["ImageEditor.UnchangedImagesKeepTheirOriginalBytesEditedResults"]</span></Footer>
        </DemoCard>
    </div>
</DemoPage>

<DnetImageEditor @ref="_imageEditor" MaxFileSizes="MaxFileSize"
                 ImageEditingControls="EditingControls" AllowedFormats="AllowedFormats"
                 OnImageSelected="OnImageSelected" OnCancel="OnCancel" />

@code {
#nullable enable
    private const long MaxFileSize = DnetImageEditor.DefaultMaxFileSize;
    private static readonly List<string> AllowedFormats = new() { ImageFormat.JPEG, ImageFormat.PNG };
    private static readonly List<ImageEditorControlType> EditingControls = new()
    {
        ImageEditorControlType.Crop, ImageEditorControlType.RotateCounterClockWise,
        ImageEditorControlType.RotateClockWise, ImageEditorControlType.FlipHorizontal, ImageEditorControlType.FlipVertical
    };

    private DnetImageEditor _imageEditor = default!;
    private MemoryStream? _pendingStream;
    private byte[] _resultBytes = Array.Empty<byte>();
    private string _imageUrl = string.Empty;
    private string _editingName = string.Empty;
    private string _resultName = string.Empty;
    private string _resultMime = string.Empty;
    private string _status = "Todo listo para elegir una imagen.";
    private string _error = string.Empty;
    private bool _isLoading;
    private bool _disposed;

    private async Task LoadFiles(InputFileChangeEventArgs args)
    {
        if (_isLoading || _disposed) return;
        _error = string.Empty;
        var file = args.File;
        if (file.Size > MaxFileSize)
        {
            ShowError("La imagen supera los 15 MB. Elige un archivo más pequeño.");
            return;
        }

        var extension = Path.GetExtension(file.Name);
        var allowedType = file.ContentType.Equals(ImageFormat.PNG, StringComparison.OrdinalIgnoreCase)
            || file.ContentType.Equals(ImageFormat.JPEG, StringComparison.OrdinalIgnoreCase);
        var allowedExtension = extension.Equals(".png", StringComparison.OrdinalIgnoreCase)
            || extension.Equals(".jpg", StringComparison.OrdinalIgnoreCase)
            || extension.Equals(".jpeg", StringComparison.OrdinalIgnoreCase);
        if (!allowedType && !(string.IsNullOrEmpty(file.ContentType) && allowedExtension))
        {
            ShowError("Ese formato no está admitido. Selecciona una imagen PNG o JPEG.");
            return;
        }

        _isLoading = true;
        _status = "Preparando tu imagen…";
        MemoryStream? memory = new();
        try
        {
            await using var source = file.OpenReadStream(MaxFileSize);
            await source.CopyToAsync(memory);
            var pending = memory;
            memory = null;
            await OpenEditor(pending, file.Name);
        }
        catch (Exception)
        {
            ShowError("No se ha podido abrir la imagen. Comprueba el archivo y vuelve a intentarlo.");
        }
        finally
        {
            memory?.Dispose();
            _isLoading = false;
        }
    }

    private async Task LoadDemoImage()
    {
        if (_isLoading || _disposed) return;
        _isLoading = true;
        _error = string.Empty;
        _status = "Preparando el ejemplo…";
        try
        {
            using var client = ClientFactory.CreateClient("WebHostURL");
            var bytes = await client.GetByteArrayAsync("_content/Dnet.App.Shared/img/blazor-logo.png");
            await OpenEditor(new MemoryStream(bytes), "blazor-logo.png");
        }
        catch (Exception)
        {
            ShowError("No se ha podido cargar el ejemplo. Puedes elegir una imagen de tu equipo.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReopenResult()
    {
        if (_isLoading || _disposed || _resultBytes.Length == 0) return;
        _isLoading = true;
        _error = string.Empty;
        try
        {
            await OpenEditor(new MemoryStream(_resultBytes, writable: false), _resultName);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenEditor(MemoryStream memory, string name)
    {
        if (_disposed)
        {
            memory.Dispose();
            return;
        }
        if (GetMimeType(memory) is null)
        {
            memory.Dispose();
            ShowError("El archivo no contiene una imagen PNG o JPEG válida.");
            return;
        }

        DisposePendingStream();
        _pendingStream = memory;
        _editingName = name;
        memory.Position = 0;
        try
        {
            await _imageEditor.ShowDialog(memory);
            _status = "Imagen abierta. Confirma con Apply para guardar el resultado.";
        }
        catch (Exception)
        {
            DisposePendingStream();
            ShowError("No se ha podido abrir el editor. Vuelve a seleccionar la imagen.");
        }
    }

    private void OnImageSelected(MemoryStream image)
    {
        try
        {
            if (_disposed) return;
            var bytes = image.ToArray();
            var mime = GetMimeType(bytes);
            if (mime is null)
            {
                ShowError("No se ha podido preparar el resultado. Prueba de nuevo con tu imagen.");
                return;
            }
            _resultBytes = bytes;
            _resultMime = mime;
            var stem = Path.GetFileNameWithoutExtension(_editingName);
            if (!stem.EndsWith("-editada", StringComparison.OrdinalIgnoreCase)) stem += "-editada";
            _resultName = $"{stem}.{(mime == ImageFormat.PNG ? "png" : "jpg")}";
            _imageUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
            _error = string.Empty;
            _status = "Imagen lista. Puedes descargarla o seguir editando.";
        }
        finally
        {
            if (ReferenceEquals(image, _pendingStream)) _pendingStream = null;
            image.Dispose();
            DisposePendingStream();
        }
    }

    private void OnCancel()
    {
        DisposePendingStream();
        _status = _resultBytes.Length > 0
            ? "Edición cancelada. Tu último resultado sigue disponible."
            : "Edición cancelada. Puedes elegir otra imagen cuando quieras.";
    }

    private void ClearResult()
    {
        _resultBytes = Array.Empty<byte>();
        _imageUrl = _resultName = _resultMime = _error = string.Empty;
        _status = "Resultado eliminado. Todo listo para empezar de nuevo.";
    }

    private void ShowError(string message)
    {
        if (_disposed) return;
        _error = message;
        _status = "Elige otra imagen para continuar.";
    }

    private void DisposePendingStream()
    {
        _pendingStream?.Dispose();
        _pendingStream = null;
    }

    public void Dispose()
    {
        _disposed = true;
        DisposePendingStream();
    }

    private string FormatSize(long bytes) => bytes < 1024 * 1024
        ? (bytes / 1024d).ToString("0.#", S.Culture) + " KB" : (bytes / (1024d * 1024d)).ToString("0.#", S.Culture) + " MB";

    private static string? GetMimeType(MemoryStream stream)
    {
        Span<byte> header = stackalloc byte[8];
        stream.Position = 0;
        var length = stream.Read(header);
        stream.Position = 0;
        return GetMimeType(header[..length]);
    }

    private static string? GetMimeType(ReadOnlySpan<byte> bytes)
    {
        if (bytes.Length >= 8 && bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4e && bytes[3] == 0x47
            && bytes[4] == 0x0d && bytes[5] == 0x0a && bytes[6] == 0x1a && bytes[7] == 0x0a) return ImageFormat.PNG;
        if (bytes.Length >= 3 && bytes[0] == 0xff && bytes[1] == 0xd8 && bytes[2] == 0xff) return ImageFormat.JPEG;
        return null;
    }

    private static RenderFragment CropIcon => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 3v14h14M3 7h14v14" /></svg>;
    private static RenderFragment RotateIcon => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 10a8 8 0 1 1 1 7M4 4v6h6" /></svg>;
    private static RenderFragment ZoomIcon => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10" cy="10" r="6" /><path d="m15 15 6 6M7 10h6M10 7v6" /></svg>;
    private static RenderFragment ResetIcon => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 10a8 8 0 1 1 1 7M4 4v6h6M12 7v5l3 2" /></svg>;
}
