@page "/TimePicker"

@using System.Globalization
@using Dnet.Blazor.Components.Form
@using Dnet.Blazor.Components.TimePicker

<DemoPage Id="demo-time-picker" Title="Time picker" Category="Date and time"
          Description="Type a time or choose from an accessible panel, with intervals and formats that fit your schedule."
          Badge="TimeOnly values">
    <div class="demo-grid">
        <DemoCard Id="time-picker-basic" Title="Schedule a meeting"
                  Description="Choose any time using the default 24-hour format. Clear the field to start again.">
            <ChildContent>
                <DnetFormField Label="Meeting time" UseClearButton="true">
                    <ChildContent>
                        <DnetTimePicker @bind-Value="_meetingTime" aria-label="Meeting time" Placeholder="HH:mm" />
                    </ChildContent>
                    <SufixContent>
                        <button class="dnet-timepicker-icon-wrapper" aria-label="Open time picker" type="button">
                            <span class="dnet-timepicker-icon" aria-hidden="true"></span>
                        </button>
                    </SufixContent>
                </DnetFormField>
            </ChildContent>
            <Footer><span class="demo-value" role="status">Meeting time: @FormatTime(_meetingTime)</span></Footer>
        </DemoCard>

        <DemoCard Title="Stay within business hours"
                  Description="Available times run from 08:00 to 18:00, in 15-minute intervals.">
            <ChildContent>
                <DnetFormField Label="Business hours · 15 minute steps" UseClearButton="true">
                    <ChildContent>
                        <DnetTimePicker @bind-Value="_businessTime" aria-label="Business time"
                                        Min="@(new TimeOnly(8, 0))" Max="@(new TimeOnly(18, 0))"
                                        Interval="@TimeSpan.FromMinutes(15)" />
                    </ChildContent>
                    <SufixContent>
                        <button class="dnet-timepicker-icon-wrapper" aria-label="Open time picker" type="button">
                            <span class="dnet-timepicker-icon" aria-hidden="true"></span>
                        </button>
                    </SufixContent>
                </DnetFormField>
            </ChildContent>
            <Footer><span class="demo-value" role="status">Appointment: @FormatTime(_businessTime)</span></Footer>
        </DemoCard>

        <DemoCard Title="Choose a departure" Description="Offer a short, curated list when only specific departure times are available.">
            <ChildContent>
                <DnetFormField Label="Suggested departures" UseClearButton="true">
                    <ChildContent>
                        <DnetTimePicker @bind-Value="_departureTime" aria-label="Departure time" TimeOptions="@_departureOptions" />
                    </ChildContent>
                    <SufixContent>
                        <button class="dnet-timepicker-icon-wrapper" aria-label="Open time picker" type="button">
                            <span class="dnet-timepicker-icon" aria-hidden="true"></span>
                        </button>
                    </SufixContent>
                </DnetFormField>
            </ChildContent>
            <Footer><span class="demo-value" role="status">Departure: @FormatTime(_departureTime)</span></Footer>
        </DemoCard>

        <DemoCard Title="Use a 12-hour clock" Description="Display AM or PM while keeping the selected value as a TimeOnly.">
            <ChildContent>
                <DnetFormField Label="12-hour format" UseClearButton="true">
                    <ChildContent>
                        <DnetTimePicker @bind-Value="_lunchTime" aria-label="Lunch time"
                                        Format="h:mm tt" Formats="@_twelveHourFormats"
                                        Interval="@TimeSpan.FromMinutes(30)" />
                    </ChildContent>
                    <SufixContent>
                        <button class="dnet-timepicker-icon-wrapper" aria-label="Open time picker" type="button">
                            <span class="dnet-timepicker-icon" aria-hidden="true"></span>
                        </button>
                    </SufixContent>
                </DnetFormField>
            </ChildContent>
            <Footer><span class="demo-value" role="status">Lunch: @FormatTime(_lunchTime, "h:mm tt")</span></Footer>
        </DemoCard>

        <DemoCard Title="A fixed reservation" Description="A disabled field can show an existing time that is currently unavailable for editing.">
            <ChildContent>
                <DnetFormField Label="Unavailable">
                    <ChildContent>
                        <DnetTimePicker @bind-Value="_unavailableTime" aria-label="Unavailable time" Disabled="true" />
                    </ChildContent>
                    <SufixContent>
                        <button class="dnet-timepicker-icon-wrapper" aria-label="Open time picker" type="button" disabled>
                            <span class="dnet-timepicker-icon" aria-hidden="true"></span>
                        </button>
                    </SufixContent>
                </DnetFormField>
            </ChildContent>
            <Footer><span class="demo-value">Reserved for @FormatTime(_unavailableTime)</span></Footer>
        </DemoCard>

        <DemoCard Title="Typing and keyboard support" Description="The same control supports direct entry and choosing from the panel.">
            <ul class="demo-bullets">
                <li>Type a time in the format shown by the field.</li>
                <li>Open the clock panel to browse the available options.</li>
                <li>Use the arrow keys to move, Enter to choose and Escape to close.</li>
                <li>Use the clear action to remove an optional time.</li>
            </ul>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private TimeOnly? _meetingTime = new(10, 30);
    private TimeOnly? _businessTime = new(9, 15);
    private TimeOnly? _departureTime = new(14, 20);
    private TimeOnly? _lunchTime = new(13, 0);
    private TimeOnly? _unavailableTime = new(17, 30);

    private readonly TimeOnly[] _departureOptions =
    [
        new(8, 10),
        new(10, 40),
        new(14, 20),
        new(18, 50)
    ];

    private readonly string[] _twelveHourFormats = ["h:mm tt", "hh:mm tt"];

    private static string FormatTime(TimeOnly? value, string format = "HH:mm") =>
        value?.ToString(format, CultureInfo.InvariantCulture) ?? "No time selected";
}
