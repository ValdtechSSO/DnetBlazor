@page "/TimePicker"

@using System.Globalization
@using Dnet.Blazor.Components.Form
@using Dnet.Blazor.Components.TimePicker

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-time-picker" Title="@S["TimePicker.TimePicker"]" Category="@S["DatePicker.DateAndTime"]"
          Description="@S["TimePicker.TypeATimeOrChooseFromAnAccessible"]"
          Badge="@S["TimePicker.TimeOnlyValues"]">
    <div class="demo-grid">
        <DemoCard Id="time-picker-basic" Title="@S["TimePicker.ScheduleAMeeting"]"
                  Description="@S["TimePicker.ChooseAnyTimeUsingTheDefault24Hour"]">
            <ChildContent>
                <DnetFormField Label="@S["TimePicker.MeetingTime"]" UseClearButton="true">
                    <ChildContent>
                        <DnetTimePicker @bind-Value="_meetingTime" aria-label="@S["TimePicker.MeetingTime"]" Placeholder="@S["TimePicker.HHMm"]" />
                    </ChildContent>
                    <SufixContent>
                        <button class="dnet-timepicker-icon-wrapper" aria-label="@S["TimePicker.OpenTimePicker"]" type="button">
                            <span class="dnet-timepicker-icon" aria-hidden="true"></span>
                        </button>
                    </SufixContent>
                </DnetFormField>
            </ChildContent>
            <Footer><span class="demo-value" role="status">@S.Format("Common.MeetingTime0", FormatTime(_meetingTime))</span></Footer>
        </DemoCard>

        <DemoCard Title="@S["TimePicker.StayWithinBusinessHours"]"
                  Description="@S["TimePicker.AvailableTimesRunFrom0800To18"]">
            <ChildContent>
                <DnetFormField Label="@S["TimePicker.BusinessHours15MinuteSteps"]" UseClearButton="true">
                    <ChildContent>
                        <DnetTimePicker @bind-Value="_businessTime" aria-label="@S["TimePicker.BusinessTime"]"
                                        Min="@(new TimeOnly(8, 0))" Max="@(new TimeOnly(18, 0))"
                                        Interval="@TimeSpan.FromMinutes(15)" />
                    </ChildContent>
                    <SufixContent>
                        <button class="dnet-timepicker-icon-wrapper" aria-label="@S["TimePicker.OpenTimePicker"]" type="button">
                            <span class="dnet-timepicker-icon" aria-hidden="true"></span>
                        </button>
                    </SufixContent>
                </DnetFormField>
            </ChildContent>
            <Footer><span class="demo-value" role="status">@S.Format("Common.Appointment0", FormatTime(_businessTime))</span></Footer>
        </DemoCard>

        <DemoCard Title="@S["TimePicker.ChooseADeparture"]" Description="@S["TimePicker.OfferAShortCuratedListWhenOnlySpecific"]">
            <ChildContent>
                <DnetFormField Label="@S["TimePicker.SuggestedDepartures"]" UseClearButton="true">
                    <ChildContent>
                        <DnetTimePicker @bind-Value="_departureTime" aria-label="@S["TimePicker.DepartureTime"]" TimeOptions="@_departureOptions" />
                    </ChildContent>
                    <SufixContent>
                        <button class="dnet-timepicker-icon-wrapper" aria-label="@S["TimePicker.OpenTimePicker"]" type="button">
                            <span class="dnet-timepicker-icon" aria-hidden="true"></span>
                        </button>
                    </SufixContent>
                </DnetFormField>
            </ChildContent>
            <Footer><span class="demo-value" role="status">@S.Format("Common.Departure0", FormatTime(_departureTime))</span></Footer>
        </DemoCard>

        <DemoCard Title="@S["TimePicker.UseA12HourClock"]" Description="@S["TimePicker.DisplayAMOrPMWhileKeepingTheSelected"]">
            <ChildContent>
                <DnetFormField Label="@S["TimePicker.12HourFormat"]" UseClearButton="true">
                    <ChildContent>
                        <DnetTimePicker @bind-Value="_lunchTime" aria-label="@S["TimePicker.LunchTime"]"
                                        Format="h:mm tt" Formats="@_twelveHourFormats"
                                        Interval="@TimeSpan.FromMinutes(30)" />
                    </ChildContent>
                    <SufixContent>
                        <button class="dnet-timepicker-icon-wrapper" aria-label="@S["TimePicker.OpenTimePicker"]" type="button">
                            <span class="dnet-timepicker-icon" aria-hidden="true"></span>
                        </button>
                    </SufixContent>
                </DnetFormField>
            </ChildContent>
            <Footer><span class="demo-value" role="status">@S.Format("Common.Lunch0", FormatTime(_lunchTime, "h:mm tt"))</span></Footer>
        </DemoCard>

        <DemoCard Title="@S["TimePicker.AFixedReservation"]" Description="@S["TimePicker.ADisabledFieldCanShowAnExistingTime"]">
            <ChildContent>
                <DnetFormField Label="@S["TimePicker.Unavailable"]">
                    <ChildContent>
                        <DnetTimePicker @bind-Value="_unavailableTime" aria-label="@S["TimePicker.UnavailableTime"]" Disabled="true" />
                    </ChildContent>
                    <SufixContent>
                        <button class="dnet-timepicker-icon-wrapper" aria-label="@S["TimePicker.OpenTimePicker"]" type="button" disabled>
                            <span class="dnet-timepicker-icon" aria-hidden="true"></span>
                        </button>
                    </SufixContent>
                </DnetFormField>
            </ChildContent>
            <Footer><span class="demo-value">@S.Format("Common.ReservedFor0", FormatTime(_unavailableTime))</span></Footer>
        </DemoCard>

        <DemoCard Title="@S["TimePicker.TypingAndKeyboardSupport"]" Description="@S["TimePicker.TheSameControlSupportsDirectEntryAndChoosing"]">
            <ul class="demo-bullets">
                <li>@S["TimePicker.TypeATimeInTheFormatShownBy"]</li>
                <li>@S["TimePicker.OpenTheClockPanelToBrowseTheAvailable"]</li>
                <li>@S["TimePicker.UseTheArrowKeysToMoveEnterTo"]</li>
                <li>@S["TimePicker.UseTheClearActionToRemoveAnOptional"]</li>
            </ul>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private TimeOnly? _meetingTime = new(10, 30);
    private TimeOnly? _businessTime = new(9, 15);
    private TimeOnly? _departureTime = new(14, 20);
    private TimeOnly? _lunchTime = new(13, 0);
    private TimeOnly? _unavailableTime = new(17, 30);

    private readonly TimeOnly[] _departureOptions =
    [
        new(8, 10),
        new(10, 40),
        new(14, 20),
        new(18, 50)
    ];

    private readonly string[] _twelveHourFormats = ["h:mm tt", "hh:mm tt"];

    private string FormatTime(TimeOnly? value, string format = "HH:mm") =>
        value?.ToString(format, S.Culture) ?? S.Text("No time selected");
}
