@page "/SlideToggle"

@using Dnet.Blazor.Components.SlideToggle

<div class="container-fluid" style="padding-top: 10px;">
    <div class="d-flex dnet-m-l-30 dnet-m-t-20">
        <span class="dnet-m-r-10 dnet-app-comp-name">Slide Toggle</span>
    </div>

    <div class="dnet-m-l-30 dnet-m-t-30" style="max-width: 420px;">
        <div class="dnet-m-b-30">
            <DnetSlideToggle @bind-Value="_notifications">Notifications</DnetSlideToggle>
        </div>
        <div class="dnet-m-b-30">
            <DnetSlideToggle @bind-Value="_automaticUpdates" TextPlacedBefore="true">Automatic updates</DnetSlideToggle>
        </div>
        <div class="dnet-m-b-30">
            <DnetSlideToggle @bind-Value="_fullWidth" FullWidth="true">Full-width setting</DnetSlideToggle>
        </div>
        <div class="dnet-m-b-30">
            <DnetSlideToggle @bind-Value="_disabled" Disabled="true">Unavailable setting</DnetSlideToggle>
        </div>
    </div>
</div>

@code {
    private bool _notifications;
    private bool _automaticUpdates = true;
    private bool _fullWidth;
    private bool _disabled = true;
}
