@page "/SlideToggle"

@using Dnet.Blazor.Components.SlideToggle

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-slide-toggle" Title="@S["SlideToggle.SlideToggle"]" Category="@S["SlideToggle.SelectionControls"]"
          Description="@S["SlideToggle.TurnASettingOnOrOffWithA"]"
          Badge="@S["SlideToggle.InstantSettings"]">
    <div class="demo-grid">
        <DemoCard Id="toggle-preferences" Title="@S["SlideToggle.WorkspacePreferences"]"
                  Description="@S["SlideToggle.TheseSettingsTakeEffectAsSoonAsYou"]">
            <ChildContent>
                <div class="demo-stack">
                    <div>
                        <div class="demo-option-row">
                            <DnetSlideToggle @bind-Value="_notifications">@S["SlideToggle.Notifications"]</DnetSlideToggle>
                        </div>
                        <p class="demo-info">@S["SlideToggle.ReceiveANotificationWhenSomeoneMentionsYou"]</p>
                    </div>
                    <div>
                        <div class="demo-option-row">
                            <DnetSlideToggle @bind-Value="_automaticUpdates" TextPlacedBefore="true">@S["SlideToggle.AutomaticUpdates"]</DnetSlideToggle>
                        </div>
                        <p class="demo-info">@S["SlideToggle.KeepYourWorkspaceUpToDateAutomatically"]</p>
                    </div>
                </div>
            </ChildContent>
            <Footer>
                <span class="demo-value" role="status">@S.Format("Common.Notifications0AutomaticUpdates1", State(_notifications), State(_automaticUpdates))</span>
            </Footer>
        </DemoCard>

        <DemoCard Title="@S["SlideToggle.SettingsRow"]" Description="@S["SlideToggle.AFullWidthSwitchKeepsTheSettingName"]">
            <ChildContent>
                <div class="demo-stack">
                    <div>
                        <div class="demo-option-row">
                            <DnetSlideToggle @bind-Value="_fullWidth" FullWidth="true">@S["SlideToggle.CompactWorkspace"]</DnetSlideToggle>
                        </div>
                        <p class="demo-info">@S["SlideToggle.UseADenserLayoutForYourWorkspace"]</p>
                    </div>
                    <div>
                        <div class="demo-option-row">
                            <DnetSlideToggle @bind-Value="_disabled" Disabled="true">@S["SlideToggle.AccountProtection"]</DnetSlideToggle>
                        </div>
                        <p class="demo-info">@S["SlideToggle.ManagedByYourOrganizationAndAlwaysEnabled"]</p>
                    </div>
                </div>
            </ChildContent>
            <Footer>
                <span class="demo-value" role="status">@S.Format("Common.CompactWorkspace0AccountProtectionOn", State(_fullWidth))</span>
            </Footer>
        </DemoCard>

        <DemoCard Title="@S["SlideToggle.ClearImmediateFeedback"]" Description="@S["SlideToggle.UseASwitchForAnIndependentSettingThat"]">
            <ul class="demo-bullets">
                <li>@S["SlideToggle.ClickTheLabelOrPressSpaceWhileThe"]</li>
                <li>@S["SlideToggle.DescribeTheSettingItselfSoTheLabelWorks"]</li>
                <li>@S["SlideToggle.ExplainWhyASettingIsDisabledBesideThe"]</li>
            </ul>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private bool _notifications;
    private bool _automaticUpdates = true;
    private bool _fullWidth;
    private bool _disabled = true;

    private string State(bool value) => S.Text(value ? "on" : "off");
}
