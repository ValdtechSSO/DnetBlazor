@page "/Stepper"
@using Dnet.Blazor.Components.Stepper
@using Dnet.Blazor.Components.Checkbox
@using Dnet.Blazor.Components.Button

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-stepper" Title="@S["Stepper.Stepper"]" Category="@S["Stepper.Navigation"]"
          Description="@S["Stepper.TurnALongerTaskIntoFocusedStagesWith"]" Badge="@S["Stepper.TwoOrientations"]">
    <div class="demo-stack">
    <DemoCard Id="stepper-horizontal-card" Title="@S["Stepper.PlanAProject"]" Eyebrow="@S["Stepper.HorizontalFreeNavigation"]"
              Description="@S["Stepper.MoveBetweenStagesToReviewAProjectBrief"]">
        <ChildContent>
            <div class="stepper-scroll" tabindex="0" aria-label="@S["Stepper.ProjectWorkflowScrollHorizontallyOnSmallerScreens"]">
                <div class="stepper-horizontal-stage">
                    <DnetStepper @ref="_horizontalStepper" id="stepper-horizontal" OnSelectionChange="HorizontalChanged"
                                 Orientation="(int)StepperOrientation.Horizontal">
                        @foreach (var stage in _stages)
                        {
                            <DnetStep Label="@S.Text(stage.Title)">
                                <div class="stepper-content">
                                    <p class="stepper-kicker">@S.Format("Common.ProjectBrief0", S.Text(stage.Title))</p>
                                    <h3>@S.Display(stage.Heading)</h3>
                                    <p class="demo-muted">@S.Display(stage.Description)</p>
                                    <div class="stepper-detail"><span class="demo-info">@S["Chips.WebsiteLaunch"]</span><strong>@S.Display(stage.Detail)</strong></div>
                                </div>
                            </DnetStep>
                        }
                    </DnetStepper>
                </div>
            </div>
            <div class="demo-actions">
                <DnetButton Variant="DnetButtonVariant.Outlined" id="stepper-horizontal-back" disabled="@(_horizontalStep == 1)" OnClick="() => MoveHorizontal(-1)">@S["Stepper.PreviousStage"]</DnetButton>
                <DnetButton Variant="DnetButtonVariant.Outlined" id="stepper-horizontal-next" disabled="@(_horizontalStep == _stages.Length)" OnClick="() => MoveHorizontal(1)">@S["Stepper.NextStage"]</DnetButton>
            </div>
        </ChildContent>
        <Footer><span id="stepper-horizontal-value" role="status">@S.Format("Common.Stage0Of12", _horizontalStep, _stages.Length, S.Text(_stages[_horizontalStep - 1].Title))</span></Footer>
    </DemoCard>

    <div class="demo-grid">
        <DemoCard Id="stepper-linear-card" Title="@S["Stepper.LaunchChecklist"]" Eyebrow="@S["Stepper.VerticalLinearNavigation"]"
                  Description="@S["Stepper.CompleteTheCurrentStageBeforeMovingForwardEarlier"]">
            <ChildContent>
                <DnetStepper @ref="_linearStepper" id="stepper-linear" OnSelectionChange="LinearChanged"
                             Orientation="(int)StepperOrientation.Vertical" Linear="true">
                    @foreach (var stage in _stages)
                    {
                        <DnetStep Completed="stage.Completed">
                            <StepHeaderTemplate>
                                <div class="dnet-step-icon dnet-step-icon-state-number"><span>@S.Display(stage.Index + 1)</span></div>
                                <span class="stepper-custom-label">@S.Display(stage.Title)</span>
                            </StepHeaderTemplate>
                            <ChildContent>
                                <div class="stepper-linear-content">
                                    <p class="demo-muted">@S.Display(stage.Checklist)</p>
                                    <DnetInputCheckbox id="@($"stepper-complete-{stage.Index + 1}")" @bind-Value="stage.Completed">@S["Stepper.MarkThisStageComplete"]</DnetInputCheckbox>
                                </div>
                            </ChildContent>
                        </DnetStep>
                    }
                </DnetStepper>
                <div class="stepper-linear-actions">
                    <DnetButton Variant="DnetButtonVariant.Outlined" id="stepper-linear-back" disabled="@(_linearStep == 1)" OnClick="() => MoveLinear(-1)">@S["Stepper.Back"]</DnetButton>
                    <DnetButton id="stepper-linear-next" disabled="@(_linearStep == _stages.Length || !_stages[_linearStep - 1].Completed)" OnClick="() => MoveLinear(1)">@S["Stepper.Continue"]</DnetButton>
                </div>
            </ChildContent>
            <Footer><span id="stepper-linear-value" role="status">@S.Format("Common.0Of1StagesCompleteCurrent2", _stages.Count(stage => stage.Completed), _stages.Length, S.Text(_stages[_linearStep - 1].Title))</span></Footer>
        </DemoCard>
        <DemoCard Id="stepper-guide" Title="@S["Stepper.AClearPathToLaunch"]" Description="@S["Stepper.AWorkflowCanSupportExplorationAndStillMake"]">
            <ol class="demo-bullets">
                <li><strong>@S["Stepper.Details"]</strong> @S["Stepper.AgreeOnTheOutcomeAndProjectScope"]</li>
                <li><strong>@S["Stepper.Team"]</strong> @S["Stepper.ConfirmOwnershipAndCollaborators"]</li>
                <li><strong>@S["Stepper.Review"]</strong> @S["Stepper.CheckTheBriefAndGatherApproval"]</li>
                <li><strong>@S["Stepper.Launch"]</strong> @S["Stepper.ShareThePlanAndBeginDelivery"]</li>
            </ol>
            <div class="demo-preview"><span class="demo-info">@S["Stepper.TryTheLinearExample"]</span><p class="demo-muted">@S["Stepper.CompleteDetailsToEnableContinueThenReturnTo"]</p></div>
        </DemoCard>
    </div>
    </div>
</DemoPage>

@code {
    private DnetStepper? _horizontalStepper;
    private DnetStepper? _linearStepper;
    private int _horizontalStep = 1;
    private int _linearStep = 1;
    private readonly ProjectStage[] _stages =
    [
        new(0, "Details", "Start with a shared goal", "Create a focused brief before the team starts delivery.", "Refresh the customer experience", "Confirm the project goal, scope and success measures."),
        new(1, "Team", "Bring the right people together", "Give every part of the project a clear owner.", "Design, engineering and product", "Confirm an owner and invite the people responsible for delivery."),
        new(2, "Review", "Make the final checks", "Review the plan together and resolve any open questions.", "Ready for stakeholder review", "Review the brief, timeline and responsibilities with the team."),
        new(3, "Launch", "Share the plan", "The team has the context it needs to begin the next phase.", "Kickoff scheduled for Monday", "Share the approved plan and confirm the kickoff date.")
    ];

    private void HorizontalChanged(Tuple<int, int> change) => _horizontalStep = change.Item1;
    private void LinearChanged(Tuple<int, int> change) => _linearStep = change.Item1;
    private void MoveHorizontal(int direction) => _horizontalStepper?.GoToStep(_horizontalStep + direction);
    private void MoveLinear(int direction) => _linearStepper?.GoToStep(_linearStep + direction);

    private sealed record ProjectStage(int Index, string Title, string Heading, string Description, string Detail, string Checklist)
    {
        public bool Completed { get; set; }
    }
}
