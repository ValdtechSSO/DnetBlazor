@page "/Toast"
@using Dnet.Blazor.Components.Button
@using Dnet.Blazor.Components.Form
@using Dnet.Blazor.Components.Select
@using Dnet.Blazor.Components.Toast.Infrastructure.Enums
@using Dnet.Blazor.Components.Toast.Infrastructure.Interfaces
@using Dnet.Blazor.Components.Toast.Infrastructure.Models
@inject IToastService ToastService
@implements IDisposable

<DemoPage Id="demo-toast" Title="Toast" Category="Components / Feedback" Description="Keep people informed with timely messages and a useful next action, while their work stays in view." Badge="Four message types">
    <div class="demo-grid">
        <DemoCard Id="toast-basic" Title="The right message for the moment" Eyebrow="01 / Notification" Description="Choose a tone and open a notification. Its action reports a result back to this example.">
            <ChildContent>
                <div class="demo-stack">
                    <div class="toast-message-preview demo-preview"><span class="toast-preview-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Z" /><path d="M10 21h4" /></svg></span><div><strong>@Message.Title</strong><p>@Message.Text</p></div></div>
                    <EditForm Model="_settings"><DnetFormField Label="Toast type"><ChildContent><DnetSelect TValue="string" TItem="string" @bind-Value="_settings.Type" Items="_types" DisplayValueConverter="type => type" ValueConverter="type => type" ResponsiveLabel="Toast type" /></ChildContent></DnetFormField></EditForm>
                    <div class="demo-actions"><DnetButton id="toast-show" OnClick="ShowToast">Show Toast</DnetButton></div>
                    <p class="demo-muted">The message stays visible for eight seconds. Hover over it to give yourself more time.</p>
                </div>
            </ChildContent>
            <Footer><p id="toast-action-result" class="toast-status" role="status">@_status</p></Footer>
        </DemoCard>
        <DemoCard Id="toast-stack" Title="A calm place for busy moments" Eyebrow="02 / Stacking & queue" Description="Send five notifications together. Four appear first, with the fifth waiting for space.">
            <ChildContent>
                <div class="demo-stack">
                    <div class="toast-stack-preview demo-preview" aria-hidden="true"><div><span class="toast-tone is-success"></span><strong>Report ready</strong><small>Success</small></div><div><span class="toast-tone is-info"></span><strong>New activity</strong><small>Information</small></div><div><span class="toast-tone is-warning"></span><strong>Review needed</strong><small>Warning</small></div><div><span class="toast-tone is-danger"></span><strong>Upload failed</strong><small>Danger</small></div><p>+1 notification in the queue</p></div>
                    <div class="demo-actions"><DnetButton id="toast-show-stack" OnClick="ShowToastStack">Show toast stack</DnetButton></div>
                    <p class="demo-muted">Dismiss any message to reveal the next one. The stack stays together at the bottom right.</p>
                </div>
            </ChildContent>
            <Footer><span id="toast-stack-result" role="status">@_stackStatus</span></Footer>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private readonly Settings _settings = new();
    private readonly List<string> _types = ["Information", "Success", "Warning", "Danger"];
    private string _status = "No notification actions yet";
    private string _stackStatus = "Ready to send a batch";
    private bool _disposed;
    private ToastType SelectedType => Enum.Parse<ToastType>(_settings.Type);
    private (string Title, string Text, string Action) Message => SelectedType switch
    {
        ToastType.Success => ("Settings saved", "Your workspace preferences are up to date.", "Undo"),
        ToastType.Warning => ("Storage is almost full", "Review your files to keep space for your next project.", "Review files"),
        ToastType.Danger => ("Upload interrupted", "Your connection changed. The original file is still safe.", "Try again"),
        _ => ("Your report is ready", "The latest activity report is ready to review.", "View report")
    };

    private void ShowToast()
    {
        var message = Message;
        _status = $"{_settings.Type} notification opened · choose {message.Action}";
        ToastService.Show(new ToastConfig
        {
            Title = message.Title, Text = message.Text, ToastType = SelectedType,
            ToastPostion = ToastPostion.BottomRight, Duration = 8000,
            Actions = [new ToastAction { Label = message.Action, OnClick = () => RecordActionAsync(message.Action) }, new ToastAction { Label = "Dismiss", Quiet = true, OnClick = () => RecordActionAsync("Dismissed") }]
        });
    }

    private Task RecordActionAsync(string action)
    {
        if (_disposed) return Task.CompletedTask;
        return InvokeAsync(() => { _status = $"Action completed: {action}"; StateHasChanged(); });
    }

    private void ShowToastStack()
    {
        foreach (var type in new[] { ToastType.Success, ToastType.Information, ToastType.Warning, ToastType.Danger })
            ToastService.Show(new ToastConfig { Title = $"{type} notification", Text = "One place for every update, without covering your work.", ToastType = type, ToastPostion = ToastPostion.BottomRight, Duration = 12000, MaxVisible = 4 });
        ToastService.Show(new ToastConfig { Title = "The next update", Text = "This notification waited until there was room in the stack.", ToastType = ToastType.Information, ToastPostion = ToastPostion.BottomRight, Duration = 12000, MaxVisible = 4 });
        _stackStatus = "Batch sent · four visible notifications and one queued";
    }

    public void Dispose() => _disposed = true;
    private sealed class Settings { public string Type { get; set; } = "Information"; }
}
