@page "/Checkbox"

@using Dnet.Blazor.Components.Checkbox

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-checkbox" Title="@S["CheckBox.Checkbox"]" Category="@S["SlideToggle.SelectionControls"]"
          Description="@S["CheckBox.LetPeopleChooseSeveralIndependentOptionsWithA"]"
          Badge="@S["Chips.MultipleChoices"]">
    <div class="demo-grid">
        <DemoCard Id="checkbox-preferences" Title="@S["CheckBox.CommunicationPreferences"]"
                  Description="@S["CheckBox.ChooseTheUpdatesYouWouldLikeToReceive"]">
            <ChildContent>
                <fieldset class="checkbox-options">
                    <legend>@S["CheckBox.KeepInTouch"]</legend>
                    <div class="demo-option-row">
                        <DnetInputCheckbox @bind-Value="_productUpdates">@S["CheckBox.ProductUpdates"]</DnetInputCheckbox>
                    </div>
                    <p class="demo-info">@S["CheckBox.NewFeaturesAndImprovementsDeliveredOccasionally"]</p>
                    <div class="demo-option-row">
                        <DnetInputCheckbox @bind-Value="_researchInvitations">@S["CheckBox.ResearchInvitations"]</DnetInputCheckbox>
                    </div>
                    <p class="demo-info">@S["CheckBox.HelpShapeTheNextReleaseBySharingYour"]</p>
                    <div class="demo-option-row">
                        <DnetInputCheckbox @bind-Value="_securityAlerts" Disabled="true" TextPlacedBefore="true">@S["CheckBox.SecurityAlerts"]</DnetInputCheckbox>
                    </div>
                    <p class="demo-info">@S["CheckBox.RequiredAccountNoticesAreAlwaysEnabled"]</p>
                </fieldset>
            </ChildContent>
            <Footer>
                <span class="demo-value" role="status">@S.Format("Common.0Of3PreferencesEnabled", SelectedCount)</span>
            </Footer>
        </DemoCard>

        <DemoCard Title="@S["CheckBox.YourPreferences"]" Description="@S["CheckBox.IndependentChoicesCanBeCombinedSelectingOneDoes"]">
            <div class="demo-stack">
                <div class="demo-preview">
                    <span class="demo-info">@S["CheckBox.OptionalCommunications"]</span>
                    <p class="demo-value">@S.Display(OptionalPreferences)</p>
                    <span class="demo-muted">@S["CheckBox.SecurityAlertsRemainEnabledForYourAccount"]</span>
                </div>
                <ul class="demo-bullets">
                    <li>@S["CheckBox.ClickALabelOrUseSpaceToChange"]</li>
                    <li>@S["CheckBox.DisabledOptionsExplainASettingThatCannotBe"]</li>
                    <li>@S["CheckBox.UseCheckboxesWhenMoreThanOneAnswerCan"]</li>
                </ul>
            </div>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private bool _productUpdates = true;
    private bool _researchInvitations;
    private bool _securityAlerts = true;

    private int SelectedCount => (_productUpdates ? 1 : 0) + (_researchInvitations ? 1 : 0) + 1;

    private string OptionalPreferences => (_productUpdates, _researchInvitations) switch
    {
        (true, true) => "Product updates and research invitations",
        (true, false) => "Product updates",
        (false, true) => "Research invitations",
        _ => "No optional communications"
    };
}
