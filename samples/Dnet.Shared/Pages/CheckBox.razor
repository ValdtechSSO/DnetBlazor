@page "/Checkbox"

@using Dnet.Blazor.Components.Checkbox

<DemoPage Id="demo-checkbox" Title="Checkbox" Category="Selection controls"
          Description="Let people choose several independent options, with a clear label for every choice."
          Badge="Multiple choices">
    <div class="demo-grid">
        <DemoCard Id="checkbox-preferences" Title="Communication preferences"
                  Description="Choose the updates you would like to receive. Your selection is reflected immediately.">
            <ChildContent>
                <fieldset class="checkbox-options">
                    <legend>Keep in touch</legend>
                    <div class="demo-option-row">
                        <DnetInputCheckbox @bind-Value="_productUpdates">Product updates</DnetInputCheckbox>
                    </div>
                    <p class="demo-info">New features and improvements, delivered occasionally.</p>
                    <div class="demo-option-row">
                        <DnetInputCheckbox @bind-Value="_researchInvitations">Research invitations</DnetInputCheckbox>
                    </div>
                    <p class="demo-info">Help shape the next release by sharing your feedback.</p>
                    <div class="demo-option-row">
                        <DnetInputCheckbox @bind-Value="_securityAlerts" Disabled="true" TextPlacedBefore="true">Security alerts</DnetInputCheckbox>
                    </div>
                    <p class="demo-info">Required account notices are always enabled.</p>
                </fieldset>
            </ChildContent>
            <Footer>
                <span class="demo-value" role="status">@SelectedCount of 3 preferences enabled</span>
            </Footer>
        </DemoCard>

        <DemoCard Title="Your preferences" Description="Independent choices can be combined; selecting one does not clear another.">
            <div class="demo-stack">
                <div class="demo-preview">
                    <span class="demo-info">Optional communications</span>
                    <p class="demo-value">@OptionalPreferences</p>
                    <span class="demo-muted">Security alerts remain enabled for your account.</span>
                </div>
                <ul class="demo-bullets">
                    <li>Click a label or use Space to change a focused checkbox.</li>
                    <li>Disabled options explain a setting that cannot be changed.</li>
                    <li>Use checkboxes when more than one answer can apply.</li>
                </ul>
            </div>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private bool _productUpdates = true;
    private bool _researchInvitations;
    private bool _securityAlerts = true;

    private int SelectedCount => (_productUpdates ? 1 : 0) + (_researchInvitations ? 1 : 0) + 1;

    private string OptionalPreferences => (_productUpdates, _researchInvitations) switch
    {
        (true, true) => "Product updates and research invitations",
        (true, false) => "Product updates",
        (false, true) => "Research invitations",
        _ => "No optional communications"
    };
}
