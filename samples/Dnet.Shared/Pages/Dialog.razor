@page "/Dialog"
@using Dnet.App.Shared.Pages.ShowcaseContent
@using Dnet.Blazor.Components.Button
@using Dnet.Blazor.Components.Dialog.Infrastructure.Interfaces
@using Dnet.Blazor.Components.Dialog.Infrastructure.Models
@using Dnet.Blazor.Components.Overlay.Infrastructure.Enums
@using Dnet.Blazor.Components.Overlay.Infrastructure.Models
@using Dnet.Blazor.Components.Overlay.Infrastructure.Services
@inject IDialogService DialogService
@implements IDisposable

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-dialog" Title="@S["Dialog.Dialog"]" Category="@S["Toast.ComponentsFeedback"]" Description="@S["Dialog.BringAFocusedTaskToTheForegroundThen"]" Badge="@S["Dialog.ModalOverlay"]">
    <div class="demo-grid">
        <DemoCard Id="dialog-basic" Title="@S["Dialog.AMomentToFocus"]" Eyebrow="@S["Dialog.01ProfileEditor"]" Description="@S["Dialog.OpenAProfileEditorMakeAChangeAnd"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="dialog-profile demo-preview">
                        <span class="dialog-avatar" aria-hidden="true">@S["Dialog.TM"]</span>
                        <div><strong>@S["Dialog.TaylorMorgan"]</strong><span>@S["Dialog.ProductDesigner"]</span><small>taylor.morgan@example.com</small></div>
                    </div>
                    <label class="demo-option-row dialog-option"><input id="dialog-require-action" type="checkbox" @bind="_requireAction" /><span><strong>@S["Dialog.RequireAnExplicitAction"]</strong><small>@S["Dialog.KeepTheDialogOpenWhenTheBackdropIs"]</small></span></label>
                    <div class="demo-actions"><DnetButton id="dialog-open" OnClick="ShowDialog">@S["Dialog.ShowDialog"]</DnetButton></div>
                </div>
            </ChildContent>
            <Footer><div id="dialog-result" class="demo-value" role="status"><span class="demo-muted">@S["Dialog.LatestResult"]</span><strong>@S.Display(_result)</strong></div></Footer>
        </DemoCard>
        <DemoCard Id="dialog-guide" Title="@S["Dialog.ACompleteConversation"]" Eyebrow="@S["ConnectedPanel.02Interaction"]" Description="@S["Dialog.UseADialogForAShortTaskThat"]">
            <div class="demo-stack">
                <div class="demo-info"><strong>@S["Dialog.Open"]</strong><p>@S["Dialog.TheEditorReceivesItsOwnCopyOfThe"]</p></div>
                <div class="demo-info"><strong>@S["Dialog.CompleteOrDismiss"]</strong><p>@S["Dialog.SaveReturnsTheUpdatedDetailsCancelTheClose"]</p></div>
                <div class="demo-info"><strong>@S["Dialog.ContinueWhereYouLeftOff"]</strong><p>@S["Dialog.FocusReturnsToTheOpeningButtonWhenThe"]</p></div>
            </div>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private OverlayReference? _dialogReference;
    private bool _requireAction;
    private bool _disposed;
    private string _result = "No changes yet";

    private void ShowDialog()
    {
        if (_dialogReference?.IsAttached == true) return;
        _dialogReference = DialogService.Open(typeof(ProfileEditorContent), new Dictionary<string, object>(), new DialogConfig { TextLocalizer = S.Message,
            Title = "Edit profile", Width = "520px", Height = "auto",
            MaxWidth = "calc(100vw - 32px)", MaxHeight = "calc(100dvh - 32px)",
            DisableBackdropClick = _requireAction, InitialFocusSelector = "#showcase-profile-name"
        });
        _dialogReference.Close += DialogClosed;
    }

    private void DialogClosed(OverlayResult result)
    {
        if (_dialogReference is not null) _dialogReference.Close -= DialogClosed;
        _dialogReference = null;
        if (_disposed) return;
        _result = result.CloseReason == CloseReason.Ok ? $"Saved: {result.ComponentData}" : "Editor dismissed · no changes saved";
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _disposed = true;
        if (_dialogReference is null) return;
        _dialogReference.Close -= DialogClosed;
        _dialogReference.Dispose();
    }
}
