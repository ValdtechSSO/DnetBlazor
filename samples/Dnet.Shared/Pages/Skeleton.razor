@page "/Skeleton"
@using Dnet.Blazor.Components.Skeleton

<div class="container-fluid" style="padding-top: 10px;">
    <div class="dnet-page-content-left-margin dnet-m-t-20" style="max-width: 800px;">
        <h1 class="dnet-app-comp-name">Skeleton</h1>
        <p>Anticipa la forma del contenido mientras llegan los datos.</p>

        <section class="dnet-m-t-20" aria-labelledby="skeleton-shapes-title"
                 style="padding: 24px; border-radius: 12px; background: var(--dnet-sys-surface); border: 1px solid var(--dnet-sys-border);">
            <h2 id="skeleton-shapes-title" style="font-size: 1.125rem; margin-top: 0;">Un perfil a punto de aparecer</h2>
            <div style="display: flex; align-items: center; gap: 16px;">
                <DnetSkeleton Height="64px" Width="140px" Circle="true" id="skeleton-circle" />
                <div style="flex: 1; min-width: 0;">
                    <DnetSkeleton Height="12px" Width="65%" id="skeleton-placeholder" />
                    <DnetSkeleton Height="10px" style="margin-top: 12px;" />
                    <DnetSkeleton Height="10px" Width="80%" style="margin-top: 8px;" />
                </div>
            </div>
            <DnetSkeleton Height="110px" style="--dnet-skeleton-border-radius: 10px; margin-top: 20px;" />
        </section>

        <section class="dnet-m-t-20" aria-labelledby="skeleton-content-title">
            <h2 id="skeleton-content-title" style="font-size: 1.125rem;">Del estado de carga al contenido</h2>
            <button type="button" class="dnet-button" id="skeleton-loading-toggle" @onclick="() => _loading = !_loading">
                @(_loading ? "Mostrar contenido" : "Simular carga")
            </button>
            <p id="skeleton-loading-status" role="status">@(_loading ? "Cargando el perfil…" : "Perfil disponible")</p>
            <div style="width: 128px; margin-bottom: 16px;">
                <DnetSkeleton Circle="true" Height="50%" Visible="_loading" id="skeleton-circle-wrapped">
                    <div style="display: flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 50%; color: var(--dnet-sys-on-primary); background: var(--dnet-sys-primary-emphasis); font-weight: 700;">AL</div>
                </DnetSkeleton>
            </div>
            <DnetSkeleton Visible="_loading" id="skeleton-wrapped" style="--dnet-skeleton-border-radius: 12px;">
                <div style="padding: 24px; border: 1px solid var(--dnet-sys-border); border-radius: 12px; background: var(--dnet-sys-surface);">
                    <h3 style="font-size: 1rem; margin: 0 0 8px;">Tu próximo proyecto</h3>
                    <p style="margin: 0 0 16px;">Escribe una idea. Seguirá aquí después de volver a cargar.</p>
                    <label for="skeleton-state-input" style="display: block; margin-bottom: 6px;">Una idea para recordar</label>
                    <input id="skeleton-state-input" @bind="_note" @bind:event="oninput"
                           style="width: 100%; box-sizing: border-box; padding: 10px; color: var(--dnet-sys-on-surface); background: var(--dnet-sys-surface); border: 1px solid var(--dnet-sys-border-strong); border-radius: 4px;" />
                    <button type="button" class="dnet-button" id="skeleton-content-action" style="margin-top: 12px;" @onclick="() => _saved++">Guardar idea</button>
                    <p id="skeleton-action-count" style="margin: 8px 0 0;">Ideas guardadas: @_saved</p>
                </div>
            </DnetSkeleton>
        </section>

        <section class="dnet-m-t-20" aria-labelledby="skeleton-static-title" dir="rtl">
            <h2 id="skeleton-static-title" style="font-size: 1rem;">También sin animación</h2>
            <DnetSkeleton Animate="false" Height="14px" Width="75%" id="skeleton-static" />
            <DnetSkeleton Animate="false" Height="14px" Width="55%" style="margin-top: 10px;" />
        </section>
    </div>
</div>

@code {
    private bool _loading = true;
    private string _note = "Un fin de semana para descubrir algo nuevo";
    private int _saved;
}
