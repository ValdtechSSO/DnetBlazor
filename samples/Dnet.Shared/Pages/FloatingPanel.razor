@page "/FloatingPanel"
@using Dnet.App.Shared.Pages.ShowcaseContent
@using Dnet.Blazor.Components.Button
@using Dnet.Blazor.Components.Form
@using Dnet.Blazor.Components.Select
@using Dnet.Blazor.Components.FloatingPanel.Infrastructure.Enums
@using Dnet.Blazor.Components.FloatingPanel.Infrastructure.Interfaces
@using Dnet.Blazor.Components.FloatingPanel.Infrastructure.Models
@using Dnet.Blazor.Components.Overlay.Infrastructure.Enums
@using Dnet.Blazor.Components.Overlay.Infrastructure.Models
@using Dnet.Blazor.Components.Overlay.Infrastructure.Services
@inject IFloatingPanelService FloatingPanelService
@implements IDisposable

@* This instance class lives in the portal, outside the page's scoped styles. *@
<style>
    .dnet-floating-panel-container.showcase-profile-floating-panel { height: 100%; }
</style>

<DemoPage Id="demo-floating-panel" Title="Floating panel" Category="Components / Overlays" Description="Make room for a focused task while keeping the current page as the backdrop." Badge="Flexible placement">
    <div class="demo-grid">
        <DemoCard Id="floating-panel-basic" Title="An editor at your side" Eyebrow="01 / Placement" Description="Choose an edge, then open the same profile editor in a floating panel.">
            <ChildContent>
                <div class="demo-stack">
                    <div class="floating-placement-demo demo-preview" aria-hidden="true"><div class="floating-placement-canvas"><span></span><span></span><span></span><div class="floating-placement-panel @PlacementClass"><i></i><i></i><i></i></div></div><span>@_settings.Position placement</span></div>
                    <EditForm Model="_settings"><DnetFormField Label="Panel position"><ChildContent><DnetSelect TValue="string" TItem="string" @bind-Value="_settings.Position" Items="_positions" DisplayValueConverter="position => position" ValueConverter="position => position" ResponsiveLabel="Panel position" /></ChildContent></DnetFormField></EditForm>
                    <div class="demo-actions"><DnetButton id="floating-panel-open" OnClick="ShowFloatingPanel">Show Panel</DnetButton></div>
                </div>
            </ChildContent>
            <Footer><div id="floating-panel-result" class="demo-value" role="status"><span class="demo-muted">Latest result</span><strong>@_result</strong></div></Footer>
        </DemoCard>
        <DemoCard Id="floating-panel-guide" Title="Space for the task" Eyebrow="02 / Interaction" Description="Use a floating panel for details that belong alongside the main view.">
            <div class="demo-stack">
                <div class="demo-info"><strong>One editor, four positions</strong><p>Move between left, right, top and bottom placement to suit the task and screen.</p></div>
                <div class="demo-info"><strong>A clear outcome</strong><p>Save profile returns the edited details here. Cancel closes the panel without saving.</p></div>
                <div class="demo-info"><strong>Comfortable on smaller screens</strong><p>The editor stays within the viewport and scrolls when it needs more space.</p></div>
            </div>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private readonly Settings _settings = new();
    private readonly List<string> _positions = ["Right", "Left", "Top", "Bottom"];
    private OverlayReference? _reference;
    private bool _disposed;
    private string _result = "No changes yet";
    private string PlacementClass => $"is-{_settings.Position.ToLowerInvariant()}";

    private void ShowFloatingPanel()
    {
        if (_reference?.IsAttached == true) return;
        var position = _settings.Position switch { "Left" => FloatingPanelPostion.TopLeft, "Top" => FloatingPanelPostion.TopCenter, "Bottom" => FloatingPanelPostion.BottomCenter, _ => FloatingPanelPostion.TopRight };
        _reference = FloatingPanelService.Show(typeof(ProfileEditorContent), new Dictionary<string, object> { ["Floating"] = true }, new FloatingPanelConfig
        {
            Postion = position, Width = 440, Height = 560, FloatingPanelClass = "showcase-profile-floating-panel",
            OffsetTop = 16, OffsetBottom = 16, OffsetLeft = 16, OffsetRight = 16,
            HasBackdrop = true, HasTransparentBackdrop = false,
            Role = "dialog", AriaLabel = "Edit profile", TrapFocus = true,
            InitialFocusSelector = "#showcase-profile-name",
            PanelStyle = "max-width:calc(100vw - 32px);max-height:calc(100dvh - 32px);"
        });
        _reference.Close += PanelClosed;
    }

    private void PanelClosed(OverlayResult result)
    {
        if (_reference is not null) _reference.Close -= PanelClosed;
        _reference = null;
        if (_disposed) return;
        _result = result.CloseReason == CloseReason.Ok ? $"Saved: {result.ComponentData}" : "Panel dismissed · no changes saved";
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _disposed = true;
        if (_reference is null) return;
        _reference.Close -= PanelClosed;
        _reference.Dispose();
    }
    private sealed class Settings { public string Position { get; set; } = "Right"; }
}
