@page "/FloatingPanel"
@using Dnet.App.Shared.Pages.ShowcaseContent
@using Dnet.Blazor.Components.Button
@using Dnet.Blazor.Components.Form
@using Dnet.Blazor.Components.Select
@using Dnet.Blazor.Components.FloatingPanel.Infrastructure.Enums
@using Dnet.Blazor.Components.FloatingPanel.Infrastructure.Interfaces
@using Dnet.Blazor.Components.FloatingPanel.Infrastructure.Models
@using Dnet.Blazor.Components.Overlay.Infrastructure.Enums
@using Dnet.Blazor.Components.Overlay.Infrastructure.Models
@using Dnet.Blazor.Components.Overlay.Infrastructure.Services
@inject IFloatingPanelService FloatingPanelService
@implements IDisposable

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

@* This instance class lives in the portal, outside the page's scoped styles. *@
<style>
    .dnet-floating-panel-container.showcase-profile-floating-panel { height: 100%; }
</style>

<DemoPage Id="demo-floating-panel" Title="@S["FloatingPanel.FloatingPanel"]" Category="@S["ConnectedPanel.ComponentsOverlays"]" Description="@S["FloatingPanel.MakeRoomForAFocusedTaskWhileKeeping"]" Badge="@S["FloatingPanel.FlexiblePlacement"]">
    <div class="demo-grid">
        <DemoCard Id="floating-panel-basic" Title="@S["FloatingPanel.AnEditorAtYourSide"]" Eyebrow="@S["FloatingPanel.01Placement"]" Description="@S["FloatingPanel.ChooseAnEdgeThenOpenTheSameProfile"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="floating-placement-demo demo-preview" aria-hidden="true"><div class="floating-placement-canvas"><span></span><span></span><span></span><div class="floating-placement-panel @PlacementClass"><i></i><i></i><i></i></div></div><span>@S.Format("Common.0Placement", S.Text(_settings.Position))</span></div>
                    <EditForm Model="_settings"><DnetFormField Label="@S["FloatingPanel.PanelPosition"]"><ChildContent><DnetSelect TValue="string" TItem="string" @bind-Value="_settings.Position" Items="_positions" DisplayValueConverter="position => S.Text(position)" ValueConverter="position => position" ResponsiveLabel="@S["FloatingPanel.PanelPosition"]" /></ChildContent></DnetFormField></EditForm>
                    <div class="demo-actions"><DnetButton id="floating-panel-open" OnClick="ShowFloatingPanel">@S["FloatingPanel.ShowPanel"]</DnetButton></div>
                </div>
            </ChildContent>
            <Footer><div id="floating-panel-result" class="demo-value" role="status"><span class="demo-muted">@S["Dialog.LatestResult"]</span><strong>@S.Display(_result)</strong></div></Footer>
        </DemoCard>
        <DemoCard Id="floating-panel-guide" Title="@S["FloatingPanel.SpaceForTheTask"]" Eyebrow="@S["ConnectedPanel.02Interaction"]" Description="@S["FloatingPanel.UseAFloatingPanelForDetailsThatBelong"]">
            <div class="demo-stack">
                <div class="demo-info"><strong>@S["FloatingPanel.OneEditorFourPositions"]</strong><p>@S["FloatingPanel.MoveBetweenLeftRightTopAndBottomPlacement"]</p></div>
                <div class="demo-info"><strong>@S["FloatingPanel.AClearOutcome"]</strong><p>@S["FloatingPanel.SaveProfileReturnsTheEditedDetailsHereCancel"]</p></div>
                <div class="demo-info"><strong>@S["FloatingPanel.ComfortableOnSmallerScreens"]</strong><p>@S["FloatingPanel.TheEditorStaysWithinTheViewportAndScrolls"]</p></div>
            </div>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private readonly Settings _settings = new();
    private readonly List<string> _positions = ["Right", "Left", "Top", "Bottom"];
    private OverlayReference? _reference;
    private bool _disposed;
    private string _result = "No changes yet";
    private string PlacementClass => $"is-{_settings.Position.ToLowerInvariant()}";

    private void ShowFloatingPanel()
    {
        if (_reference?.IsAttached == true) return;
        var position = _settings.Position switch { "Left" => FloatingPanelPostion.TopLeft, "Top" => FloatingPanelPostion.TopCenter, "Bottom" => FloatingPanelPostion.BottomCenter, _ => FloatingPanelPostion.TopRight };
        _reference = FloatingPanelService.Show(typeof(ProfileEditorContent), new Dictionary<string, object> { ["Floating"] = true }, new FloatingPanelConfig
        {
            Postion = position, Width = 440, Height = 560, FloatingPanelClass = "showcase-profile-floating-panel",
            OffsetTop = 16, OffsetBottom = 16, OffsetLeft = 16, OffsetRight = 16,
            HasBackdrop = true, HasTransparentBackdrop = false,
            Role = "dialog", AriaLabelledBy = "showcase-profile-heading", TrapFocus = true,
            InitialFocusSelector = "#showcase-profile-name",
            PanelStyle = "max-width:calc(100vw - 32px);max-height:calc(100dvh - 32px);"
        });
        _reference.Close += PanelClosed;
    }

    private void PanelClosed(OverlayResult result)
    {
        if (_reference is not null) _reference.Close -= PanelClosed;
        _reference = null;
        if (_disposed) return;
        _result = result.CloseReason == CloseReason.Ok ? $"Saved: {result.ComponentData}" : "Panel dismissed · no changes saved";
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _disposed = true;
        if (_reference is null) return;
        _reference.Close -= PanelClosed;
        _reference.Dispose();
    }
    private sealed class Settings { public string Position { get; set; } = "Right"; }
}
