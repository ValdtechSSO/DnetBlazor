@page "/Spinner"
@using System.Threading
@using Dnet.Blazor.Components.Button
@using Dnet.Blazor.Components.Spinner.Infrastructure.Interfaces
@inject ISpinnerService SpinnerService
@implements IDisposable

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-spinner" Title="@S["Spinner.Spinner"]" Category="@S["Toast.ComponentsFeedback"]" Description="@S["Spinner.MakeShortWaitsUnderstandableFromASingleAction"]" Badge="@S["Spinner.LoadingFeedback"]">
    <div class="demo-grid">
        <DemoCard Id="spinner-basic" Title="@S["Spinner.AShortClearWait"]" Eyebrow="@S["Spinner.01OneOperation"]" Description="@S["Spinner.SimulateSavingAWorkspaceTheLoadingIndicatorClears"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="spinner-workspace demo-preview"><span class="spinner-workspace-icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="16" rx="3" /><path d="M3 9h18M8 9v11M12 13h5m-5 3h3" /></svg></span><div><strong>@S["Spinner.DesignWorkspace"]</strong><p>@S["Spinner.YourLayoutFiltersAndPreferences"]</p></div><span class="spinner-duration">@S["Spinner.2Seconds"]</span></div>
                    <div class="demo-actions"><DnetButton id="spinner-run" OnClick="RunSpinner" disabled="@_running">@S["Spinner.SaveWorkspace"]</DnetButton></div>
                    <p class="demo-muted">@S["Spinner.ASubtleMaskKeepsTheFocusOnThe"]</p>
                </div>
            </ChildContent>
            <Footer><p id="spinner-status" class="spinner-status" role="status">@S.Display(_status)</p></Footer>
        </DemoCard>
        <DemoCard Id="spinner-batch" Title="@S["Spinner.ReadyWhenEverythingIsReady"]" Eyebrow="@S["Spinner.02CoordinatedRequests"]" Description="@S["Spinner.LoadThreePartsOfADashboardTogetherThe"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="spinner-requests">
                        <div><span class="spinner-request-number">01</span><div><strong>@S["Spinner.ProfileDetails"]</strong><span>@S["Spinner.ReadyAfter08Seconds"]</span></div></div>
                        <div><span class="spinner-request-number">02</span><div><strong>@S["Spinner.RecentActivity"]</strong><span>@S["Spinner.ReadyAfter16Seconds"]</span></div></div>
                        <div><span class="spinner-request-number">03</span><div><strong>@S["Theming.WorkspaceSettings"]</strong><span>@S["Spinner.ReadyAfter24Seconds"]</span></div></div>
                    </div>
                    <div class="demo-actions"><DnetButton id="spinner-run-batch" OnClick="RunBatch" disabled="@_running">@S["Spinner.LoadDashboard"]</DnetButton></div>
                </div>
            </ChildContent>
            <Footer><p id="spinner-batch-status" class="spinner-status" role="status">@S.Display(_batchStatus)</p></Footer>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private CancellationTokenSource? _operationCancellation;
    private int _activeRequests;
    private int _completedRequests;
    private bool _running;
    private bool _disposed;
    private string _status = "Ready to save your workspace";
    private string _batchStatus = "Three requests, one loading indicator";

    private Task RunSpinner() => RunOperationsAsync([2000], false);
    private Task RunBatch() => RunOperationsAsync([800, 1600, 2400], true);

    private async Task RunOperationsAsync(int[] durations, bool batch)
    {
        if (_running || _disposed) return;
        _running = true;
        _completedRequests = 0;
        var cancellation = _operationCancellation = new CancellationTokenSource();
        if (batch) _batchStatus = "Loading dashboard · 0 of 3 requests complete";
        else _status = "Saving workspace…";
        _activeRequests = durations.Length;
        SpinnerService.UpdateCounter(_activeRequests);
        try
        {
            await Task.WhenAll(durations.Select(duration => CompleteRequestAsync(duration, cancellation.Token, batch)));
            if (!_disposed)
            {
                if (batch) _batchStatus = "Dashboard ready · all 3 requests completed";
                else _status = "Workspace saved · you're ready to continue";
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            _running = false;
            if (ReferenceEquals(_operationCancellation, cancellation)) _operationCancellation = null;
            cancellation.Dispose();
        }
    }

    private async Task CompleteRequestAsync(int duration, CancellationToken cancellationToken, bool batch)
    {
        try
        {
            await Task.Delay(duration, cancellationToken);
            if (!_disposed)
            {
                _completedRequests++;
                if (batch) _batchStatus = $"Loading dashboard · {_completedRequests} of 3 requests complete";
                StateHasChanged();
            }
        }
        finally
        {
            if (_activeRequests > 0) { _activeRequests--; SpinnerService.Hide(); }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _operationCancellation?.Cancel();
        if (_activeRequests > 0) { SpinnerService.UpdateCounter(-_activeRequests); _activeRequests = 0; }
    }
}
