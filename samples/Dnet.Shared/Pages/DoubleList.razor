@page "/DoubleList"
@using Dnet.Blazor.Components.List
@using Dnet.Blazor.Components.Checkbox
@using Dnet.Blazor.Components.Button

<DnetLocalizationObserver OnChanged="RefreshSampleLanguage" />

@{ var listRevision = _listRevision; }

<DemoPage Id="demo-doublelist" Title="@S["DoubleList.DoubleList"]" Category="@S["SlideToggle.SelectionControls"]"
          Description="@S["DoubleList.BringTheRightPeopleIntoAProjectMove"]"
          Badge="@S["DoubleList.ChooseMoveReview"]">
    <DemoCard Id="doublelist-workspace-card" Title="@S["DoubleList.BuildYourProjectTeam"]" Eyebrow="@S["Chips.WebsiteLaunch"]"
              Description="@S["DoubleList.MovePeopleFromTheAvailableListIntoYour"]">
        <ChildContent>
            <div class="demo-stack">
                <div class="doublelist-view-switch" role="group" aria-label="@S["DoubleList.ChooseAList"]">
                    <button id="doublelist-show-available" type="button" aria-pressed="@(!_showAssigned ? "true" : "false")"
                            @onclick="() => _showAssigned = false">@S.Format("Common.Available0", _availableItems.Count)</button>
                    <button id="doublelist-show-assigned" type="button" aria-pressed="@(_showAssigned ? "true" : "false")"
                            @onclick="() => _showAssigned = true">@S.Format("Common.Assigned0", _assignedItems.Count)</button>
                </div>
                <div class="doublelist-workspace">
                    <section class="doublelist-column @(!_showAssigned ? "doublelist-active" : null)" aria-labelledby="doublelist-available-title">
                        <div class="doublelist-column-heading"><h3 id="doublelist-available-title">@S["DoubleList.AvailablePeople"]</h3><span class="doublelist-count">@S.Display(_availableItems.Count)</span></div>
                        <p class="demo-muted doublelist-column-description">@S["DoubleList.ChooseWhoJoinsTheProject"]</p>
                        <div id="doublelist-available" class="doublelist-stage">
                            <DnetList @key="listRevision" TItem="Contact" Items="_availableItems" ListOptions="_availableOptions"
                                      Label="@S["DoubleList.SearchAvailable"]" PlaceHolder="@S["List.TypeAName"]"
                                      OnSelectionChange="AvailableSelectionChanged" OnDrop="ReturnPeople"
                                      OnTransfer="@(contact => QuickMove(contact, true, listRevision))">
                                <ItemPrefixContent Context="contact"><span class="doublelist-avatar" aria-hidden="true">@Initials(contact.Name)</span></ItemPrefixContent>
                                <ListItemContent Context="contact">
                                    <span class="dnet-list-item-headline">@contact.Name</span>
                                    <span class="dnet-list-item-supporting-text">@S.Display(contact.Role)</span>
                                </ListItemContent>
                            </DnetList>
                            @if (_availableItems.Count == 0)
                            {
                                <div id="doublelist-available-empty" class="doublelist-empty" role="status"><strong>@S["DoubleList.EveryoneIsOnTheTeam"]</strong><span>@S["DoubleList.ReturnSomeoneToMakeThemAvailableAgain"]</span></div>
                            }
                        </div>
                        <div class="doublelist-mobile-action"><DnetButton id="doublelist-assign-mobile" disabled="@(_availableSelection.Count == 0)" OnClick="AssignSelection">@S.Format("Common.AssignSelected0", _availableSelection.Count)</DnetButton></div>
                    </section>

                    <div class="doublelist-transfer-controls" role="group" aria-label="@S["DoubleList.MoveSelectedPeople"]">
                        <DnetButton id="doublelist-assign" disabled="@(_availableSelection.Count == 0)" OnClick="AssignSelection">@S["DoubleList.Assign"]</DnetButton>
                        <DnetButton Variant="DnetButtonVariant.Outlined" id="doublelist-return" disabled="@(_assignedSelection.Count == 0)" OnClick="ReturnSelection">@S["DoubleList.Return"]</DnetButton>
                        <span class="demo-muted">@S["DoubleList.SelectedPeople"]</span>
                    </div>

                    <section class="doublelist-column @(_showAssigned ? "doublelist-active" : null)" aria-labelledby="doublelist-assigned-title">
                        <div class="doublelist-column-heading"><h3 id="doublelist-assigned-title">@S["DoubleList.AssignedToProject"]</h3><span class="doublelist-count">@S.Display(_assignedItems.Count)</span></div>
                        <p class="demo-muted doublelist-column-description">@S["DoubleList.TheProjectLeadStaysOnTheTeam"]</p>
                        <div id="doublelist-assigned" class="doublelist-stage">
                            <DnetList @key="listRevision" TItem="Contact" Items="_assignedItems" ListOptions="_assignedOptions"
                                      Label="@S["DoubleList.SearchAssigned"]" PlaceHolder="@S["List.TypeAName"]"
                                      OnSelectionChange="AssignedSelectionChanged" OnDrop="AssignPeople"
                                      OnTransfer="@(contact => QuickMove(contact, false, listRevision))">
                                <ItemPrefixContent Context="contact"><span class="doublelist-avatar @(contact.IsLocked ? "doublelist-avatar-muted" : null)" aria-hidden="true">@Initials(contact.Name)</span></ItemPrefixContent>
                                <ListItemContent Context="contact">
                                    <span class="dnet-list-item-headline @(contact.IsLocked ? "disabled" : null)">@contact.Name</span>
                                    <span class="dnet-list-item-supporting-text @(contact.IsLocked ? "disabled" : null)">@S.Display(contact.Role) @(contact.IsLocked ? S.Text("· Fixed") : null)</span>
                                </ListItemContent>
                            </DnetList>
                        </div>
                        <div class="doublelist-mobile-action"><DnetButton Variant="DnetButtonVariant.Outlined" id="doublelist-return-mobile" disabled="@(_assignedSelection.Count == 0)" OnClick="ReturnSelection">@S.Format("Common.ReturnSelected0", _assignedSelection.Count)</DnetButton></div>
                    </section>
                </div>
                <p id="doublelist-action" class="demo-status" role="status">@S.Display(_lastAction)</p>
                <p class="demo-info">@S["DoubleList.ClickAPersonSNameForAQuick"]</p>
            </div>
        </ChildContent>
        <Footer>
            <div class="doublelist-metrics" role="status">
                <span id="doublelist-available-count"><strong>@S.Display(_availableItems.Count)</strong> @S["DoubleList.Available"]</span>
                <span id="doublelist-assigned-count"><strong>@S.Display(_assignedItems.Count)</strong> @S["DoubleList.Assigned"]</span>
                <span id="doublelist-selected-count"><strong>@S.Display(_availableSelection.Count + _assignedSelection.Count)</strong> @S["DoubleList.Selected"]</span>
            </div>
        </Footer>
    </DemoCard>

    <div class="demo-grid">
        <DemoCard Id="doublelist-options" Title="@S["DoubleList.ChooseYourListControls"]" Eyebrow="@S["DoubleList.DisplayPreferences"]"
                  Description="@S["DoubleList.AdjustBothListsTogetherAssignmentsStayInPlace"]">
            <div class="doublelist-options-grid">
                <div class="demo-option-row"><DnetInputCheckbox id="doublelist-option-search" @bind-Value="_searching" @bind-Value:after="ApplyOptions">@S["List.Search"]</DnetInputCheckbox></div>
                <div class="demo-option-row"><DnetInputCheckbox id="doublelist-option-checkboxes" @bind-Value="_checkboxes" @bind-Value:after="ApplyOptions">@S["List.SelectionCheckboxes"]</DnetInputCheckbox></div>
                <div class="demo-option-row"><DnetInputCheckbox id="doublelist-option-sorting" @bind-Value="_sorting" @bind-Value:after="SortingChanged">@S["List.Sorting"]</DnetInputCheckbox></div>
                <div class="demo-option-row"><DnetInputCheckbox id="doublelist-option-header" @bind-Value="_header" @bind-Value:after="HeaderChanged">@S["List.Header"]</DnetInputCheckbox></div>
                <div class="demo-option-row"><DnetInputCheckbox id="doublelist-option-pagination" @bind-Value="_pagination" @bind-Value:after="PaginationChanged">@S["List.Pagination"]</DnetInputCheckbox></div>
                <div class="demo-option-row"><DnetInputCheckbox id="doublelist-option-footer" @bind-Value="_footer" @bind-Value:after="FooterChanged">@S["List.Footer"]</DnetInputCheckbox></div>
            </div>
            <p class="demo-info">@S["Common.TheHeaderCheckboxSelectsTheCurrentPageClickName"]</p>
        </DemoCard>

        <DemoCard Id="doublelist-summary" Title="@S["DoubleList.YourProjectTeam"]" Eyebrow="@S["DoubleList.LiveAssignment"]"
                  Description="@S["DoubleList.ReviewEveryoneCurrentlyAssignedToTheProjectThe"]">
            <ChildContent>
                <ul id="doublelist-roster" class="doublelist-roster">
                    @foreach (var contact in _assignedItems.OrderBy(contact => contact.Name))
                    {
                        <li @key="contact.Id"><span>@contact.Name</span>@if (contact.IsLocked) { <span class="doublelist-fixed">@S["DoubleList.ProjectLeadFixed"]</span> }</li>
                    }
                </ul>
                <div class="demo-actions doublelist-reset-action"><DnetButton Variant="DnetButtonVariant.Outlined" id="doublelist-reset" OnClick="ResetAssignment">@S["DoubleList.ResetAssignment"]</DnetButton></div>
                <p class="demo-info">@S["DoubleList.RestoreTheOriginalTeamYourDisplayPreferencesStay"]</p>
            </ChildContent>
            <Footer><span id="doublelist-team-count" class="demo-value" role="status">@S.Format("Common.0PeopleOnTheProject1FixedLead", _assignedItems.Count)</span></Footer>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private Task RefreshSampleLanguage() => InvokeAsync(() =>
    {
        _availableOptions.HeaderText = S.Text(_availableOptions.HeaderText);
        _assignedOptions.HeaderText = S.Text(_assignedOptions.HeaderText);
        StateHasChanged();
    });

    private readonly Contact[] _contacts =
    [
        new(1, "Alex Rivera", "Product designer"),
        new(2, "Sam Chen", "Frontend engineer"),
        new(3, "Casey Brooks", "UX researcher"),
        new(4, "Morgan Patel", "QA engineer"),
        new(5, "Jamie Torres", "Product manager"),
        new(6, "Taylor Morgan", "Project lead", true),
        new(7, "Riley Parker", "Backend engineer"),
        new(8, "Jordan Lee", "Data analyst"),
        new(9, "Avery Scott", "Content designer"),
        new(10, "Cameron Reed", "DevOps engineer")
    ];
    private List<Contact> _availableItems = [];
    private List<Contact> _assignedItems = [];
    private List<Contact> _availableSelection = [];
    private List<Contact> _assignedSelection = [];
    private ListOptions<Contact> _availableOptions = new();
    private ListOptions<Contact> _assignedOptions = new();
    private bool _searching = true;
    private bool _checkboxes = true;
    private bool _sorting = true;
    private bool _header = true;
    private bool _pagination = true;
    private bool _footer = true;
    private bool _showAssigned;
    private int _listRevision;
    private string _lastAction = "Choose people to assign, or move someone back to the available list.";

    protected override void OnInitialized()
    {
        _availableItems = _contacts.Take(5).ToList();
        _assignedItems = _contacts.Skip(5).ToList();
        RefreshLists();
    }

    private ListOptions<Contact> CreateOptions(bool assigned) => new()
    {
        DisplayValueConverter = contact => contact.Name,
        SupportTextValueConverter = contact => S.Text(contact.Role),
        SortedData = contact => contact.Name,
        SearchValueConverter = contact => contact.Name,
        DisableItem = contact => contact.IsLocked,
        HeaderText = S.Text("Name"),
        MultiSelect = true,
        EnableServerSide = false,
        EnableSearching = _searching,
        EnableSorting = _sorting,
        PageSize = _pagination ? 4 : _contacts.Length,
        EnablePagingination = _pagination,
        CheckboxSelectionColumn = _checkboxes,
        ShowHeader = _header,
        ShowFooter = _footer,
        ContainerName = assigned ? "project-assigned" : "project-available",
        ConnectedTo = assigned ? "project-available" : "project-assigned"
    };

    private void AvailableSelectionChanged(List<Contact> people) =>
        _availableSelection = people.Where(person => !person.IsLocked && _availableItems.Any(item => item.Id == person.Id)).DistinctBy(person => person.Id).ToList();

    private void AssignedSelectionChanged(List<Contact> people) =>
        _assignedSelection = people.Where(person => !person.IsLocked && _assignedItems.Any(item => item.Id == person.Id)).DistinctBy(person => person.Id).ToList();

    private void AssignSelection() => AssignPeople(_availableSelection);
    private void ReturnSelection() => ReturnPeople(_assignedSelection);
    private void AssignPeople(List<Contact> people) => MovePeople(people, true);
    private void ReturnPeople(List<Contact> people) => MovePeople(people, false);

    private void QuickMove(Contact person, bool assign, int revision)
    {
        if (revision == _listRevision) MovePeople([person], assign);
    }

    private void MovePeople(IEnumerable<Contact> people, bool assign)
    {
        var source = assign ? _availableItems : _assignedItems;
        var requestedIds = people.Select(person => person.Id).ToHashSet();
        var moved = source.Where(person => requestedIds.Contains(person.Id) && !person.IsLocked).DistinctBy(person => person.Id).ToList();
        if (moved.Count == 0) return;

        var movedIds = moved.Select(person => person.Id).ToHashSet();
        if (assign)
        {
            _availableItems = _availableItems.Where(person => !movedIds.Contains(person.Id)).ToList();
            _assignedItems = _assignedItems.Concat(moved).DistinctBy(person => person.Id).ToList();
        }
        else
        {
            _assignedItems = _assignedItems.Where(person => !movedIds.Contains(person.Id)).ToList();
            _availableItems = _availableItems.Concat(moved).DistinctBy(person => person.Id).ToList();
        }

        _showAssigned = assign;
        _lastAction = $"{moved.Count} {(moved.Count == 1 ? "person" : "people")} {(assign ? "assigned to the project" : "returned to the available list")}.";
        RefreshLists();
    }

    private void RefreshLists()
    {
        _availableSelection = [];
        _assignedSelection = [];
        _availableOptions = CreateOptions(false);
        _assignedOptions = CreateOptions(true);
        // Recreate both lists so searches, paging, fading rows and selection reset together.
        _listRevision++;
    }

    private void ApplyOptions()
    {
        RefreshLists();
        _lastAction = "List controls updated. Assignments kept; searches and selection cleared.";
    }

    private void SortingChanged()
    {
        if (_sorting) _header = true;
        ApplyOptions();
    }

    private void HeaderChanged()
    {
        if (!_header) _sorting = false;
        ApplyOptions();
    }

    private void PaginationChanged()
    {
        if (_pagination) _footer = true;
        ApplyOptions();
    }

    private void FooterChanged()
    {
        if (!_footer) _pagination = false;
        ApplyOptions();
    }

    private void ResetAssignment()
    {
        _availableItems = _contacts.Take(5).ToList();
        _assignedItems = _contacts.Skip(5).ToList();
        _showAssigned = false;
        RefreshLists();
        _lastAction = "Original assignment restored. Display preferences kept.";
    }

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0]));

    private sealed record Contact(int Id, string Name, string Role, bool IsLocked = false);
}
