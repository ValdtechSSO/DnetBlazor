@page "/DynamicStepper"
@using Dnet.Blazor.Components.DynamicStepper
@using Dnet.Blazor.Components.Checkbox

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-dynamic-stepper" Title="@S["DynamicStepper.DynamicStepper"]" Category="@S["Stepper.Navigation"]"
          Description="@S["DynamicStepper.KeepALongerWorkflowCompactTheVisibleSteps"]" Badge="@S["DynamicStepper.10Stages"]">
    <div class="demo-stack">
        <DemoCard Id="dynamic-stepper-workflow" Title="@S["DynamicStepper.FromBriefToRelease"]" Eyebrow="@S["DynamicStepper.AdaptiveStepWindow"]"
                  Description="@S["DynamicStepper.UseNextAndPreviousOrChooseAVisible"]">
            <ChildContent>
                <div class="dnet-app-dstepper-container dynamic-stepper-stage">
                    <DnetDynamicStepper ShowButtons="_showButtons" Editable="@(!_locked)" OnSelectionChange="StepChanged">
                        @foreach (var stage in _stages)
                        {
                            <DnetDynamicStep Label="@S.Text(stage.Title)">
                                <div class="dynamic-stepper-content">
                                    <span class="dynamic-stepper-kicker">@S.Format("Common.ReleaseWorkflowStage0", stage.Index + 1)</span>
                                    <h3>@S.Display(stage.Heading)</h3>
                                    <p class="demo-muted">@S.Display(stage.Description)</p>
                                    <div class="dynamic-stepper-owner"><span class="demo-info">@S["DynamicStepper.ResponsibleTeam"]</span><strong>@S.Display(stage.Owner)</strong></div>
                                </div>
                            </DnetDynamicStep>
                        }
                    </DnetDynamicStepper>
                </div>
            </ChildContent>
            <Footer>
                <div class="dynamic-stepper-progress">
                    <span id="dynamic-stepper-value" role="status">@S.Format("Common.Stage0Of12", _selectedStep, _stages.Length, S.Text(_stages[_selectedStep - 1].Title))</span>
                    <progress value="@_selectedStep" max="@_stages.Length" aria-label="@S["DynamicStepper.CurrentWorkflowPosition"]"></progress>
                </div>
            </Footer>
        </DemoCard>
        <div class="demo-grid">
            <DemoCard Id="dynamic-stepper-options" Title="@S["DynamicStepper.NavigationOptions"]" Description="@S["DynamicStepper.ExploreHowTheSameWorkflowRespondsToDifferent"]">
                <div class="demo-option-row"><DnetInputCheckbox id="dynamic-stepper-show-buttons" @bind-Value="_showButtons">@S["DynamicStepper.ShowPreviousAndNext"]</DnetInputCheckbox></div>
                <div class="demo-option-row"><DnetInputCheckbox id="dynamic-stepper-lock" @bind-Value="_locked">@S["DynamicStepper.LockTheCurrentStage"]</DnetInputCheckbox></div>
                <p id="dynamic-stepper-options-value" class="demo-info" role="status">@S.Display(_locked ? "Navigation is locked at the current stage." : "Navigation is available between stages.")</p>
            </DemoCard>
            <DemoCard Id="dynamic-stepper-guide" Title="@S["DynamicStepper.ACompactViewOfALongerJourney"]" Description="@S["DynamicStepper.ASlidingStepWindowKeepsTheCurrentStage"]">
                <ul class="demo-bullets">
                    <li>@S["DynamicStepper.TheHeaderShowsAsManyStagesAsThe"]</li>
                    <li>@S["DynamicStepper.MovingNearAnEdgeRevealsTheNextPart"]</li>
                    <li>@S["DynamicStepper.PreviousAndNextBecomeUnavailableAtTheFirst"]</li>
                </ul>
            </DemoCard>
        </div>
    </div>
</DemoPage>

@code {
    private int _selectedStep = 1;
    private bool _showButtons = true;
    private bool _locked;
    private readonly ReleaseStage[] _stages =
    [
        new(0, "Brief", "Define the outcome", "Agree on the audience, the problem and the result this release should deliver.", "Product"),
        new(1, "Research", "Understand the context", "Bring customer insight and the current experience into the project brief.", "Research"),
        new(2, "Scope", "Choose the right work", "Decide what belongs in this release and what can follow later.", "Product and engineering"),
        new(3, "Design", "Shape the experience", "Turn the agreed scope into a clear flow the team can evaluate.", "Design"),
        new(4, "Review", "Get the team aligned", "Review the proposed experience and resolve open questions before delivery.", "Project team"),
        new(5, "Build", "Bring the plan to life", "Implement the agreed experience with regular checkpoints along the way.", "Engineering"),
        new(6, "Test", "Check the complete journey", "Verify the key paths and make sure the release is ready for customers.", "Quality assurance"),
        new(7, "Approve", "Confirm release readiness", "Gather the final approval and confirm that the team is ready to publish.", "Release owner"),
        new(8, "Release", "Share the finished work", "Publish the release and give the team the context they need to support it.", "Operations"),
        new(9, "Learn", "Close the feedback loop", "Review the launch, capture what changed and plan the next improvement.", "Project team")
    ];

    private void StepChanged(Tuple<int, int> change) => _selectedStep = change.Item1;
    private sealed record ReleaseStage(int Index, string Title, string Heading, string Description, string Owner);
}
