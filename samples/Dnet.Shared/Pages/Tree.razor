@page "/Tree"
@using Dnet.Blazor.Components.Tree
@using Dnet.Blazor.Components.Button

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-tree" Title="@S["Tree.TreeView"]" Category="@S["Tree.DataDisplay"]"
          Description="@S["Tree.ExploreANestedCollectionAndMakeSelectionsAt"]" Badge="@S["Tree.NestedSelection"]">
    <div class="demo-grid">
        <DemoCard Id="tree-catalog-card" Title="@S["Tree.BrowseTheCatalog"]" Eyebrow="@S["Tree.ExpandableHierarchy"]"
                  Description="@S["Tree.OpenACategoryToExploreItsContentsSelecting"]">
            <ChildContent>
                <div class="demo-actions tree-actions">
                    <DnetButton Variant="DnetButtonVariant.Outlined" id="tree-expand-all" OnClick="() => Expand(true)">@S["Tree.ExpandAll"]</DnetButton>
                    <DnetButton Variant="DnetButtonVariant.Outlined" id="tree-collapse-all" OnClick="() => Expand(false)">@S["Tree.CollapseAll"]</DnetButton>
                </div>
                <div id="tree-catalog" class="tree-stage">
                    <DnetTree @ref="_tree" TNode="Food" Nodes="_treeData" DisplayValueConverter="food => S.Text(food.Name)"
                              ChildNodes="food => food.Children" CheckboxSelection="true"
                              OnTreeNodeClicked="NodeClicked" OnCheckboxClicked="CheckboxClicked" OnSelectionChange="SelectionChanged">
                        <NodeContent><span class="tree-node-label">@S.Display(context.Name)</span></NodeContent>
                    </DnetTree>
                </div>
            </ChildContent>
            <Footer><span id="tree-current-node" role="status">@S.Display(_nodeStatus)</span></Footer>
        </DemoCard>
        <div class="demo-stack">
            <DemoCard Id="tree-selection-card" Title="@S["Tree.SelectedItems"]" Description="@S["Tree.TheSelectionIncludesBothCategoriesAndIndividualItems"]">
                <ChildContent>
                    @if (_selectedFoods.Count == 0)
                    {
                        <div class="tree-empty"><strong>@S["Tree.YourSelectionIsEmpty"]</strong><p class="demo-muted">@S["Tree.UseACheckboxInTheCatalogToSelect"]</p></div>
                    }
                    else
                    {
                        <ul id="tree-selected-names" class="demo-bullets">
                            @foreach (var food in _selectedFoods)
                            {
                                <li>@S.Display(food.Name)</li>
                            }
                        </ul>
                    }
                </ChildContent>
                <Footer><span id="tree-selected-count" role="status">@S.Format("Common.0Selected", _selectedFoods.Count)</span></Footer>
            </DemoCard>
            <DemoCard Id="tree-guide" Title="@S["Tree.ExploreABranch"]" Description="@S["Tree.AFamiliarHierarchyKeepsRelatedInformationTogether"]">
                <ul class="demo-bullets">
                    <li>@S["Tree.UseTheChevronToExpandOrCollapseA"]</li>
                    <li>@S["Tree.SelectALabelToMakeItTheCurrent"]</li>
                    <li>@S["Tree.UseACheckboxToAddAnItemTo"]</li>
                </ul>
                <p id="tree-expand-value" class="demo-info" role="status">@S.Display(_expansionStatus)</p>
                <p id="tree-checkbox-value" class="demo-info" role="status">@S.Display(_checkboxStatus)</p>
            </DemoCard>
        </div>
    </div>
</DemoPage>

@code {
    private DnetTree<Food>? _tree;
    private List<Food> _selectedFoods = new();
    private string _nodeStatus = "Choose an item to make it current.";
    private string _expansionStatus = "Categories start collapsed.";
    private string _checkboxStatus = "No selection changes yet.";
    private readonly List<Food> _treeData =
    [
        new("Fruit",
        [
            new("Apple"),
            new("Banana"),
            new("Berries")
        ]),
        new("Vegetables",
        [
            new("Green", [new("Broccoli"), new("Spinach")]),
            new("Orange", [new("Pumpkins"), new("Carrots")])
        ]),
        new("Nuts")
    ];

    private void NodeClicked(Food food) => _nodeStatus = $"Current item: {food.Name}.";
    private void CheckboxClicked(Food food) => _checkboxStatus = $"Last selection change: {food.Name}.";
    private void SelectionChanged(List<Food> foods) => _selectedFoods = foods;

    private void Expand(bool expand)
    {
        _tree?.Expand(expand);
        _expansionStatus = expand ? "All categories are expanded." : "All categories are collapsed.";
    }

    public sealed class Food(string name, List<Food>? children = null)
    {
        public string Name { get; } = name;
        public List<Food>? Children { get; } = children;
    }
}
