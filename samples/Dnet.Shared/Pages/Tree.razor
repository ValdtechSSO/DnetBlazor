@page "/Tree"
@using Dnet.Blazor.Components.Tree
@using Dnet.Blazor.Components.Button

<DemoPage Id="demo-tree" Title="Tree view" Category="Data display"
          Description="Explore a nested collection and make selections at any level, from a whole category to a single item." Badge="Nested selection">
    <div class="demo-grid">
        <DemoCard Id="tree-catalog-card" Title="Browse the catalog" Eyebrow="Expandable hierarchy"
                  Description="Open a category to explore its contents. Selecting a parent also selects the items inside it.">
            <ChildContent>
                <div class="demo-actions tree-actions">
                    <DnetButton Variant="DnetButtonVariant.Outlined" id="tree-expand-all" OnClick="() => Expand(true)">Expand all</DnetButton>
                    <DnetButton Variant="DnetButtonVariant.Outlined" id="tree-collapse-all" OnClick="() => Expand(false)">Collapse all</DnetButton>
                </div>
                <div id="tree-catalog" class="tree-stage">
                    <DnetTree @ref="_tree" TNode="Food" Nodes="_treeData" DisplayValueConverter="food => food.Name"
                              ChildNodes="food => food.Children" CheckboxSelection="true"
                              OnTreeNodeClicked="NodeClicked" OnCheckboxClicked="CheckboxClicked" OnSelectionChange="SelectionChanged">
                        <NodeContent><span class="tree-node-label">@context.Name</span></NodeContent>
                    </DnetTree>
                </div>
            </ChildContent>
            <Footer><span id="tree-current-node" role="status">@_nodeStatus</span></Footer>
        </DemoCard>
        <div class="demo-stack">
            <DemoCard Id="tree-selection-card" Title="Selected items" Description="The selection includes both categories and individual items.">
                <ChildContent>
                    @if (_selectedFoods.Count == 0)
                    {
                        <div class="tree-empty"><strong>Your selection is empty</strong><p class="demo-muted">Use a checkbox in the catalog to select an item or a whole branch.</p></div>
                    }
                    else
                    {
                        <ul id="tree-selected-names" class="demo-bullets">
                            @foreach (var food in _selectedFoods)
                            {
                                <li>@food.Name</li>
                            }
                        </ul>
                    }
                </ChildContent>
                <Footer><span id="tree-selected-count" role="status">@_selectedFoods.Count selected</span></Footer>
            </DemoCard>
            <DemoCard Id="tree-guide" Title="Explore a branch" Description="A familiar hierarchy keeps related information together.">
                <ul class="demo-bullets">
                    <li>Use the chevron to expand or collapse a category.</li>
                    <li>Select a label to make it the current item.</li>
                    <li>Use a checkbox to add an item to your selection.</li>
                </ul>
                <p id="tree-expand-value" class="demo-info" role="status">@_expansionStatus</p>
                <p id="tree-checkbox-value" class="demo-info" role="status">@_checkboxStatus</p>
            </DemoCard>
        </div>
    </div>
</DemoPage>

@code {
    private DnetTree<Food>? _tree;
    private List<Food> _selectedFoods = new();
    private string _nodeStatus = "Choose an item to make it current.";
    private string _expansionStatus = "Categories start collapsed.";
    private string _checkboxStatus = "No selection changes yet.";
    private readonly List<Food> _treeData =
    [
        new("Fruit",
        [
            new("Apple"),
            new("Banana"),
            new("Berries")
        ]),
        new("Vegetables",
        [
            new("Green", [new("Broccoli"), new("Spinach")]),
            new("Orange", [new("Pumpkins"), new("Carrots")])
        ]),
        new("Nuts")
    ];

    private void NodeClicked(Food food) => _nodeStatus = $"Current item: {food.Name}.";
    private void CheckboxClicked(Food food) => _checkboxStatus = $"Last selection change: {food.Name}.";
    private void SelectionChanged(List<Food> foods) => _selectedFoods = foods;

    private void Expand(bool expand)
    {
        _tree?.Expand(expand);
        _expansionStatus = expand ? "All categories are expanded." : "All categories are collapsed.";
    }

    public sealed class Food(string name, List<Food>? children = null)
    {
        public string Name { get; } = name;
        public List<Food>? Children { get; } = children;
    }
}
