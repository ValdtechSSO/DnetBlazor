@page "/PillTabs"
@using Dnet.Blazor.Components.PillTabs
@using Dnet.Blazor.Components.Button
@using Microsoft.JSInterop

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<DemoPage Id="demo-pill-tabs" Title="@S["PillTabs.PillTabs"]" Category="@S["PillTabs.NavigationAndSelection"]"
          Description="@S["PillTabs.ACompactWayToOrganizeContentAndChange"]"
          Badge="@S["PillTabs.SelectExploreContinue"]">
    <DemoCard Id="pill-tabs-inbox-card" Title="@S["PillTabs.EveryRequestInItsPlace"]" Eyebrow="@S["PillTabs.TeamInbox"]"
              Description="@S["PillTabs.ReviewWhatNeedsAttentionOrReturnToApproved"]">
        <ChildContent>
            <div class="pill-inbox-layout">
                <div class="pill-inbox">
                    <DnetPillTabs Items="Statuses" @bind-Value="_status" AriaLabel="@S["PillTabs.RequestStatus"]" FullWidth="true" id="pill-tabs-reference">
                        <ChildContent Context="tab">
                            <div id="pill-tabs-inbox-content" class="pill-inbox-content" @ref="_inboxContent"
                                 tabindex="-1" role="group" aria-label="@S.Format("Common.Requests0", S.Text(tab.Label))">
                                <div class="pill-panel-heading"><p id="pill-tabs-selected-status">@S.Format("Common.Showing0", S.Text(tab.Label))</p><span>@S.Message(ResultCount(tab.Value))</span></div>
                                @if (RequestsFor(tab.Value).Any())
                                {
                                    <div class="pill-request-list">
                                        @foreach (var request in RequestsFor(tab.Value))
                                        {
                                            <article @key="request.Id" class="pill-request" data-request-id="@request.Id" data-request-status="@request.Status">
                                                <span class="pill-avatar" aria-hidden="true">@request.Initials</span>
                                                <div class="pill-request-copy">
                                                    <span class="pill-request-meta">@request.Id · @S.Display(request.When)</span>
                                                    <h3>@S.Display(request.Title)</h3>
                                                    <p>@request.Person</p>
                                                    <div class="pill-request-state"><span class="pill-tag">@S.Display(request.Status == "pending" ? "Pendiente de revisión" : "Aprobada")</span></div>
                                                </div>
                                                @if (request.Status == "pending")
                                                {
                                                    <div class="pill-request-action"><DnetButton id="@($"pill-tabs-approve-{request.Id}")" OnClick="() => ApproveRequest(request.Id)" aria-label="@S.Format("Common.ApproveRequest0", request.Id)">@S["PillTabs.Approve"]</DnetButton></div>
                                                }
                                            </article>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div id="pill-tabs-inbox-empty" class="pill-empty">
                                        <span class="pill-empty-symbol" aria-hidden="true">✓</span>
                                        <strong>@S["PillTabs.AllUpToDate"]</strong>
                                        <p>@S["PillTabs.ThereAreNoPendingRequestsAddAnotherFrom"]</p>
                                    </div>
                                }
                            </div>
                        </ChildContent>
                    </DnetPillTabs>
                </div>
                <aside class="pill-inbox-summary" aria-labelledby="pill-tabs-summary-title">
                    <span class="pill-tag">@S["PillTabs.AnOverview"]</span>
                    <h3 id="pill-tabs-summary-title">@S["PillTabs.TheTeamKeepsMoving"]</h3>
                    <p>@S["PillTabs.AnApprovedRequestMovesToItsNewView"]</p>
                    <dl class="pill-totals">
                        <div><dt>@S["PillTabs.ToReview"]</dt><dd id="pill-tabs-pending-total">@S.Display(PendingCount)</dd></div>
                        <div><dt>@S["PillTabs.Approved"]</dt><dd id="pill-tabs-approved-total">@S.Display(ApprovedCount)</dd></div>
                        <div><dt>@S["PillTabs.InTotal"]</dt><dd id="pill-tabs-all-total">@S.Display(_requests.Count)</dd></div>
                    </dl>
                    <p class="pill-summary-note">@S["PillTabs.TryApproveToSeeAnInboxWithNo"]</p>
                </aside>
            </div>
        </ChildContent>
        <Footer><span class="demo-info">@S["PillTabs.UseArrowsHomeAndEndToNavigateTabs"]</span></Footer>
    </DemoCard>

    <div class="demo-grid">
        <DemoCard Id="pill-tabs-settings-card" Title="@S["PillTabs.APlaceForEverySetting"]" Eyebrow="@S["PillTabs.FullWidth"]"
                  Description="@S["PillTabs.TheBarUsesTheAvailableSpaceARestricted"]">
            <ChildContent>
                <div class="pill-settings-example">
                    <DnetPillTabs Items="Settings" FullWidth="true" AriaLabel="@S["PillTabs.Settings"]" id="pill-tabs-settings">
                        <ChildContent Context="tab">
                            <div class="pill-settings-content">
                                <span class="pill-tag">@S.Text(SettingTag(tab.Value))</span>
                                <h3 id="pill-tabs-setting-value">@S.Display(tab.Label)</h3>
                                <p>@S.Text(SettingDescription(tab.Value))</p>
                                <dl class="pill-setting-facts">
                                    <div><dt>@S["PillTabs.Workspace"]</dt><dd>@S["PillTabs.DesignStudio"]</dd></div>
                                    <div><dt>@S.Text(SettingFactLabel(tab.Value))</dt><dd>@S.Text(SettingFactValue(tab.Value))</dd></div>
                                </dl>
                            </div>
                        </ChildContent>
                    </DnetPillTabs>
                </div>
            </ChildContent>
            <Footer><span class="demo-info">@S["PillTabs.TheNotificationsZeroCounterStaysVisibleRestrictedRequires"]</span></Footer>
        </DemoCard>

        <DemoCard Id="pill-tabs-sync-card" Title="@S["PillTabs.TwoControlsOneSelection"]" Eyebrow="@S["PillTabs.SharedState"]"
                  Description="@S["PillTabs.ChangeTheViewFromThisBarOrThe"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="pill-shared-preview">
                        <DnetPillTabs Items="Statuses" @bind-Value="_status" AriaLabel="@S["PillTabs.SynchronizedState"]" id="pill-tabs-synchronized" />
                    </div>
                    <div class="demo-actions">
                        <DnetButton Variant="DnetButtonVariant.Outlined" OnClick="SelectAll" id="pill-tabs-select-all">@S["PillTabs.SelectAll"]</DnetButton>
                        <DnetButton Variant="DnetButtonVariant.Outlined" OnClick="AddPending" id="pill-tabs-add-pending">@S["PillTabs.AddPending"]</DnetButton>
                        <DnetButton Variant="DnetButtonVariant.Outlined" OnClick="ResetInbox" id="pill-tabs-reset">@S["PillTabs.ResetInbox"]</DnetButton>
                    </div>
                    <div class="pill-shared-summary">
                        <span class="pill-tag">@S["PillTabs.InstantChanges"]</span>
                        <h3>@S["PillTabs.OneInboxSeveralEntryPoints"]</h3>
                        <p>@S["PillTabs.SelectionAndRequestsAreSharedBetweenTheseTwo"]</p>
                    </div>
                </div>
            </ChildContent>
            <Footer><span id="pill-tabs-shared-value" class="demo-value" role="status">@S.Format("Common.SharedSelection01Pending2Approved3In", S.Text(StatusLabel), PendingCount, ApprovedCount, _requests.Count)</span></Footer>
        </DemoCard>

        <DemoCard Id="pill-tabs-overflow-card" Title="@S["PillTabs.MoreOptionsInTheSameSpace"]" Eyebrow="@S["PillTabs.HorizontalScrolling"]"
                  Description="@S["PillTabs.TheBarStaysCompactUseTheTrackpadTouch"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="pill-scroll-example">
                        <DnetPillTabs Items="Statuses" AriaLabel="@S["PillTabs.ScrollableState"]" id="pill-tabs-overflow" />
                    </div>
                    <div class="pill-explanation">
                        <span class="pill-hint-symbol" aria-hidden="true">↔</span>
                        <div><h3>@S["PillTabs.TheEdgePointsTheWay"]</h3><p>@S["PillTabs.TheFadeAppearsOnlyWhereMoreOptionsRemain"]</p></div>
                    </div>
                    <p class="demo-muted">La barra de scroll permanece oculta; el desplazamiento sigue disponible.</p>
                </div>
            </ChildContent>
            <Footer><span class="demo-info">@S["PillTabs.ThisSelectionIsIndependentOfTheInboxAlthough"]</span></Footer>
        </DemoCard>

        <DemoCard Id="pill-tabs-direction-card" Title="@S["PillTabs.TheSameInteractionInAnotherDirection"]" Eyebrow="@S["Spoiler.RightToLeft"]"
                  Description="@S["PillTabs.TheSameStatusesAreArrangedRightToLeft"]">
            <ChildContent>
                <div class="demo-stack">
                    <div class="pill-scroll-example">
                        <DnetPillTabs Items="Statuses" AriaLabel="@S["PillTabs.RightToLeftState"]" dir="rtl" id="pill-tabs-rtl" />
                    </div>
                    <div class="pill-explanation">
                        <span class="pill-hint-symbol" aria-hidden="true">←</span>
                        <div><h3>@S["PillTabs.NavigationThatFollowsYou"]</h3><p>@S["PillTabs.TheLeftArrowMovesToTheNextOption"]</p></div>
                    </div>
                    <p class="demo-muted">@S["PillTabs.YouCanAlsoSwipeHorizontallyWithoutShowingAn"]</p>
                </div>
            </ChildContent>
            <Footer><span class="demo-info">@S["PillTabs.DirectionIsConfiguredOnThisInstanceAndDoes"]</span></Footer>
        </DemoCard>
    </div>
</DemoPage>

@code {
    private string _status = "pending";
    private int _nextRequestId = 1045;
    private List<Request> _requests = InitialRequests();
    private ElementReference _inboxContent;
    private bool _focusInboxAfterApproval;

    private int PendingCount => _requests.Count(request => request.Status == "pending");
    private int ApprovedCount => _requests.Count(request => request.Status == "approved");
    private string StatusLabel => _status switch { "approved" => "Aprobados", "all" => "Todos", _ => "Pendientes" };

    private IReadOnlyList<DnetPillTabItem<string>> Statuses =>
    [
        new("pending", S.Text("Pendientes"), PendingCount),
        new("approved", S.Text("Aprobados"), ApprovedCount),
        new("all", S.Text("Todos"), _requests.Count)
    ];

    private IReadOnlyList<DnetPillTabItem<string>> Settings =>
    [
        new("general", S.Text("General")),
        new("notifications", S.Text("Notificaciones"), 0),
        new("restricted", S.Text("Restringido"), Disabled: true),
        new("history", S.Text("Historial"), 12)
    ];

    private IEnumerable<Request> RequestsFor(string status) => _requests.Where(request => status == "all" || request.Status == status);
    private string ResultCount(string status)
    {
        var count = RequestsFor(status).Count();
        return $"{count} {(count == 1 ? "solicitud" : "solicitudes")}";
    }

    private void SelectAll() => _status = "all";

    private void AddPending()
    {
        var id = _nextRequestId++;
        _requests.Add(new($"RQ-{id}", $"Revisión de recurso {id}", "Equipo de diseño", "ED", "pending", "Ahora"));
    }

    private void ApproveRequest(string id)
    {
        var index = _requests.FindIndex(request => request.Id == id && request.Status == "pending");
        if (index < 0) return;
        _requests[index] = _requests[index] with { Status = "approved", When = "Ahora" };
        _focusInboxAfterApproval = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusInboxAfterApproval) return;
        _focusInboxAfterApproval = false;
        try
        {
            await _inboxContent.FocusAsync(preventScroll: true);
        }
        catch (JSException)
        {
            // Navigation may remove the inbox before focus is restored.
        }
    }

    private void ResetInbox()
    {
        _requests = InitialRequests();
        _nextRequestId = 1045;
        _status = "pending";
    }

    private static List<Request> InitialRequests() =>
    [
        new("RQ-1042", "Acceso al espacio de diseño", "Lucía Marín", "LM", "pending", "Hace 10 min"),
        new("RQ-1043", "Recursos para la nueva campaña", "Diego Torres", "DT", "approved", "Hoy · 09:30"),
        new("RQ-1044", "Revisión del kit de marca", "Nora Vidal", "NV", "approved", "Hoy · 09:15")
    ];

    private static string SettingTag(string value) => value switch
    {
        "notifications" => "Sin avisos pendientes", "history" => "Actividad del espacio", _ => "Tu espacio de trabajo"
    };

    private static string SettingDescription(string value) => value switch
    {
        "notifications" => "Todo al día: no tienes notificaciones pendientes de revisar en este espacio.",
        "history" => "El espacio conserva 12 movimientos recientes para consultar cómo avanza el trabajo del equipo.",
        _ => "Un punto de partida para organizar los recursos, la actividad y las preferencias que comparte el equipo."
    };

    private static string SettingFactLabel(string value) => value switch
    {
        "notifications" => "Avisos por revisar", "history" => "Movimientos registrados", _ => "Acceso"
    };

    private static string SettingFactValue(string value) => value switch
    {
        "notifications" => "0 · Todo al día", "history" => "12 · Disponibles", _ => "Miembros del equipo"
    };

    private sealed record Request(string Id, string Title, string Person, string Initials, string Status, string When);
}
