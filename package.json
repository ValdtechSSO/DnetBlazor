{
  "name": "main-app",
  "version": "0.0.0",
  "scripts": {
    "buildApp": "webpack --config webpack.app.css.js --progress --profile --bail --mode production --env appname=site",
    "buildDnetBlazor": "webpack --config webpack.app.css.js --progress --profile --bail --mode production --env appname=dnetBlazor",
    "lint:css": "node tools/css-tokens/audit.mjs --ci --check-tokens-doc",
    "generate:css-tokens": "node tools/css-tokens/audit.mjs --write-tokens-doc"
  },
  "private": true,
  "dependencies": {
    "@silvia-odwyer/photon": "^0.3.3"
  },
  "devDependencies": {
    "autoprefixer": "10.4.14",
    "copy-webpack-plugin": "11.0.0",
    "css-loader": "6.7.3",
    "mini-css-extract-plugin": "2.7.5",
    "minimist": "1.2.8",
    "postcss-loader": "7.1.0",
    "webpack": "5.76.3",
    "webpack-cli": "5.0.1"
  }
}
