@using Dnet.Blazor.Localization
@namespace Dnet.Blazor.Components.PickList
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Dnet.Blazor.Components.Paginator
@using Dnet.Blazor.Components.Button
@using Dnet.Blazor.Components.SlideToggle
@using Dnet.Blazor.Components.Form
@typeparam TItem
@typeparam TKey where TKey : notnull

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<section class="dnet-pick-list" aria-busy="@_isLoading">
    <div class="dnet-pick-list-search">
        @* Filtering is internal UI state and must not mark a surrounding form as modified. *@
        <CascadingValue TValue="EditContext" Value="@((EditContext?)null)" IsFixed="true">
            <DnetFormField @key="_searchRenderGeneration" Label="@EffectiveStrings.SearchPlaceholder" UseClearButton="true">
                <PrefixContent>
                    <span class="dnet-list-search-icon dnet-list-search-icon-default" aria-hidden="true"></span>
                </PrefixContent>
                <ChildContent>
                    <DnetInputText Value="@EffectiveSearchText"
                                   ValueChanged="SetSearchTextAsync"
                                   ValueExpression="@(() => EffectiveSearchText!)"
                                   PlaceHolder="@EffectiveStrings.SearchPlaceholder"
                                   role="searchbox"
                                   aria-label="@EffectiveStrings.SearchPlaceholder" />
                </ChildContent>
            </DnetFormField>
        </CascadingValue>
    </div>

    <div class="dnet-pick-list-toolbar">
        <output class="dnet-pick-list-counter">
            @EffectiveStrings.SelectedLabel: @SelectedKeys.Count / @(_totalCount?.ToString() ?? "—")
        </output>
        <div class="dnet-pick-list-actions">
            <DnetButton Size="DnetButtonSize.Medium" Variant="DnetButtonVariant.Outlined"
                        disabled="@(!CanSelectVisible)"
                        OnClick="SelectVisibleAsync">
                @EffectiveStrings.SelectVisibleLabel
            </DnetButton>
            <DnetButton Size="DnetButtonSize.Medium" Variant="DnetButtonVariant.Outlined"
                        disabled="@(SelectedKeys.Count == 0)"
                        OnClick="ClearSelectionAsync">
                @EffectiveStrings.ClearLabel
            </DnetButton>
        </div>
    </div>

    <div class="dnet-pick-list-items" aria-live="polite">
        @if (_isLoading && _visibleItems.Count == 0)
        {
            <p class="dnet-pick-list-status" role="status">@EffectiveStrings.LoadingLabel</p>
        }
        else if (IsNoResults)
        {
            <p class="dnet-pick-list-status">@EffectiveStrings.NoResultsLabel</p>
        }
        else if (IsEmpty)
        {
            <p class="dnet-pick-list-status">@EffectiveStrings.EmptyLabel</p>
        }
        else
        {
            @foreach (var item in _visibleItems)
            {
                var key = ItemKey(item);
                var selected = SelectedKeys.Contains(key);

                <div class="dnet-pick-list-item @(selected ? "dnet-pick-list-item-selected" : null)">
                    <DnetSlideToggle @key="(key, _selectionRenderGeneration)"
                                     Value="@selected"
                                     ValueExpression="@(() => selected)"
                                     ValueChanged="(bool value) => SetSelectedAsync(key, value)"
                                     Disabled="@(_isLoading || IsSelectionDisabled(item))"
                                     TextPlacedBefore="true"
                                     FullWidth="true">
                        <span class="dnet-pick-list-item-content">@ItemTemplate(item)</span>
                    </DnetSlideToggle>
                </div>
            }
        }
    </div>

    <footer class="dnet-pick-list-footer">
        <DnetPaginator CurrentPage="@(_pageIndex + 1)"
                       GridGap="8"
                       PageSize="@PageSize"
                       TotalItems="@(_filteredCount ?? 0)"
                       Disabled="@(_isLoading || !HasKnownPages || PageCount == 0)"
                       PaginationLabel="@EffectiveStrings.PaginationLabel"
                       PageText="@EffectiveStrings.PageText"
                       OfText="@EffectiveStrings.OfText"
                       PageInputLabel="@GetCurrentPageLabel()"
                       FirstPageLabel="@EffectiveStrings.FirstPageLabel"
                       PreviousPageLabel="@EffectiveStrings.PreviousPageLabel"
                       NextPageLabel="@EffectiveStrings.NextPageLabel"
                       LastPageLabel="@EffectiveStrings.LastPageLabel"
                       OnGoToFirstPage="GoToPaginatorPageAsync"
                       OnGoToPreviousPage="GoToPaginatorPageAsync"
                       OnGoToNextPage="GoToPaginatorPageAsync"
                       OnGoToLastPage="GoToPaginatorPageAsync"
                       OnGoToSpecificPage="GoToPaginatorPageAsync" />
    </footer>
</section>
