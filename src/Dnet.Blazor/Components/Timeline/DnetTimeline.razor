@using Dnet.Blazor.Localization
@inject IServiceProvider LocalizationServices
@using Dnet.Blazor.Infrastructure.Forms

<DnetLocalizationObserver OnChanged="@(() => InvokeAsync(StateHasChanged))" />

<ol @attributes="AdditionalAttributes" class="@CssClass" role="list" aria-label="@(_ariaLabelProvided ? _ariaLabel : Localizer["Timeline.Label"])">
    @ChildContent
</ol>

@code {
    private IDnetLocalizer Localizer => DnetLocalization.Get(LocalizationServices);

    /// <summary>Gets or sets the position of the rail. Start and End follow the text direction.</summary>
    [Parameter]
    public DnetTimelineAlignment Alignment { get; set; } = DnetTimelineAlignment.Start;

    /// <summary>Gets or sets the accessible name of the ordered list.</summary>
    [Parameter]
    public string? AriaLabel
    {
        get => _ariaLabelProvided ? _ariaLabel : "Timeline";
        set { _ariaLabel = value; _ariaLabelProvided = true; }
    }

    private string? _ariaLabel;
    private bool _ariaLabelProvided;

    /// <summary>Gets or sets the DnetTimelineItem components in chronological or process order.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets unmatched attributes, including class, style, id and dir, on the ordered list.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => DnetAttributeUtilities.CombineClassNames(AdditionalAttributes,
        $"dnet-timeline dnet-timeline-align-{Alignment.ToString().ToLowerInvariant()}");

    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(Alignment))
            throw new ArgumentOutOfRangeException(nameof(Alignment), Alignment, "Unknown timeline alignment.");
    }
}
