@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@using Dnet.Blazor.Components.DatePicker.Infrastructure.Enums
@using Dnet.Blazor.Components.DatePicker.Infrastructure.Models
@using Dnet.Blazor.Components.Form
@using Dnet.Blazor.Components.Overlay.Infrastructure.Enums
@using Dnet.Blazor.Components.Overlay.Infrastructure.Interfaces
@using Dnet.Blazor.Components.Overlay.Infrastructure.Models
@using Dnet.Blazor.Components.Overlay.Infrastructure.Services
@using Dnet.Blazor.Infrastructure.Forms
@using Dnet.Blazor.Infrastructure.Services.CssBuilder
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop

@inherits Dnet.Blazor.Infrastructure.Forms.DnetInputBase<string>
@implements IDisposable

@inject IOverlayService OverlayService
@inject IJSRuntime JSRuntime

<input @ref="Element"
       @attributes="AdditionalAttributes"
       class="@InputClass"
       type="text"
       autocomplete="off"
       value="@CurrentValueAsString"
       placeholder="@PlaceHolder"
       disabled="@Disabled"
       readonly="@ReadOnly"
       required="@Required"
       role="combobox"
       aria-haspopup="dialog"
       aria-expanded="@(IsOpen ? "true" : "false")"
       aria-controls="@PanelId"
       aria-label="@ResolvedInputAriaLabel"
       aria-required="@(Required ? "true" : null)"
       @onfocusin="HandleFocusInAsync"
       @onclick="HandleInputClickAsync"
       @onfocus="HandleFocus"
       @onblur="HandleBlur"
       @oninput="HandleInputAsync"
       @onkeydown="HandleKeyDownAsync" />

@code {
    private OverlayReference? _menuReference;
    private IFormEventService? _formEventService;
    private DateOnly? _pendingDate;
    private bool _hasFocus;
    private bool _previousDisabled;
    private bool _overlayUsesTouch;
    private DateTime _suppressFocusOpenUntilUtc;

    [CascadingParameter] private FormFieldCascadingValues? FormFieldValues { get; set; }
    [CascadingParameter(Name = "DnetThemeScope")] private string? ThemeScope { get; set; }

    [DisallowNull] public ElementReference? Element { get; protected set; }

    /// <summary>Raised when parsing or date validation fails.</summary>
    [Parameter] public EventCallback<string> OnError { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool CalendarDisabled { get; set; }
    [Parameter] public bool ToggleDisabled { get; set; }
    [Parameter] public bool OpenOnFocus { get; set; } = true;
    [Parameter] public string Format { get; set; } = "yyyy/MM/dd";
    [Parameter] public string[] Formats { get; set; } = ["yyyy/MM/dd", "yyyy/M/dd", "yyyy/MM/d"];
    [Parameter] public CultureInfo? Culture { get; set; }
    [Parameter] public DateTime? MaxDayValue { get; set; }
    [Parameter] public DateTime? MinDayValue { get; set; }
    [Parameter] public DateTime? FirstDayToShow { get; set; }
    [Parameter] public Func<CalendarDay, bool>? DatepickerFilter { get; set; }
    [Parameter] public Func<DateOnly, bool>? IsDateEnabled { get; set; }
    [Parameter] public EventCallback<CalendarDay> OnDaySelected { get; set; }
    [Parameter] public EventCallback<string?> OnDateInput { get; set; }
    [Parameter] public EventCallback<CalendarDay> OnDateChange { get; set; }
    [Parameter] public EventCallback<int> OnYearSelected { get; set; }
    [Parameter] public EventCallback<DateOnly> OnMonthSelected { get; set; }
    [Parameter] public EventCallback<DnetCalendarView> OnViewChanged { get; set; }
    [Parameter] public EventCallback OnOpened { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public DnetCalendarView StartView { get; set; } = DnetCalendarView.Month;
    [Parameter] public DayOfWeek? FirstDayOfWeek { get; set; }
    [Parameter] public Func<DateOnly, string?>? DateClass { get; set; }
    [Parameter] public RenderFragment<DnetCalendarCellContext>? DayContent { get; set; }
    [Parameter] public RenderFragment<DnetCalendarHeaderContext>? HeaderContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public bool ShowActions { get; set; }
    [Parameter] public bool ShowReset { get; set; } = true;
    [Parameter] public DnetDatePickerLabels Labels { get; set; } = new();
    [Parameter] public bool TouchUi { get; set; }
    [Parameter] public bool Responsive { get; set; } = true;
    [Parameter] public int ResponsiveBreakpoint { get; set; } = 600;
    [Parameter] public bool RestoreFocus { get; set; } = true;
    [Parameter] public string? PanelClass { get; set; }
    [Parameter] public string? PanelStyle { get; set; }
    [Parameter] public string? BorderRadius { get; set; }
    [Parameter] public string? MarginTop { get; set; }
    [Parameter] public string? PlaceHolder { get; set; }
    [Parameter] public bool ShowInternalErrors { get; set; } = true;

    /// <summary>Gets whether the calendar overlay is currently open.</summary>
    public bool IsOpen { get; private set; }

    private CultureInfo EffectiveCulture => Culture ?? CultureInfo.CurrentCulture;
    private DateOnly? Min => MinDayValue.HasValue ? DateOnly.FromDateTime(MinDayValue.Value) : null;
    private DateOnly? Max => MaxDayValue.HasValue ? DateOnly.FromDateTime(MaxDayValue.Value) : null;
    private DateOnly? StartAt => FirstDayToShow.HasValue ? DateOnly.FromDateTime(FirstDayToShow.Value) : null;
    private string? PanelId => _menuReference is null ? null : $"cdk-overlay-pane-{_menuReference.GetOverlayReferenceId()}";
    private string ResolvedInputAriaLabel => AdditionalAttributes?.TryGetValue("aria-label", out var label) == true
        ? Convert.ToString(label, CultureInfo.InvariantCulture) ?? Labels.ChooseDate
        : Labels.ChooseDate;
    private string InputClass => new CssBuilder("mat-input-element dnet-datepicker-input").AddClass(CssClass).Build();
    private string[] AcceptedFormats => new[] { Format }.Concat(Formats ?? []).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.Ordinal).ToArray();

    protected override void OnInitialized()
    {
        _formEventService = FormFieldValues?.FormEventService;
        _formEventService?.RaiseCurrentValue(CurrentValueAsString);
        _formEventService?.RaiseDisabledEvent(Disabled);
        if (_formEventService is not null)
        {
            _formEventService.OnClearContent += ClearInput;
            _formEventService.OnSufixContentClicked += HandleSuffixClicked;
        }

        if (!string.IsNullOrWhiteSpace(CurrentValue)) UpdateFocusState(true);
        _previousDisabled = Disabled;
        if (EditContext is not null) EditContext.OnFieldChanged += HandleFieldChanged;
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Format)) throw new ArgumentException("DatePicker Format cannot be empty.", nameof(Format));
        if (Min.HasValue && Max.HasValue && Min > Max) throw new ArgumentException("DatePicker MinDayValue cannot be later than MaxDayValue.");
        if (ResponsiveBreakpoint < 1) throw new ArgumentOutOfRangeException(nameof(ResponsiveBreakpoint));
        if (_previousDisabled != Disabled)
        {
            _previousDisabled = Disabled;
            _formEventService?.RaiseDisabledEvent(Disabled);
            if (Disabled) DetachMenu();
        }
    }

    protected override string? FormatValueAsString(string? value) => value;

    protected override bool TryParseValueFromString(string? value, out string result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            result = string.Empty;
            validationErrorMessage = null;
            return true;
        }

        if (!TryParseDate(value, out var date))
        {
            result = string.Empty;
            validationErrorMessage = $"Enter a valid date using {string.Join(", ", AcceptedFormats)}.";
            return false;
        }

        if (!ValidateDate(date, out validationErrorMessage))
        {
            result = string.Empty;
            return false;
        }

        result = date.ToDateTime(TimeOnly.MinValue).ToString(Format, EffectiveCulture);
        return true;
    }

    public async Task OpenAsync()
    {
        if (IsOpen || Disabled || ToggleDisabled) return;
        var touch = TouchUi || (Responsive && await JSRuntime.InvokeAsync<bool>("dnetinterop.matchesMedia", $"(max-width: {ResponsiveBreakpoint}px)"));
        _overlayUsesTouch = touch;
        _pendingDate = ParseCurrentDate();
        var config = CreateOverlayConfig(touch);
        RenderFragment content = builder => BuildPanel(builder, touch);
        _menuReference = OverlayService.Attach(content, config);
        _menuReference.Close += HandleOverlayClosed;
        IsOpen = true;
        await OnOpened.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    public Task CloseAsync()
    {
        DetachMenu();
        return Task.CompletedTask;
    }

    public Task ToggleAsync() => IsOpen ? CloseAsync() : OpenAsync();

    private OverlayConfig CreateOverlayConfig(bool touch)
    {
        var panelClass = string.Join(" ", new[] { "dnet-datepicker-overlay", touch ? "dnet-datepicker-overlay-touch" : null, PanelClass }.Where(x => !string.IsNullOrWhiteSpace(x)));
        if (touch)
        {
            return new OverlayConfig
            {
                HasBackdrop = true,
                ScrollStrategy = OverlayScrollStrategy.Block,
                CloseOnEscape = true,
                Role = "dialog",
                AriaModal = true,
                AriaLabel = Labels.Calendar,
                Direction = EffectiveCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr",
                TrapFocus = true,
                RestoreFocus = RestoreFocus,
                InitialFocusSelector = "[role='gridcell'][tabindex='0']",
                PositionStrategy = PositionStrategy.Global,
                GlobalPositionStrategy = new GlobalPositionStrategyBuilder().CenterHorizontally("0").CenterVertically("0"),
                Width = "min(100% - 24px, 360px)",
                MaxHeight = "calc(100dvh - 24px)",
                PanelClass = panelClass,
                PanelStyle = PanelStyle,
                ComponentType = ComponentType.DatePicker,
                ThemeScope = ThemeScope
            };
        }

        var origin = FormFieldValues?.FormField ?? Element!.Value;
        var positions = new List<ConnectedPosition>
        {
            new() { OriginX = HorizontalConnectionPos.Start, OriginY = VerticalConnectionPos.Bottom, OverlayX = HorizontalConnectionPos.Start, OverlayY = VerticalConnectionPos.Top, OffsetY = 6 },
            new() { OriginX = HorizontalConnectionPos.Start, OriginY = VerticalConnectionPos.Top, OverlayX = HorizontalConnectionPos.Start, OverlayY = VerticalConnectionPos.Bottom, OffsetY = -6 },
            new() { OriginX = HorizontalConnectionPos.End, OriginY = VerticalConnectionPos.Bottom, OverlayX = HorizontalConnectionPos.End, OverlayY = VerticalConnectionPos.Top, OffsetY = 6 }
        };
        return new OverlayConfig
        {
            HasBackdrop = true,
            HasTransparentBackdrop = true,
            CloseOnEscape = true,
            ScrollStrategy = OverlayScrollStrategy.Reposition,
            Role = "dialog",
            AriaLabel = Labels.Calendar,
            Direction = EffectiveCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr",
            RestoreFocus = RestoreFocus,
            PositionStrategy = PositionStrategy.FlexibleConnectedTo,
            FlexibleConnectedPositionStrategyBuilder = new FlexibleConnectedPositionStrategyBuilder().WithLockedPosition().WithViewportMargin(8).SetOrigin(origin).WithFlexibleDimensions(false).WithPositions(positions),
            Width = "var(--dnet-datepicker-panel-width, 296px)",
            MaxHeight = "calc(100vh - 16px)",
            MarginTop = MarginTop,
            PanelClass = panelClass,
            PanelStyle = PanelStyle,
            ComponentType = ComponentType.DatePicker,
            ThemeScope = ThemeScope
        };
    }

    private void BuildPanel(RenderTreeBuilder builder, bool touch)
    {
        var sequence = 0;
        builder.OpenComponent<DnetDatePickerPanel>(sequence++);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.Value), _pendingDate);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.Min), Min);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.Max), Max);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.StartAt), StartAt);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.StartView), StartView);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.FirstDayOfWeek), FirstDayOfWeek);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.Culture), EffectiveCulture);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.IsDateEnabled), EffectiveDateFilter);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.DateClass), DateClass);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.Labels), Labels);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.Disabled), CalendarDisabled);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.TouchUi), touch);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.ShowActions), ShowActions || touch);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.ShowReset), ShowReset);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.DayContent), DayContent);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.HeaderContent), HeaderContent);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.FooterContent), FooterContent);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.DateSelected), EventCallback.Factory.Create<DateOnly>(this, HandleDateSelectedAsync));
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.YearSelected), OnYearSelected);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.MonthSelected), OnMonthSelected);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.ViewChanged), OnViewChanged);
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.DateApplied), EventCallback.Factory.Create<DateOnly?>(this, ApplyDateAsync));
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.Cancel), EventCallback.Factory.Create(this, CloseAsync));
        builder.AddAttribute(sequence++, nameof(DnetDatePickerPanel.Reset), EventCallback.Factory.Create(this, ResetAsync));
        builder.CloseComponent();
    }

    private async Task HandleDateSelectedAsync(DateOnly date)
    {
        _pendingDate = date;
        if (!(ShowActions || _overlayUsesTouch))
        {
            await CommitDateAsync(date);
            DetachMenu(CloseReason.Ok);
        }
    }

    private async Task ApplyPendingAsync()
    {
        if (_pendingDate.HasValue) await CommitDateAsync(_pendingDate.Value);
        DetachMenu(CloseReason.Ok);
    }

    private async Task ApplyDateAsync(DateOnly? date)
    {
        _pendingDate = date;
        await ApplyPendingAsync();
    }

    private async Task CommitDateAsync(DateOnly date)
    {
        var text = date.ToDateTime(TimeOnly.MinValue).ToString(Format, EffectiveCulture);
        CurrentValue = text;
        _formEventService?.RaiseCurrentValue(text);
        UpdateFocusState(true);
        var day = ToCalendarDay(date, text);
        await OnDaySelected.InvokeAsync(day);
        await OnDateChange.InvokeAsync(day);
        UpdateErrorState();
    }

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        if (Disabled || ReadOnly) return;
        var text = args.Value?.ToString();
        CurrentValueAsString = text;
        _formEventService?.RaiseCurrentValue(CurrentValueAsString);
        await OnDateInput.InvokeAsync(text);
        if (!string.IsNullOrWhiteSpace(text) && !TryParseValueFromString(text, out _, out var error)) await RaiseErrorAsync(error!);
        UpdateErrorState();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (Disabled) return;
        if (args.Key is "ArrowDown" && !IsOpen) await OpenAsync();
        else if (args.Key is "Escape" && IsOpen) await CloseAsync();
        else if (args.Key is "Enter" && TryParseDate(CurrentValueAsString, out var date) && ValidateDate(date, out _))
        {
            await CommitDateAsync(date);
            if (IsOpen) DetachMenu(CloseReason.Ok);
        }
    }

    private async Task HandleFocusInAsync()
    {
        if (!OpenOnFocus) return;
        if (DateTime.UtcNow < _suppressFocusOpenUntilUtc) return;
        await Task.Delay(50);
        if (DateTime.UtcNow < _suppressFocusOpenUntilUtc) return;
        if (_hasFocus && !IsOpen) await OpenAsync();
    }

    private Task HandleInputClickAsync() => OpenOnFocus ? OpenAsync() : Task.CompletedTask;

    private void HandleFocus() => UpdateFocusState(true);
    private void HandleBlur()
    {
        _hasFocus = false;
        if (string.IsNullOrWhiteSpace(CurrentValueAsString)) UpdateFocusState(false);
        UpdateErrorState();
    }

    private void HandleSuffixClicked()
    {
        if (!Disabled && !ToggleDisabled) _ = InvokeAsync(ToggleAsync);
    }

    private void ClearInput() => _ = InvokeAsync(ResetAsync);

    private async Task ResetAsync()
    {
        CurrentValue = string.Empty;
        _pendingDate = null;
        _formEventService?.RaiseCurrentValue(string.Empty);
        UpdateFocusState(false);
        await OnDaySelected.InvokeAsync(new CalendarDay());
        DetachMenu(CloseReason.Ok);
        StateHasChanged();
    }

    private bool EffectiveDateFilter(DateOnly date)
    {
        if (IsDateEnabled is not null && !IsDateEnabled(date)) return false;
        return DatepickerFilter is null || !DatepickerFilter(ToCalendarDay(date, null));
    }

    private bool ValidateDate(DateOnly date, out string? error)
    {
        if (Min.HasValue && date < Min) { error = $"Date must be on or after {Min.Value.ToString(Format, EffectiveCulture)}."; return false; }
        if (Max.HasValue && date > Max) { error = $"Date must be on or before {Max.Value.ToString(Format, EffectiveCulture)}."; return false; }
        if (!EffectiveDateFilter(date)) { error = "This date is not available."; return false; }
        error = null;
        return true;
    }

    private bool TryParseDate(string? value, out DateOnly date)
    {
        if (DateOnly.TryParseExact(value, AcceptedFormats, EffectiveCulture, DateTimeStyles.AllowWhiteSpaces, out date)) return true;
        return DateOnly.TryParse(value, EffectiveCulture, DateTimeStyles.AllowWhiteSpaces, out date);
    }

    private DateOnly? ParseCurrentDate() => TryParseDate(CurrentValue, out var date) ? date : null;

    private static CalendarDay ToCalendarDay(DateOnly date, string? formatted) => new()
    {
        Date = date.ToDateTime(TimeOnly.MinValue), Year = date.Year, Month = date.Month, DayNumber = date.Day,
        DayName = date.DayOfWeek.ToString(), DayIndex = (int)date.DayOfWeek,
        IsToday = date == DateOnly.FromDateTime(DateTime.Today), FormattedDate = formatted
    };

    private async Task RaiseErrorAsync(string message)
    {
        if (OnError.HasDelegate) await OnError.InvokeAsync(message);
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs args)
    {
        if (args.FieldIdentifier.Equals(FieldIdentifier)) UpdateErrorState();
    }

    private void UpdateErrorState()
    {
        if (!ShowInternalErrors || EditContext is null) return;
        _formEventService?.RaiseError(EditContext.GetValidationMessages(FieldIdentifier).Any() && EditContext.IsModified(FieldIdentifier));
    }

    private void UpdateFocusState(bool focused)
    {
        _hasFocus = focused;
        _formEventService?.RaiseFocus(focused);
    }

    private void HandleOverlayClosed(OverlayResult result)
    {
        SuppressFocusReopen();
        IsOpen = false;
        if (_menuReference is not null)
        {
            _menuReference.Close -= HandleOverlayClosed;
            _menuReference = null;
        }
        _ = InvokeAsync(async () => { await OnClosed.InvokeAsync(); StateHasChanged(); });
    }

    private void DetachMenu(CloseReason reason = CloseReason.Cancel)
    {
        if (_menuReference is null) { IsOpen = false; return; }
        SuppressFocusReopen();
        var reference = _menuReference;
        reference.Close -= HandleOverlayClosed;
        _menuReference = null;
        IsOpen = false;
        reference.Detach(reason);
        _ = InvokeAsync(async () => { await OnClosed.InvokeAsync(); StateHasChanged(); });
    }

    private void SuppressFocusReopen() => _suppressFocusOpenUntilUtc = DateTime.UtcNow.AddMilliseconds(300);

    public void Dispose()
    {
        if (_menuReference is not null)
        {
            _menuReference.Close -= HandleOverlayClosed;
            _menuReference.Detach();
            _menuReference = null;
        }
        if (EditContext is not null) EditContext.OnFieldChanged -= HandleFieldChanged;
        if (_formEventService is not null)
        {
            _formEventService.OnClearContent -= ClearInput;
            _formEventService.OnSufixContentClicked -= HandleSuffixClicked;
        }
        DisposeInputBase();
    }
}
