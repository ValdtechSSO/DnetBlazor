@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Dnet.Blazor.Components.DatePicker.Infrastructure.Enums
@using Dnet.Blazor.Components.DatePicker.Infrastructure.Interfaces
@using Dnet.Blazor.Components.DatePicker.Infrastructure.Models
@using Dnet.Blazor.Components.DatePicker.Infrastructure.Services

<div class="dnet-datepicker-content @(TouchUi ? "dnet-datepicker-touch" : null)">
    <DnetCalendar Value="_localValue"
                  Range="_localRange"
                  PreviewRange="_localPreviewRange"
                  ComparisonRange="ComparisonRange"
                  RangeSelection="RangeSelection"
                  Min="Min"
                  Max="Max"
                  StartAt="StartAt"
                  StartView="StartView"
                  FirstDayOfWeek="FirstDayOfWeek"
                  Culture="Culture"
                  IsDateEnabled="EffectiveDateFilter"
                  DateClass="DateClass"
                  RangeSelectionStrategy="RangeSelectionStrategy"
                  Labels="Labels"
                  Disabled="Disabled"
                  AutoFocus="AutoFocus"
                  DayContent="DayContent"
                  HeaderContent="HeaderContent"
                  DateSelected="HandleDateSelectedAsync"
                  RangeChanged="HandleRangeChangedAsync"
                  PreviewRangeChanged="HandlePreviewChangedAsync"
                  YearSelected="YearSelected"
                  MonthSelected="MonthSelected"
                  ViewChanged="ViewChanged"
                  EscapePressed="Cancel">
        <FooterContent>
            @if (FooterContent is not null)
            {
                @FooterContent
            }
        </FooterContent>
    </DnetCalendar>

    @if (ShowActions)
    {
        <div class="dnet-datepicker-actions">
            <button type="button" class="dnet-datepicker-action dnet-datepicker-action-secondary" @onclick="HandleCancelAsync">@Labels.Cancel</button>
            <button type="button" class="dnet-datepicker-action dnet-datepicker-action-primary" @onclick="HandleApplyClickAsync">@Labels.Apply</button>
        </div>
    }
    else if (ShowReset)
    {
        <div class="dnet-calendar-header-footer">
            <button type="button" class="dnet-datepicker-reset-button-wrapper" @onclick="ResetAsync">
                <span class="dnet-datepicker-icon dnet-datepicker-reset-button" aria-hidden="true"></span>
                <span>@Labels.Reset</span>
            </button>
        </div>
    }
</div>

@code {
    private DateOnly? _localValue;
    private DnetDateRange _localRange = new();
    private DnetDateRange _localPreviewRange = new();
    private bool _initialized;

    [Parameter] public DateOnly? Value { get; set; }
    [Parameter] public DnetDateRange? Range { get; set; }
    [Parameter] public DnetDateRange? PreviewRange { get; set; }
    [Parameter] public DnetDateRange? ComparisonRange { get; set; }
    [Parameter] public bool RangeSelection { get; set; }
    [Parameter] public DateOnly? Min { get; set; }
    [Parameter] public DateOnly? Max { get; set; }
    [Parameter] public DateOnly? StartAt { get; set; }
    [Parameter] public DnetCalendarView StartView { get; set; }
    [Parameter] public DayOfWeek? FirstDayOfWeek { get; set; }
    [Parameter] public CultureInfo? Culture { get; set; }
    [Parameter] public Func<DateOnly, bool>? IsDateEnabled { get; set; }
    [Parameter] public Func<DateOnly, string?>? DateClass { get; set; }
    [Parameter] public IDnetDateRangeSelectionStrategy? RangeSelectionStrategy { get; set; }
    [Parameter] public DnetDatePickerLabels Labels { get; set; } = new();
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AutoFocus { get; set; } = true;
    [Parameter] public bool TouchUi { get; set; }
    [Parameter] public bool ShowActions { get; set; }
    [Parameter] public bool ShowReset { get; set; } = true;
    [Parameter] public RenderFragment<DnetCalendarCellContext>? DayContent { get; set; }
    [Parameter] public RenderFragment<DnetCalendarHeaderContext>? HeaderContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public EventCallback<DateOnly> DateSelected { get; set; }
    [Parameter] public EventCallback<DnetDateRange> RangeChanged { get; set; }
    [Parameter] public EventCallback<DnetDateRange> PreviewRangeChanged { get; set; }
    [Parameter] public EventCallback<int> YearSelected { get; set; }
    [Parameter] public EventCallback<DateOnly> MonthSelected { get; set; }
    [Parameter] public EventCallback<DnetCalendarView> ViewChanged { get; set; }
    [Parameter] public EventCallback<DateOnly?> DateApplied { get; set; }
    [Parameter] public EventCallback<DnetDateRange> RangeApplied { get; set; }
    [Parameter] public EventCallback Apply { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    [Parameter] public EventCallback Reset { get; set; }

    // Legacy panel parameters retained for source compatibility.
    [Parameter] public DatePickerService? DatePickerService { get; set; }
    [Parameter] public CalendarDay? SelectedDay { get; set; }
    [Parameter] public DateTime? MaxDayValue { get; set; }
    [Parameter] public DateTime? MinDayValue { get; set; }
    [Parameter] public DateTime? FirstDayToShow { get; set; }
    [Parameter] public Func<CalendarDay, bool>? DatepickerFilter { get; set; }
    [Parameter] public string? BorderRadius { get; set; }

    private Func<DateOnly, bool> EffectiveDateFilter => date =>
    {
        if (IsDateEnabled is not null && !IsDateEnabled(date)) return false;
        if (DatepickerFilter is null) return true;
        return !DatepickerFilter(ToCalendarDay(date));
    };

    protected override void OnParametersSet()
    {
        Value ??= SelectedDay is { DayNumber: > 0 }
            ? new DateOnly(SelectedDay.Year, SelectedDay.Month, SelectedDay.DayNumber)
            : null;
        Min ??= MinDayValue.HasValue ? DateOnly.FromDateTime(MinDayValue.Value) : null;
        Max ??= MaxDayValue.HasValue ? DateOnly.FromDateTime(MaxDayValue.Value) : null;
        StartAt ??= FirstDayToShow.HasValue ? DateOnly.FromDateTime(FirstDayToShow.Value) : null;
        if (!_initialized)
        {
            _localValue = Value;
            _localRange = Range ?? new DnetDateRange();
            _localPreviewRange = PreviewRange ?? new DnetDateRange();
            _initialized = true;
        }
    }

    private async Task HandleDateSelectedAsync(DateOnly date)
    {
        _localValue = date;
        DatePickerService?.UpdateSelectedDay(ToCalendarDay(date));
        if (!ShowActions)
        {
            await DateSelected.InvokeAsync(date);
        }
    }

    private async Task HandleRangeChangedAsync(DnetDateRange range)
    {
        _localRange = range;
        _localPreviewRange = new DnetDateRange();
        if (!ShowActions && range.IsComplete)
        {
            await RangeChanged.InvokeAsync(range);
        }
    }

    private Task HandlePreviewChangedAsync(DnetDateRange range)
    {
        _localPreviewRange = range;
        return Task.CompletedTask;
    }

    private async Task ResetAsync()
    {
        DatePickerService?.UpdateSelectedDay(new CalendarDay());
        await Reset.InvokeAsync();
    }

    private async Task ApplySelectionAsync()
    {
        if (RangeSelection)
        {
            await RangeApplied.InvokeAsync(_localRange);
        }
        else
        {
            await DateApplied.InvokeAsync(_localValue);
        }

        await Apply.InvokeAsync();
    }

    private Task HandleApplyClickAsync(MouseEventArgs _) => ApplySelectionAsync();

    private Task HandleCancelAsync(MouseEventArgs _) => Cancel.InvokeAsync();

    private static CalendarDay ToCalendarDay(DateOnly date) => new()
    {
        Date = date.ToDateTime(TimeOnly.MinValue),
        Year = date.Year,
        Month = date.Month,
        DayNumber = date.Day,
        DayName = date.DayOfWeek.ToString(),
        DayIndex = (int)date.DayOfWeek,
        IsToday = date == DateOnly.FromDateTime(DateTime.Today)
    };
}
