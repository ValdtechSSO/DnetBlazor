@using Dnet.Blazor.Localization
@inject IServiceProvider LocalizationServices
@using Dnet.Blazor.Components.Chips
@using Dnet.Blazor.Components.FloatingDoubleList.Infrastructure.Models;
@using Dnet.Blazor.Components.FloatingDoubleList.Infrastructure.Services;
@using Dnet.Blazor.Components.Form
@using Dnet.Blazor.Components.Grid.Infrastructure.Entities;
@using Dnet.Blazor.Components.List;
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using System.Timers
@using System.Diagnostics.CodeAnalysis
@using Dnet.Blazor.Components.Overlay.Infrastructure.Enums
@using Dnet.Blazor.Components.Overlay.Infrastructure.Interfaces
@using Dnet.Blazor.Components.Overlay.Infrastructure.Models
@using Dnet.Blazor.Components.Overlay.Infrastructure.Services
@using Dnet.Blazor.Components.Select.Infrastructure.Services
@using Dnet.Blazor.Infrastructure.Services.CssBuilder
@using System.Globalization;
@using System.Reflection;
@using System.Linq.Expressions;
@using Dnet.Blazor.Infrastructure.Models.SearchModels;
@using Microsoft.JSInterop

@implements IDisposable

@typeparam TItem

@inherits Dnet.Blazor.Infrastructure.Forms.DnetInputBase<string>

@inject IOverlayService OverlayService


<DnetLocalizationObserver OnChanged="HandleLocalizationChanged" />
<div @ref="_focusTrigger"
     class="dnet-plain-select"
     role="combobox"
     tabindex="@(Disabled ? -1 : 0)"
     aria-haspopup="dialog"
     aria-label="@(DisplayName ?? Localizer["FloatingDoubleList.Label"])"
     aria-expanded="@(_isOpen ? "true" : "false")"
     aria-controls="@(_isOpen && _menuReference is not null ? $"cdk-overlay-pane-{_menuReference.GetOverlayReferenceId()}" : null)"
     aria-disabled="@(Disabled ? "true" : "false")"
     @onclick="OpenMenu"
     @onkeydown="HandleKeyDown">
    <div @ref="_menuTrigger"
         class="dnet-plain-select-trigger" style="width: 100%">
        <div class="dnet-plain-select-value">
            <div class="dnet-floating-doublelist-value-wrapper" style="height: @(InputItemHeight)px">
                @* One inline run: the values used to be flex items that wrapped onto a
                   second line and were clipped by the fixed height. *@
                <span class="dnet-floating-doublelist-value-text">
                    @foreach (var item in _itemsToshow)
                    {
                        <span class="dnet-select-multi-value">@DisplayValueConverter(item) <span> - </span></span>
                    }
                </span>
            </div>
        </div>
    </div>
</div>



@code {
    private IDnetLocalizer Localizer => DnetLocalization.Get(LocalizationServices);
    private Task HandleLocalizationChanged() => InvokeAsync(() => { RefreshOverlayLabel(); StateHasChanged(); });

    private void RefreshOverlayLabel()
    {
        if (_menuReference?.Config is not { } config) return;
        var label = DisplayName ?? Localizer["FloatingDoubleList.Label"];
        if (config.AriaLabel == label) return;
        config.AriaLabel = label;
        _menuReference.RequestConfigurationUpdate();
    }


    [CascadingParameter]
    private FormFieldCascadingValues? _formFieldCascadingValues { get; set; }

    [CascadingParameter(Name = "DnetThemeScope")]
    private string? _themeScope { get; set; }

    /// <summary>Raised when search left occurs.</summary>
    [Parameter]
    public EventCallback<SearchModel> OnSearchLeft { get; set; }

    /// <summary>Raised when search right occurs.</summary>
    [Parameter]
    public EventCallback<SearchModel> OnSearchRight { get; set; }

    /// <summary>Raised when sort occurs.</summary>
    [Parameter]
    public EventCallback<SearchModel> OnSort { get; set; }

    /// <summary>Gets or sets the right items used by this component.</summary>
    [Parameter]
    public List<TItem>? RightItems { get; set; }

    /// <summary>Gets or sets the left items used by this component.</summary>
    [Parameter]
    public List<TItem>? LeftItems { get; set; }

    /// <summary>Raised when the selection changes.</summary>
    [Parameter]
    public EventCallback<TransferredItems<TItem>> OnSelectionChanged { get; set; }

    /// <summary>Gets or sets content rendered for list item.</summary>
    [Parameter]
    public RenderFragment<TItem>? ListItemContent { get; set; }

    /// <summary>Gets or sets content rendered for item prefix.</summary>
    [Parameter]
    public RenderFragment<TItem>? ItemPrefixContent { get; set; }

    /// <summary>Gets or sets content rendered for item sufix.</summary>
    [Parameter]
    public RenderFragment<TItem>? ItemSufixContent { get; set; }

    /// <summary>Gets or sets the left list options used by this component.</summary>
    [Parameter]
    public ListOptions<TItem>? LeftListOptions { get; set; }

    /// <summary>Gets or sets the right list options used by this component.</summary>
    [Parameter]
    public ListOptions<TItem>? RightListOptions { get; set; }

    /// <summary>Gets or sets content rendered for item child.</summary>
    [Parameter]
    public RenderFragment? ItemChildContent { get; set; }

    /// <summary>Gets or sets the component width.</summary>
    [Parameter]
    public string? Width { get; set; }

    /// <summary>Gets or sets the component height.</summary>
    [Parameter]
    public string? Height { get; set; } = "300px";

    /// <summary>Gets or sets the minimum component width.</summary>
    [Parameter]
    public string? MinWidth { get; set; }

    /// <summary>Gets or sets the minimum component height.</summary>
    [Parameter]
    public string? MinHeight { get; set; }

    /// <summary>Gets or sets the maximum component width.</summary>
    [Parameter]
    public string? MaxWidth { get; set; }

    /// <summary>Gets or sets the maximum component height.</summary>
    [Parameter]
    public string? MaxHeight { get; set; }

    /// <summary>Gets or sets the item height used by this component.</summary>
    [Parameter]
    public int ItemHeight { get; set; } = 40;

    /// <summary>Gets or sets the border radius used by this component.</summary>
    [Parameter]
    public string BorderRadius { get; set; } = "5px";

    /// <summary>Gets or sets the margin top used by this component.</summary>
    [Parameter]
    public string MarginTop { get; set; } = "5px";

    /// <summary>Gets or sets the delay before a debounced input action is raised.</summary>
    [Parameter]
    public int DebounceTime { get; set; } = 300;

    /// <summary>Gets or sets the input item height used by this component.</summary>
    [Parameter]
    public int InputItemHeight { get; set; } = 34;

    /// <summary>Gets or sets the input text to upper used by this component.</summary>
    [Parameter]
    public bool InputTextToUpper { get; set; }

    /// <summary>Gets or sets the item auto selection used by this component.</summary>
    [Parameter]
    public bool ItemAutoSelection { get; set; }

    /// <summary>Gets or sets whether user interaction with the component is disabled.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Gets or sets the disabled clear button used by this component.</summary>
    [Parameter]
    public bool DisabledClearButton { get; set; }

    /// <summary>Gets or sets whether a value is required for validation.</summary>
    [Parameter]
    public bool IsRequired { get; set; }

    /// <summary>Gets or sets the search control options used by this component.</summary>
    [Parameter]
    public SearchControlOptions? SearchControlOptions { get; set; }

    /// <summary>Gets or sets the comparer used to match item values.</summary>
    [Parameter]
    public IEqualityComparer<TItem>? EqualityComparer { get; set; }

    /// <summary>Gets or sets the function that converts an item to display text.</summary>
    [Parameter]
    public Func<TItem, string>? DisplayValueConverter { get; set; }

    /// <summary>Gets or sets the side for selections used by this component.</summary>
    [Parameter]
    public ListToShow SideForSelections { get; set; }


    private ElementReference _menuTrigger;

    private ElementReference _focusTrigger;

    private bool _isOpen;

    private bool _disposed;

    private OverlayReference? _menuReference;

    private FloatingDoubleListService<TItem>? _floatingDoubleListService;

    private bool _hasFocus { get; set; }

    private bool _hasErrors { get; set; }

    private RenderFragment? _clearButtonContent { get; set; }

    private bool _isInitialized { get; set; }

    private List<TItem> _itemsToshow { get; set; } = new();

    private IFormEventService _formEventService { get; set; }


    protected override void OnInitialized()
    {
        if (_formFieldCascadingValues is not null) _formEventService = _formFieldCascadingValues.FormEventService;

        if (EditContext != null)
        {
            EditContext.OnFieldChanged += HandleOnValidationStateChanged;

            _hasErrors = EditContext.GetValidationMessages(FieldIdentifier).Any();

            if (_formEventService is not null) _formEventService.RaiseError(_hasErrors && EditContext.IsModified(FieldIdentifier));
        }

        if (!DisabledClearButton) _clearButtonContent = CreateClearButtonContent();

        GetOrCreateService();

        if (_formEventService is not null) _formEventService.RaiseCurrentValue(CurrentValueAsString);

        _isInitialized = true;
    }

    public override Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);

        if (DisplayValueConverter is null)
        {
            throw new InvalidOperationException(
                        $"{nameof(DnetFloatingDoubleList<TItem>)} You must supply a value for DisplayValueConverter.");
        }

        return base.SetParametersAsync(ParameterView.Empty);
    }

    protected override void OnParametersSet()
    {
        RefreshOverlayLabel();
        if (RightItems != null && SideForSelections == ListToShow.Right)
        {
            if (_isInitialized && RightItems.Any())
            {
                _itemsToshow = RightItems;

                _hasFocus = true;

                if (_formEventService is not null) _formEventService.RaiseFocus(_hasFocus);

                _isInitialized = false;
            }
        }
        else if (LeftItems != null && SideForSelections == ListToShow.Left)
        {
            if (_isInitialized && LeftItems.Any())
            {
                _itemsToshow = LeftItems;

                _hasFocus = true;

                if (_formEventService is not null) _formEventService.RaiseFocus(_hasFocus);

                _isInitialized = false;
            }
        }
    }

    private RenderFragment CreateClearButtonContent()
    {
        var inputContent = new RenderFragment(x =>
        {
            x.OpenElement(4, "div");
            x.AddAttribute(5, "class", "dnet-app-icon-wrapper");
            x.AddAttribute(8, "role", "button");
            x.AddAttribute(9, "aria-label", Localizer["Common.Clear"]);
            x.AddAttribute(3, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, _ => ClearInput()));
            x.OpenElement(6, "span");
            x.AddAttribute(7, "class", "dnet-app-icon dnet-autoc-reset-button");
            x.CloseElement();
            x.CloseElement();
        });

        return inputContent;
    }

    protected override bool TryParseValueFromString(string? value, out string? result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = InputTextToUpper ? value?.ToUpper() : value;
        validationErrorMessage = null;
        return true;
    }

    private void OpenMenu()
    {
        if (Disabled || _disposed) return;

        if (_isOpen) return;

        AttachMenu();

        _isOpen = true;
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " " or "Spacebar" or "ArrowDown")
        {
            OpenMenu();
        }
    }

    private void CloseMenu()
    {
        if (_isOpen)
        {
            DetachMenu();
        }
    }

    private void SelectionChanged(TransferredItems<TItem> transferredItems) => _ = InvokeAsync(() => SelectionChangedAsync(transferredItems));

    private async Task SelectionChangedAsync(TransferredItems<TItem> transferredItems)
    {
        var transfered = SideForSelections == ListToShow.Right ? transferredItems.RightItems : transferredItems.LeftItems;

        _hasFocus = transfered.Any();

        if (_formEventService is not null) _formEventService.RaiseFocus(_hasFocus);

        _itemsToshow = transfered;

        await OnSelectionChanged.InvokeAsync(transferredItems);

        StateHasChanged();
    }

    private void ClearInput() => _ = InvokeAsync(ClearInputAsync);

    private async Task ClearInputAsync()
    {
        CurrentValueAsString = null;

        EditContext?.NotifyFieldChanged(FieldIdentifier);

        if (EditContext != null)
        {
            _hasErrors = (EditContext.GetValidationMessages(FieldIdentifier)).Any();

            if (_formEventService is not null) _formEventService.RaiseError(_hasErrors && EditContext.IsModified(FieldIdentifier));
        }

        _hasFocus = false;

        if (_formEventService is not null) _formEventService.RaiseFocus(_hasFocus);

        await ValueChanged.InvokeAsync(Value);

        DetachMenu();

        StateHasChanged();
    }

    private void AttachMenu()
    {
        var positions = new List<ConnectedPosition>
        {
            new()
            {
                OriginX = HorizontalConnectionPos.Start,
                OriginY = VerticalConnectionPos.Bottom,
                OverlayX = HorizontalConnectionPos.Start,
                OverlayY = VerticalConnectionPos.Top
            },
            new()
            {
                OriginX = HorizontalConnectionPos.Start,
                OriginY = VerticalConnectionPos.Top,
                OverlayX = HorizontalConnectionPos.Start,
                OverlayY = VerticalConnectionPos.Bottom
            },
            new()
            {
                OriginX = HorizontalConnectionPos.End,
                OriginY = VerticalConnectionPos.Bottom,
                OverlayX = HorizontalConnectionPos.End,
                OverlayY = VerticalConnectionPos.Top
            },
            new()
            {
                OriginX = HorizontalConnectionPos.End,
                OriginY = VerticalConnectionPos.Top,
                OverlayX = HorizontalConnectionPos.End,
                OverlayY = VerticalConnectionPos.Bottom
            }
        };

        var flexibleConnectedPositionStrategyBuilder = new FlexibleConnectedPositionStrategyBuilder()
            .WithLockedPosition()
            .WithViewportMargin(8)
            .SetOrigin(_formFieldCascadingValues is not null
                ? _formFieldCascadingValues.FormField
                : _menuTrigger)
            .WithFlexibleDimensions(false)
            .WithPositions(positions);

        var connectedPanelConfig = new OverlayConfig
            {
                HasBackdrop = true,
                HasTransparentBackdrop = true,
                CloseOnEscape = true,
                Role = "dialog",
                AriaLabel = DisplayName ?? Localizer["FloatingDoubleList.Label"],
                PositionStrategy = PositionStrategy.FlexibleConnectedTo,
                FlexibleConnectedPositionStrategyBuilder = flexibleConnectedPositionStrategyBuilder,
                MinWidth = MinWidth,
                MaxWidth = MaxWidth,
                MinHeight = MinHeight,
                MaxHeight = MaxHeight,
                MarginTop = MarginTop,
                Width = Width,
                Height = Height,
                ComponentType = ComponentType.FloatingDoubleList,
                ThemeScope = _themeScope
            };

        var menuContent = new RenderFragment(x =>
        {
            x.OpenComponent(0, typeof(DnetFloatingDoubleListPanel<TItem>));
            x.AddAttribute(1, "RightItems", RightItems);
            x.AddAttribute(2, "LeftItems", LeftItems);
            x.AddAttribute(9, "ItemHeight", ItemHeight);
            x.AddAttribute(10, "BorderRadius", BorderRadius);
            x.AddAttribute(11, "FloatingDoubleListService", GetOrCreateService());
            x.AddAttribute(12, "ItemPrefixContent", ItemPrefixContent);
            x.AddAttribute(13, "ItemSufixContent", ItemSufixContent);
            x.AddAttribute(14, "ChildContent", ItemChildContent);
            x.AddAttribute(15, "LeftListOptions", LeftListOptions);
            x.AddAttribute(16, "RightListOptions", RightListOptions);
            x.AddAttribute(19, "EqualityComparer", EqualityComparer);
            x.AddAttribute(20, "ListItemContent", ListItemContent);
            x.AddAttribute(21, "SearchControlOptions", SearchControlOptions);
            x.CloseComponent();
        });

        _menuReference = OverlayService.Attach(menuContent, connectedPanelConfig);

        _menuReference.Close += CloseFilter;
    }

    private void DetachMenu()
    {
        if (_isOpen)
        {
            _isOpen = false;

            var result = new OverlayResult
                {
                    OverlayReferenceId = _menuReference.GetOverlayReferenceId(),
                    CloseReason = CloseReason.Cancel
                };

            OverlayService.Detach(result);
        }
    }

    void CloseFilter(OverlayResult overlayDataResult)
    {
        _isOpen = false;

        if (_menuReference is not null)
        {
            _menuReference.Close -= CloseFilter;
            _menuReference = null;
        }

        if (_disposed) return;

        _ = InvokeAsync(async () =>
        {
            StateHasChanged();

            if (Disabled || _disposed) return;

            try
            {
                await _focusTrigger.FocusAsync(preventScroll: true);
            }
            catch (JSException)
            {
                // The browser connection or the trigger can disappear during navigation.
            }
            catch (InvalidOperationException)
            {
                // A static render has no interactive element to focus.
            }
            catch (OperationCanceledException)
            {
                // Navigation can cancel the focus request after the overlay has closed.
            }
        });
    }

    private void SearchLeft(SearchModel searchModel) => _ = InvokeAsync(() => SearchLeftAsync(searchModel));

    private async Task SearchLeftAsync(SearchModel searchModel)
    {
        await OnSearchLeft.InvokeAsync(searchModel);
    }

    private void SearchRight(SearchModel searchModel) => _ = InvokeAsync(() => SearchRightAsync(searchModel));

    private async Task SearchRightAsync(SearchModel searchModel)
    {
        await OnSearchRight.InvokeAsync(searchModel);
    }

    public void RefreshDataLeft(List<TItem> items)
    {
        _isInitialized = false;

        if (SideForSelections == ListToShow.Right)
        {

            CurrentValue = null;

            EditContext?.NotifyFieldChanged(FieldIdentifier);

            if (EditContext != null)
            {
                _hasErrors = (EditContext.GetValidationMessages(FieldIdentifier)).Any();

                if (_formEventService is not null) _formEventService.RaiseError(_hasErrors && EditContext.IsModified(FieldIdentifier));
            }
        }

        GetOrCreateService().RefreshDataLeft(items);
    }

    public void RefreshDataRight(List<TItem> items)
    {
        _isInitialized = false;

        if (SideForSelections == ListToShow.Right)
        {

            CurrentValue = null;

            EditContext?.NotifyFieldChanged(FieldIdentifier);

            if (EditContext != null)
            {
                _hasErrors = (EditContext.GetValidationMessages(FieldIdentifier)).Any();

                if (_formEventService is not null) _formEventService.RaiseError(_hasErrors && EditContext.IsModified(FieldIdentifier));
            }
        }

        GetOrCreateService().RefreshDataRight(items);
    }

    private void HandleOnValidationStateChanged(object sender, FieldChangedEventArgs? args)
    {
        if (EditContext != null)
        {
            _hasErrors = (EditContext.GetValidationMessages(FieldIdentifier)).Any();

            if (_formEventService is not null) _formEventService.RaiseError(_hasErrors && EditContext.IsModified(FieldIdentifier));
        }
    }

    private FloatingDoubleListService<TItem> GetOrCreateService()
    {
        if (_floatingDoubleListService is null)
        {
            _floatingDoubleListService = new FloatingDoubleListService<TItem>();

            _floatingDoubleListService.OnSelectionChange += SelectionChanged;

            _floatingDoubleListService.OnSearchLeft += SearchLeft;

            _floatingDoubleListService.OnSearchRight += SearchRight;

            _floatingDoubleListService.OnSort += HandleSort;

            _floatingDoubleListService.OnClose += CloseMenu;
        }

        return _floatingDoubleListService;
    }

    private void HandleSort(SearchModel searchModel) => _ = InvokeAsync(() => OnSort.InvokeAsync(searchModel));

    public void Dispose()
    {
        _disposed = true;

        if (_menuReference != null)
        {
            _menuReference.Close -= CloseFilter;
            DetachMenu();
            _menuReference = null;
        }

        if (EditContext is not null) EditContext.OnFieldChanged -= HandleOnValidationStateChanged;

        if (_floatingDoubleListService is not null)
        {
            _floatingDoubleListService.OnSelectionChange -= SelectionChanged;

            _floatingDoubleListService.OnSearchLeft -= SearchLeft;

            _floatingDoubleListService.OnSearchRight -= SearchRight;

            _floatingDoubleListService.OnSort -= HandleSort;

            _floatingDoubleListService.OnClose -= CloseMenu;
        }

        DisposeInputBase();
    }
}
