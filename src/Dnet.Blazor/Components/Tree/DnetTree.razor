@using Microsoft.AspNetCore.Components.Web

@typeparam TNode

<CascadingValue Value="@this" IsFixed="true">
    <div class="dnet-desktop-navigation-menu">
        <ul role="tree">
            @foreach (var treeNodeModel in _treeNodeModels)
            {
                <DnetTreeNode Node="@treeNodeModel"
                          DisplayValueConverter="DisplayValueConverter"
                          ChildNodes="ChildNodes"
                          CheckboxSelection="CheckboxSelection"
                          OnTreeNodeClicked="OnTreeNodeClicked"
                          OnCheckboxClicked="OnCheckboxClicked"
                          OnSelectionChange="OnSelectionChange"
                          NodeContent="NodeContent">
                </DnetTreeNode>
            }
        </ul>
    </div>
</CascadingValue>

@code {

    /// <summary>Gets or sets the template used to render a tree node.</summary>
    [Parameter]
    public RenderFragment<TNode>? NodeContent { get; set; }

    /// <summary>Raised when tree node clicked occurs.</summary>
    [Parameter]
    public EventCallback<TNode> OnTreeNodeClicked { get; set; }

    /// <summary>Raised when checkbox clicked occurs.</summary>
    [Parameter]
    public EventCallback<TNode> OnCheckboxClicked { get; set; }

    /// <summary>Raised when the selection changes.</summary>
    [Parameter]
    public EventCallback<List<TNode>> OnSelectionChange { get; set; }

    /// <summary>Gets or sets the nodes used by this component.</summary>
    [Parameter]
    public ICollection<TNode>? Nodes { get; set; }

    /// <summary>Gets or sets the function that converts an item to display text.</summary>
    [Parameter]
    public Func<TNode, string> DisplayValueConverter { get; set; } = value => value?.ToString() ?? string.Empty;

    /// <summary>Gets or sets the child nodes used by this component.</summary>
    [Parameter]
    public Func<TNode, List<TNode>?>? ChildNodes { get; set; }

    /// <summary>Gets or sets the component type rendered dynamically.</summary>
    [Parameter]
    public Type ComponentType { get; set; }

    /// <summary>Gets or sets parameters passed to the dynamically rendered component.</summary>
    [Parameter]
    public IDictionary<string, object> Parameters { get; set; }

    /// <summary>Gets or sets the checkbox selection used by this component.</summary>
    [Parameter]
    public bool CheckboxSelection { get; set; }

    private long _nextId { get; set; } = -1;

    internal List<TreeNodeModel<TNode>> _treeNodeModels { get; set; } = new();

    internal TreeNodeModel<TNode> _selectedNode { get; set; } = new();

    private ICollection<TNode>? _nodesSource;


    protected override void OnInitialized()
    {
        RebuildNodes();
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_nodesSource, Nodes))
        {
            RebuildNodes();
        }
    }

    private void RebuildNodes()
    {
        _nextId = -1;
        _nodesSource = Nodes;
        _selectedNode = new TreeNodeModel<TNode>();
        var root = new TreeNodeModel<TNode>
        {
            RowNodeId = GetId(),
            Show = true,
            Children = new List<TreeNodeModel<TNode>>()
        };
        _treeNodeModels = TraverseTreeNodes(root, Nodes ?? Array.Empty<TNode>()).Children;
    }

    private TreeNodeModel<TNode> TraverseTreeNodes(TreeNodeModel<TNode> treeNodeModel, IEnumerable<TNode> nodes)
    {
        foreach (var node in nodes)
        {
            var nodeModel = new TreeNodeModel<TNode>
                {
                    RowNodeId = GetId(),
                    TreeNodeData = node,
                    Show = true,
                    Children = new List<TreeNodeModel<TNode>>()
                };

            var children = ChildNodes?.Invoke(node);
            if (children is { Count: > 0 })
            {
                TraverseTreeNodes(nodeModel, children);
            }

            treeNodeModel.Children.Add(nodeModel);
        }

        return treeNodeModel;
    }

    private long GetId()
    {
        _nextId++;
        return _nextId;
    }

    public void Expand(bool expand)
    {
        ToggleExpand(_treeNodeModels, expand);
    }

    private void ToggleExpand(List<TreeNodeModel<TNode>> nodes, bool expand)
    {
        foreach (var node in nodes)
        {
            node.ExpandNode(expand);

            if (node.Children != null && node.Children.Count > 0)
            {
                ToggleExpand(node.Children, expand);
            }
        }
    }

    public void UpdateNodes(ICollection<TNode> newNodes)
    {
        Nodes = newNodes;
        RebuildNodes();
        StateHasChanged();
    }
}
