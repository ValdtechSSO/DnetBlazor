@using Microsoft.AspNetCore.Components.Web

@implements IDisposable

<nav class="dnet-paginator" aria-label="@PaginationLabel">
    <div class="dnet-paginator-container" style="grid-template-rows: repeat(@(OneRow ? 1 : 2), 1fr); grid-column-gap: @($"{GridGap}px");">
        <div class="dnet-paginator-page-container @($"zone{PageNumberZone}")">
            <span>@PageText</span>
            <input class="dnet-paginator-page-input"
                   type="text"
                   inputmode="numeric"
                   aria-label="@PageInputLabel"
                   disabled="@Disabled"
                   @bind-value="@_currentPage"
                   @bind-value:event="oninput"
                   @onkeyup="(KeyboardEventArgs eventArgs) => Filter(eventArgs)"
                   @onkeyup:stopPropagation="true"
                   @onkeyup:preventDefault="true">
            <span>@OfText @_numberOfPages</span>
        </div>
        <div class="control-container @($"zone{ControlsZone}")">
            <button type="button"
                    class="dnet-paginator-navigation-first dnet-paginator-icon-button"
                    disabled="@(Disabled || !_showFirstButton)" aria-label="@FirstPageLabel"
                    @onclick="() => GoToFirstPage()">
                <svg class="bi bi-chevron-bar-left" width="1em" height="1em" viewBox="0 0 16 16" fill="@(_showFirstButton ? "currentColor" : "grey" )" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" d="M11.854 3.646a.5.5 0 010 .708L8.207 8l3.647 3.646a.5.5 0 01-.708.708l-4-4a.5.5 0 010-.708l4-4a.5.5 0 01.708 0zM4.5 1a.5.5 0 00-.5.5v13a.5.5 0 001 0v-13a.5.5 0 00-.5-.5z" clip-rule="evenodd" />
                </svg>
            </button>
            <button type="button"
                    class="dnet-paginator-navigation-previous dnet-paginator-icon-button"
                    disabled="@(Disabled || !_hasPreviousPage)" aria-label="@PreviousPageLabel"
                    @onclick="() => GoToPreviousPage()">
                <svg class="bi bi-chevron-left" width="1em" height="1em" viewBox="0 0 16 16" fill="@(_hasPreviousPage ? "currentColor" : "grey" )" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 010 .708L5.707 8l5.647 5.646a.5.5 0 01-.708.708l-6-6a.5.5 0 010-.708l6-6a.5.5 0 01.708 0z" clip-rule="evenodd" />
                </svg>
            </button>
            <button type="button"
                    class="dnet-paginator-navigation-next dnet-paginator-icon-button"
                    disabled="@(Disabled || !_hasNextPage)" aria-label="@NextPageLabel"
                    @onclick="() => GoToNextPage()">
                <svg class="bi bi-chevron-right" width="1em" height="1em" viewBox="0 0 16 16" fill="@(_hasNextPage ? "currentColor" : "grey" )" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 01.708 0l6 6a.5.5 0 010 .708l-6 6a.5.5 0 01-.708-.708L10.293 8 4.646 2.354a.5.5 0 010-.708z" clip-rule="evenodd" />
                </svg>
            </button>
            <button type="button"
                    class="dnet-paginator-navigation-last dnet-paginator-icon-button"
                    disabled="@(Disabled || !_showLastButton)" aria-label="@LastPageLabel"
                    @onclick="() => GoToLastPage()">
                <svg class="bi bi-chevron-bar-right" width="1em" height="1em" viewBox="0 0 16 16" fill="@(_showLastButton ? "currentColor" : "grey" )" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" d="M4.146 3.646a.5.5 0 000 .708L7.793 8l-3.647 3.646a.5.5 0 00.708.708l4-4a.5.5 0 000-.708l-4-4a.5.5 0 00-.708 0zM11.5 1a.5.5 0 01.5.5v13a.5.5 0 01-1 0v-13a.5.5 0 01.5-.5z" clip-rule="evenodd" />
                </svg>
            </button>
        </div>

        <div class="dnet-paginator-range-label @($"zone{RangeZone}")">
            @GetRangeLabel(CurrentPage, PageSize, TotalItems)
        </div>
    </div>
</nav>

@code {

    /// <summary>Raised when go to first page occurs.</summary>
    [Parameter]
    public EventCallback<int> OnGoToFirstPage { get; set; }

    /// <summary>Raised when go to previous page occurs.</summary>
    [Parameter]
    public EventCallback<int> OnGoToPreviousPage { get; set; }

    /// <summary>Raised when go to next page occurs.</summary>
    [Parameter]
    public EventCallback<int> OnGoToNextPage { get; set; }

    /// <summary>Raised when go to last page occurs.</summary>
    [Parameter]
    public EventCallback<int> OnGoToLastPage { get; set; }

    /// <summary>Raised when go to specific page occurs.</summary>
    [Parameter]
    public EventCallback<int> OnGoToSpecificPage { get; set; }

    /// <summary>Gets or sets the current page used by this component.</summary>
    [Parameter]
    public int CurrentPage { get; set; }

    /// <summary>Gets or sets the number of items displayed on each page.</summary>
    [Parameter]
    public int PageSize { get; set; }

    /// <summary>Gets or sets the total items used by this component.</summary>
    [Parameter]
    public int TotalItems { get; set; }

    /// <summary>Gets or sets whether user interaction with the component is disabled.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Gets or sets the pagination label used by this component.</summary>
    [Parameter]
    public string PaginationLabel { get; set; } = "Pagination";

    /// <summary>Gets or sets the page text used by this component.</summary>
    [Parameter]
    public string PageText { get; set; } = "Page";

    /// <summary>Gets or sets the of text used by this component.</summary>
    [Parameter]
    public string OfText { get; set; } = "of";

    /// <summary>Gets or sets the page input label used by this component.</summary>
    [Parameter]
    public string PageInputLabel { get; set; } = "Current page";

    /// <summary>Gets or sets the first page label used by this component.</summary>
    [Parameter]
    public string FirstPageLabel { get; set; } = "First page";

    /// <summary>Gets or sets the previous page label used by this component.</summary>
    [Parameter]
    public string PreviousPageLabel { get; set; } = "Previous page";

    /// <summary>Gets or sets the next page label used by this component.</summary>
    [Parameter]
    public string NextPageLabel { get; set; } = "Next page";

    /// <summary>Gets or sets the last page label used by this component.</summary>
    [Parameter]
    public string LastPageLabel { get; set; } = "Last page";

    /// <summary>Gets or sets the page number zone used by this component.</summary>
    [Parameter]
    public int PageNumberZone { get; set; } = 2;

    /// <summary>Gets or sets the controls zone used by this component.</summary>
    [Parameter]
    public int ControlsZone { get; set; } = 3;

    /// <summary>Gets or sets the range zone used by this component.</summary>
    [Parameter]
    public int RangeZone { get; set; } = 4;

    /// <summary>Gets or sets the one row used by this component.</summary>
    [Parameter]
    public bool OneRow { get; set; } = false;

    /// <summary>Gets or sets the grid gap used by this component.</summary>
    [Parameter]
    public int GridGap { get; set; } = 20;


    private bool _hasNextPage { get; set; }

    private bool _hasPreviousPage { get; set; }

    private bool _showFirstButton { get; set; }

    private bool _showLastButton { get; set; }

    private int _numberOfPages { get; set; }

    private CancellationTokenSource? _filterCancellation;

    private int _currentPage;


    protected override void OnParametersSet()
    {
        _numberOfPages = PageSize > 0 ? (int)Math.Ceiling((double)TotalItems / (double)PageSize) : 0;

        _currentPage = NormalizePage(CurrentPage);

        UpdateButtons(_currentPage, _numberOfPages);
    }

    private async Task Filter()
    {
        var cancellation = _filterCancellation = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, cancellation.Token);
            if (ReferenceEquals(_filterCancellation, cancellation))
            {
                await GoToSpecificPage();
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (ReferenceEquals(_filterCancellation, cancellation)) _filterCancellation = null;
            cancellation.Dispose();
        }
    }

    private Task Filter(KeyboardEventArgs data)
    {
        _filterCancellation?.Cancel();
        return Filter();
    }

    private async Task GoToFirstPage()
    {
        if (Disabled || _currentPage == 1 || _currentPage == 0) return;

        CurrentPage = _currentPage = 1;

        UpdateButtons(1, _numberOfPages);

        await OnGoToFirstPage.InvokeAsync(1);
    }

    private async Task GoToPreviousPage()
    {
        if (Disabled || _currentPage == 1 || _currentPage == 0) return;

        CurrentPage = _currentPage -= 1;

        UpdateButtons(_currentPage, _numberOfPages);

        await OnGoToPreviousPage.InvokeAsync(_currentPage);
    }

    private async Task GoToNextPage()
    {
        if (Disabled || _currentPage == _numberOfPages || _currentPage == 0) return;

        CurrentPage = _currentPage += 1;

        UpdateButtons(_currentPage, _numberOfPages);

        await OnGoToNextPage.InvokeAsync(_currentPage);
    }

    private async Task GoToLastPage()
    {
        if (Disabled) return;

        _numberOfPages = PageSize > 0 ? (int)Math.Ceiling((double)TotalItems / (double)PageSize) : 0;

        if (_currentPage == _numberOfPages || _currentPage == 0) return;

        CurrentPage = _currentPage = _numberOfPages;

        UpdateButtons(_numberOfPages, _numberOfPages);

        await OnGoToLastPage.InvokeAsync(_numberOfPages);
    }

    private void UpdateButtons(int currentPage, int numberOfPages)
    {
        _hasNextPage = currentPage != numberOfPages;

        _hasPreviousPage = (currentPage != 1 && currentPage != 0);

        _showFirstButton = currentPage > 1;

        _showLastButton = currentPage < numberOfPages;
    }

    public void UpdatePaginatorState(int currentPage, int totalItems)
    {
        _numberOfPages = PageSize > 0 ? (int)Math.Ceiling((double)totalItems / (double)PageSize) : 0;

        _currentPage = currentPage;

        UpdateButtons(currentPage, _numberOfPages);
    }

    private async Task GoToSpecificPage()
    {
        if (Disabled) return;

        _currentPage = NormalizePage(_currentPage);

        CurrentPage = _currentPage;

        if (1 <= _currentPage && _currentPage <= _numberOfPages)
        {
            UpdateButtons(_currentPage, _numberOfPages);

            await OnGoToSpecificPage.InvokeAsync(_currentPage);
        }

    }

    public void Dispose()
    {
        _filterCancellation?.Cancel();
        _filterCancellation?.Dispose();
    }

    private int NormalizePage(int page) => _numberOfPages == 0 ? 0 : Math.Clamp(page, 1, _numberOfPages);

    private string GetRangeLabel(int page, int pageSize, int length)
    {
        if (length == 0 || pageSize == 0)
        {
            return $"0 {OfText} {Math.Max(length, 0)}";
        }

        length = Math.Max(length, 0);
        var startIndex = (page - 1) * pageSize;
        var endIndex = startIndex < length
            ? Math.Min(startIndex + pageSize, length)
            : startIndex + pageSize;

        return $"{startIndex + 1} - {endIndex} {OfText} {length}";
    }
}
