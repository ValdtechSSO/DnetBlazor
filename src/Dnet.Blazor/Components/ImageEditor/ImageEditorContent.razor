@using System.IO
@using Dnet.Blazor.Components.Dialog.Infrastructure.Interfaces
@using Dnet.Blazor.Components.ImageEditor.Infrastructure.Constants
@using Dnet.Blazor.Components.ImageEditor.Infrastructure.Enums
@using Dnet.Blazor.Components.ImageEditor.Infrastructure.Models
@using Dnet.Blazor.Components.ImageEditor.Infrastructure.Services
@using Dnet.Blazor.Components.Overlay.Infrastructure.Enums
@using Dnet.Blazor.Components.Overlay.Infrastructure.Services
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@using Dnet.Blazor.Components.Button

@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject IStyleService StyleService
@inject IImageEditorService ImageEditorService

@implements IDragAndDropJsCallbacks
@implements IAsyncDisposable

<div class="dnet-image-editor-wrapper">
    <div>
        <div class="dnet-image-editor-controls">
            @if (ShowControl(ImageEditorControlType.Crop))
            {
            <DnetButton OnClick="OnCropImage" class="dnet-image-editor-control">
                <span class="dnet-icon dnet-icon-crop" unselectable="on"></span>
                <span class="dnet-icon-text" unselectable="on">Crop</span>
            </DnetButton>
            }
            @if (ShowControl(ImageEditorControlType.FlipHorizontal))
            {
            <DnetButton OnClick="OnFlipHorizontal" class="dnet-image-editor-control">
                <span class="dnet-icon dnet-icon-flip-h" unselectable="on">⇄</span>
                <span class="dnet-icon-text" unselectable="on">Flip H</span>
            </DnetButton>
            }
            @if (ShowControl(ImageEditorControlType.FlipVertical))
            {
            <DnetButton OnClick="OnFlipVertical" class="dnet-image-editor-control">
                <span class="dnet-icon dnet-icon-flip-v" unselectable="on">⇅</span>
                <span class="dnet-icon-text" unselectable="on">Flip V</span>
            </DnetButton>
            }
        </div>
        <div class="dnet-editor-container">
            <div class="dnet-image-container">
                <div class="dnet-image-original-text">
                    <span class="dnet-image-label">Original Image</span>
                    <span class="dnet-image-info">@_sourceLabel</span>
                </div>
                <div @ref="_board" class="dnet-editing-image" style="@StyleService.GetCropContainerStyles(_imageContainerHeight, _imageContainerWidth)">
                    @* The canvas is both the on-screen image and the source every operation works
                       from, so nothing is ever re-read from the DOM or re-encoded in between. *@
                    <canvas @ref="_canvas" class="dnet-editing-image-canvas" width="1" height="1"></canvas>
                    @if (_isImageEditorReady)
                    {
                        <div @ref="_cropContainer" class="dnet-crop-container" style="@_cropStyles">
                            <div class="dnet-crop-box-mask-top"></div>
                            <div class="dnet-crop-box-mask-bottom"></div>
                            <div class="dnet-crop-box-mask-left"></div>
                            <div class="dnet-crop-box-mask-right"></div>
                            <div @ref="_cropBox" class="dnet-crop-box"></div>
                            <div class="dnet-crop-box-dummy"></div>
                            @foreach (var resizer in _resizerData)
                            {
                                <div @ref="resizer.Reference" class="dnet-crop-box-resizer @GetResizerClass(resizer.ResizerType)"></div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="dnet-image-preview">
                <div class="dnet-image-preview-text">
                    <span class="dnet-image-label">Preview</span>
                    <span class="dnet-image-info">@_outputLabel</span>
                </div>
                <canvas @ref="_previewCanvas" class="dnet-image-preview-canvas" width="1" height="1" style="@StyleService.GetImagePreviewStyles(_imgPreviewHeight, _imgPreviewWidth)"></canvas>
            </div>
        </div>
    </div>
    <div class="dnet-img-dialog-controls">
        <DnetButton OnClick="CancelOverlay" class="dnet-m-r-10">Close</DnetButton>
        <DnetButton OnClick="CloseOverlay" class="dnet-m-r-10" disabled="@(!_isImageEditorReady)" InitialFocus="true">Ok</DnetButton>
    </div>
</div>

@code {

    [CascadingParameter]
    private int OverlayReferenceId { get; set; }

    /// <summary>Gets or sets the dialog data used by this component.</summary>
    [Parameter]
    public DialogData DialogData { get; set; } = default!;

    // Identifies this editor in the browser module: two editors on the same page
    // never share state.
    private readonly string _editorId = Guid.NewGuid().ToString("N");

    private ElementReference _board;

    private ElementReference _canvas;

    private ElementReference _previewCanvas;

    private ElementReference _cropContainer;

    private ElementReference _cropBox;

    private MemoryStream _fullSizeImageStream { get; set; }

    private MemoryStream _workingImageStream { get; set; }

    private MemoryStream _resulImageStream { get; set; }

    private DnetImageEditorInterop _jsInterop;

    private ImageEditorSourceData _sourceData;

    private List<ResizerData> _resizerData { get; set; }

    private List<ImageEditorControlType> _imageEditingControls { get; set; }

    private string _cropStyles { get; set; }

    private string _sourceLabel { get; set; } = "—";

    private string _outputLabel { get; set; } = "—";

    private int _imageContainerHeight { get; set; }

    private int _imageContainerWidth { get; set; }

    private int _imgPreviewHeight { get; set; }

    private int _imgPreviewWidth { get; set; }

    private long _lastExportSize { get; set; }

    private bool _isImageEditorReady { get; set; }

    private bool _cropDirty { get; set; }

    private bool _flipDirty { get; set; }

    private bool _resultHandedOff { get; set; }


    protected override void OnInitialized()
    {
        var dialogData = DialogData;

        _fullSizeImageStream = dialogData.imageFile;
        _workingImageStream = dialogData.WorkingImageStream ?? dialogData.imageFile;
        _imageContainerHeight = dialogData.ImageContainerHeight;
        _imageContainerWidth = dialogData.ImageContainerWidth;
        _imgPreviewHeight = dialogData.ImagePreviewHeight;
        _imgPreviewWidth = dialogData.ImagePreviewWidth;
        _imageEditingControls = dialogData.ImageEditingControls ?? new();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeEditor();
        }
    }

    private async Task InitializeEditor()
    {
        _jsInterop = new DnetImageEditorInterop(this, JSRuntime, _editorId);
        _resizerData = ImageEditorService.InitializeResizers();

        try
        {
            _fullSizeImageStream.Position = 0;

            var options = new ImageEditorOptions
                {
                    PreviewWidth = _imgPreviewWidth,
                    PreviewHeight = _imgPreviewHeight,
                    MaxOutputDimension = DialogData.MaxOutputDimension,
                    OutputFormat = DialogData.OutputFormat,
                    OutputQuality = DialogData.OutputQuality > 0 ? DialogData.OutputQuality : 95
                };

            // The bytes travel as a stream reference: no base64, no copy in .NET.
            _sourceData = await _jsInterop.InitializeSource(
                new DotNetStreamReference(_fullSizeImageStream, leaveOpen: true),
                _canvas,
                _previewCanvas,
                options);

            _fullSizeImageStream.Position = 0;
        }
        catch (Exception exception)
        {
            Console.WriteLine($"Dnet.Blazor: the image editor could not load the image. {exception.Message}");
            return;
        }

        _sourceLabel = $"{_sourceData.SourceWidth} x {_sourceData.SourceHeight}";
        _outputLabel = _sourceLabel;
        _cropStyles = StyleService.GetStyles(_sourceData.CropLeft, _sourceData.CropTop, _sourceData.CropHeight, _sourceData.CropWidth);
        _isImageEditorReady = true;

        StateHasChanged();

        // The crop chrome only exists after the render above, so the overlay is
        // hooked up once it is on the page. The preview follows the selection
        // from that first moment, which is why the label describes it too.
        var selection = await _jsInterop.AttachCrop(_board, _cropContainer, _cropBox);

        _outputLabel = FormatSize(selection.OutputWidth, selection.OutputHeight);

        StateHasChanged();

        // Photon is only needed to resample, which cannot happen before the user
        // does something: load it in the background instead of blocking the dialog.
        _ = PreloadPhotonAsync();
    }

    private async Task PreloadPhotonAsync()
    {
        try
        {
            await _jsInterop.PreloadPhotonWasm();
        }
        catch (Exception exception)
        {
            // Resampling falls back to the browser encoder.
            Console.WriteLine($"Dnet.Blazor: Photon WASM could not be preloaded. {exception.Message}");
        }
    }

    private async Task OnCropImage()
    {
        if (!_isImageEditorReady) return;

        try
        {
            var result = await _jsInterop.ExportImage(useCrop: true);

            _lastExportSize = result.Size;

            _resulImageStream = await ReadResultAsync();
            _outputLabel = FormatSize(result.Width, result.Height);
        }
        catch (Exception exception)
        {
            Console.WriteLine($"Dnet.Blazor: the selected image could not be cropped. {exception.Message}");
        }

        StateHasChanged();
    }

    private async Task OnFlipHorizontal()
    {
        await FlipAsync(horizontal: true);
    }

    private async Task OnFlipVertical()
    {
        await FlipAsync(horizontal: false);
    }

    private async Task FlipAsync(bool horizontal)
    {
        if (!_isImageEditorReady) return;

        try
        {
            // The flip only touches the canvas pixels: it is lossless and can be
            // repeated as many times as the user wants.
            await _jsInterop.Flip(horizontal);

            _flipDirty = true;
            ClearResultStream();
        }
        catch (Exception exception)
        {
            Console.WriteLine($"Dnet.Blazor: the image could not be flipped. {exception.Message}");
        }

        StateHasChanged();
    }

    private async Task<MemoryStream> ReadResultAsync()
    {
        var reference = await _jsInterop.GetResultStream();

        try
        {
            var maxAllowedSize = Math.Max(1, Math.Max(_fullSizeImageStream.Length, _lastExportSize));

            await using var source = await reference.OpenReadStreamAsync(maxAllowedSize);

            var memory = new MemoryStream();

            await source.CopyToAsync(memory);
            memory.Position = 0;

            return memory;
        }
        finally
        {
            await reference.DisposeAsync();
        }
    }

    private void ClearResultStream()
    {
        if (_resulImageStream is not null && OwnsResultStream())
        {
            _resulImageStream.Dispose();
        }

        _resulImageStream = null;
    }

    private bool OwnsResultStream()
        => _resulImageStream is not null &&
           !ReferenceEquals(_resulImageStream, _workingImageStream) &&
           !ReferenceEquals(_resulImageStream, _fullSizeImageStream);

    void IDragAndDropJsCallbacks.OnDragStart()
    {
    }

    void IDragAndDropJsCallbacks.OnDrag(DraggedData draggedData)
    {
        UpdateSelection(draggedData, commit: false);
    }

    void IDragAndDropJsCallbacks.OnDragEnd(DraggedData draggedData)
    {
        UpdateSelection(draggedData, commit: true);
    }

    void IDragAndDropJsCallbacks.OnResizeStart()
    {
    }

    void IDragAndDropJsCallbacks.OnResize(DraggedData draggedData)
    {
        UpdateSelection(draggedData, commit: false);
    }

    void IDragAndDropJsCallbacks.OnResizeEnd(DraggedData draggedData)
    {
        UpdateSelection(draggedData, commit: true);
    }

    private void UpdateSelection(DraggedData draggedData, bool commit)
    {
        // The browser has already drawn the new rectangle; .NET only tracks the
        // result, which is why a gesture no longer costs a render per frame.
        _cropDirty = true;
        _outputLabel = FormatSize(draggedData.OutputWidth, draggedData.OutputHeight);

        ClearResultStream();

        if (commit)
        {
            // Keeps the rendered geometry equal to what the browser wrote, so a
            // later render cannot snap the box back to a stale position.
            _cropStyles = StyleService.GetStyles(draggedData.Left, draggedData.Top, draggedData.Height, draggedData.Width);
        }

        StateHasChanged();
    }

    private async Task CloseOverlay()
    {
        if (!_isImageEditorReady) return;

        if (_resulImageStream is null)
        {
            if (!_cropDirty && !_flipDirty)
            {
                // Nothing was edited: the caller gets its own bytes back, untouched.
                _resulImageStream = _workingImageStream ?? _fullSizeImageStream;
            }
            else
            {
                try
                {
                    var result = await _jsInterop.ExportImage(useCrop: _cropDirty);

                    _lastExportSize = result.Size;
                    _resulImageStream = await ReadResultAsync();
                    _outputLabel = FormatSize(result.Width, result.Height);
                }
                catch (Exception exception)
                {
                    Console.WriteLine($"Dnet.Blazor: the image could not be exported. {exception.Message}");
                    return;
                }
            }
        }

        _resulImageStream.Position = 0;
        _resultHandedOff = true;

        var dataResult = new OverlayResult()
            {
                CloseReason = CloseReason.Ok,
                ComponentData = _resulImageStream,
                OverlayReferenceId = OverlayReferenceId

            };

        DialogService.Close(dataResult);
    }

    void CancelOverlay()
    {
        var dataResult = new OverlayResult()
            {
                CloseReason = CloseReason.Cancel,
                ComponentData = null,
                OverlayReferenceId = OverlayReferenceId

            };

        DialogService.Close(dataResult);
    }

    private static string FormatSize(double width, double height)
        => $"{Convert.ToInt32(width)} x {Convert.ToInt32(height)}";

    private bool ShowControl(ImageEditorControlType control)
        => _imageEditingControls is null || _imageEditingControls.Count == 0 || _imageEditingControls.Contains(control);

    private static string GetResizerClass(string resizerType)
    {
        if (resizerType == ResizerType.TopLeft) return "dnet-crop-box-resizer-top-left";
        if (resizerType == ResizerType.TopCenter) return "dnet-crop-box-resizer-top-center";
        if (resizerType == ResizerType.TopRight) return "dnet-crop-box-resizer-top-right";
        if (resizerType == ResizerType.LeftCenter) return "dnet-crop-box-resizer-left-center";
        if (resizerType == ResizerType.RightCenter) return "dnet-crop-box-resizer-right-center";
        if (resizerType == ResizerType.BottomLeft) return "dnet-crop-box-resizer-bottom-left";
        if (resizerType == ResizerType.BottomCenter) return "dnet-crop-box-resizer-bottom-center";
        if (resizerType == ResizerType.BottomRight) return "dnet-crop-box-resizer-bottom-right";

        return string.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsInterop is not null)
        {
            await _jsInterop.DisposeAsync();
        }

        // Once the result is handed to the caller it belongs to the caller.
        if (!_resultHandedOff && OwnsResultStream())
        {
            _resulImageStream.Dispose();
        }
    }
}
