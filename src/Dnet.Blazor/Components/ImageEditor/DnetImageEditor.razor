@using System.Globalization
@using System.IO
@using Dnet.Blazor.Components.Dialog.Infrastructure.Interfaces
@using Dnet.Blazor.Components.Dialog.Infrastructure.Models
@using Dnet.Blazor.Components.ImageEditor.Infrastructure.Constants
@using Dnet.Blazor.Components.ImageEditor.Infrastructure.Enums
@using Dnet.Blazor.Components.ImageEditor.Infrastructure.Models
@using Dnet.Blazor.Components.ImageEditor.Infrastructure.Services
@using Dnet.Blazor.Components.Overlay.Infrastructure.Enums
@using Dnet.Blazor.Components.Overlay.Infrastructure.Models
@using Dnet.Blazor.Components.Overlay.Infrastructure.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop

@implements IDisposable

@inject IJSRuntime JSRuntime

@inject IStyleService StyleService
@inject IImageEditorService ImageEditorService
@inject IDialogService DialogService

@code {

    /// <summary>The largest image the editor accepts, in bytes, when <see cref="MaxFileSizes"/> is not set.</summary>
    public const long DefaultMaxFileSize = 1024 * 1024 * 15;

    /// <summary>Raised when image selected occurs.</summary>
    [Parameter]
    public EventCallback<MemoryStream> OnImageSelected { get; set; }

    /// <summary>Raised when star loading image occurs.</summary>
    [Parameter]
    public EventCallback OnStarLoadingImage { get; set; }

    /// <summary>Raised when end loading image occurs.</summary>
    [Parameter]
    public EventCallback OnEndLoadingImage { get; set; }

    /// <summary>Raised when cancel occurs.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>Gets or sets the image container height used by this component. It bounds the size the image is displayed at.</summary>
    [Parameter]
    public int ImageContainerHeight { get; set; } = 480;

    /// <summary>Gets or sets the image container width used by this component. It bounds the size the image is displayed at.</summary>
    [Parameter]
    public int ImageContainerWidth { get; set; } = 640;

    /// <summary>Gets or sets the image preview height used by this component.</summary>
    [Parameter]
    public int ImagePreviewHeight { get; set; } = 170;

    /// <summary>Gets or sets the image preview width used by this component.</summary>
    [Parameter]
    public int ImagePreviewWidth { get; set; } = 170;

    /// <summary>Gets or sets the modal dialog height used by this component.</summary>
    [Parameter]
    public int ModalDialogHeight { get; set; } = 780;

    /// <summary>Gets or sets the modal dialog width used by this component.</summary>
    [Parameter]
    public int ModalDialogWidth { get; set; } = 1024;

    /// <summary>Gets or sets the maximum size accepted for the image, in bytes. A value of zero or less uses <see cref="DefaultMaxFileSize"/>.</summary>
    [Parameter]
    public long MaxFileSizes { get; set; }

    /// <summary>Gets or sets the longest edge of the exported image. Zero keeps the native resolution of the selection.</summary>
    [Parameter]
    public int MaxOutputDimension { get; set; }

    /// <summary>Gets or sets the format the editor exports, such as <see cref="ImageFormat.PNG"/>. A null or empty value keeps the format of the selected image.</summary>
    [Parameter]
    public string OutputFormat { get; set; }

    /// <summary>Gets or sets the quality used by lossy output formats, from 1 to 100.</summary>
    [Parameter]
    public int OutputQuality { get; set; } = 95;

    /// <summary>Gets or sets the image file formats that may be selected.</summary>
    [Parameter]
    public List<string> AllowedFormats { get; set; } = new();

    /// <summary>Gets or sets the image editing controls used by this component.</summary>
    [Parameter]
    public List<ImageEditorControlType> ImageEditingControls { get; set; } = new();

    /// <summary>Gets or sets the image file used by this component.</summary>
    [Parameter]
    public IBrowserFile? ImageFile { get; set; }

    private OverlayReference _dialogReference { get; set; }


    public async Task ShowDialog(MemoryStream fullSizeImageStream)
    {
        ArgumentNullException.ThrowIfNull(fullSizeImageStream);

        var maxFileSize = MaxFileSizes > 0 ? MaxFileSizes : DefaultMaxFileSize;

        if (fullSizeImageStream.Length > maxFileSize)
        {
            throw new InvalidOperationException($"The image exceeds the configured maximum size of {maxFileSize} bytes.");
        }

        if (ImageFile is not null && AllowedFormats.Count > 0 &&
            !AllowedFormats.Any(format => string.Equals(format.TrimStart('.'), ImageFile.ContentType, StringComparison.OrdinalIgnoreCase) ||
                                          string.Equals(format, Path.GetExtension(ImageFile.Name), StringComparison.OrdinalIgnoreCase)))
        {
            throw new InvalidOperationException($"The image format '{ImageFile.ContentType}' is not allowed.");
        }

        await OnStarLoadingImage.InvokeAsync();

        var dialogConfig = new DialogConfig()
            {
                Title = "Image Editor",
                HasBackdrop = true,
                HasTransparentBackdrop = false,
                Width = $"{ModalDialogWidth}px",
                Height = $"{ModalDialogHeight}px"
            };

        fullSizeImageStream.Position = 0;

        var dialogData = new DialogData
            {
                imageFile = fullSizeImageStream,
                ImageContainerHeight = ImageContainerHeight,
                ImageContainerWidth = ImageContainerWidth,
                ImagePreviewHeight = ImagePreviewHeight,
                ImagePreviewWidth = ImagePreviewWidth,
                FileName = ImageFile?.Name,
                ModalDialogHeight = ModalDialogHeight,
                ModalDialogWidth = ModalDialogWidth,
                MaxFileSizes = maxFileSize,
                AllowedFormats = AllowedFormats,
                ImageEditingControls = ImageEditingControls,
                WorkingImageStream = fullSizeImageStream,
                MaxOutputDimension = MaxOutputDimension,
                OutputFormat = OutputFormat,
                OutputQuality = OutputQuality
            };

        var parameters = new Dictionary<string, object>();

        parameters.Add("DialogData", dialogData);

        await OnEndLoadingImage.InvokeAsync();

        _dialogReference = DialogService.Open(typeof(ImageEditorContent), parameters, dialogConfig);

        _dialogReference.Close += CloseDialog;
    }

    void CloseDialog(OverlayResult overlayDataResult)
    {
        if (overlayDataResult.CloseReason == CloseReason.Ok && overlayDataResult.ComponentData is MemoryStream stream)
        {
            OnImageSelected.InvokeAsync(stream);
        }
        else
        {
            OnCancel.InvokeAsync();
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_dialogReference != null) _dialogReference.Close -= CloseDialog;
    }
}
