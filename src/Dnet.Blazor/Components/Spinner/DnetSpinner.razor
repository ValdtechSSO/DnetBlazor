@using Dnet.Blazor.Components.Spinner.Infrastructure.Interfaces

@inject ISpinnerService SpinnerService

@implements IDisposable

@if (_isVisible && CanRun)
{
    @if (ShowMask)
    {
        <input @ref="_spinnermask" style="position: absolute; left:-1000px;height:0px;top:50%;" />
        <div class="mask-spinner" style="width: @_width; height: @_height; position: @_position"></div>
    }

    <div class="spinner" role="status" aria-live="polite" style="top:@_top; left: @_left; position: @_position">
        <span class="visually-hidden">Loading</span>
        <div class="rect1"></div>
        <div class="rect2"></div>
        <div class="rect3"></div>
        <div class="rect4"></div>
        <div class="rect5"></div>
    </div>
}

@code {
    [Parameter] public bool CanRun { get; set; }
    [Parameter] public bool BindToView { get; set; }
    [Parameter] public bool ShowMask { get; set; }
    [Parameter] public int DebounceTime { get; set; } = 250;

    private int _counterRequest;
    private bool _isVisible;
    private bool _disposed;
    private ElementReference _spinnermask;
    private string _top = "50%";
    private string _left = "50%";
    private string _width = "100vw";
    private string _height = "100vh";
    private string _position = "absolute";
    private CancellationTokenSource? _showCancellation;

    protected override void OnInitialized()
    {
        UpdateLayout();
        SpinnerService.OnCounterReceived += CounterUpdated;
    }

    protected override void OnParametersSet() => UpdateLayout();

    private void UpdateLayout()
    {
        _position = BindToView ? "fixed" : "absolute";
        _width = BindToView ? "100vw" : "50%";
        _height = BindToView ? "100vh" : "50%";
    }

    // Action is a synchronous service event; dispatch its asynchronous UI work explicitly.
    private void CounterUpdated(int counter) => _ = InvokeAsync(() => UpdateCounterAsync(counter));

    private async Task UpdateCounterAsync(int counter)
    {
        if (_disposed)
        {
            return;
        }

        _counterRequest = Math.Max(0, _counterRequest + counter);
        if (_counterRequest == 0)
        {
            CancelPendingShow();
            _isVisible = false;
            StateHasChanged();
            return;
        }

        if (_isVisible || _showCancellation is not null)
        {
            return;
        }

        var cancellation = _showCancellation = new CancellationTokenSource();
        try
        {
            await Task.Delay(Math.Max(0, DebounceTime), cancellation.Token);
            if (!_disposed && _counterRequest > 0 && ReferenceEquals(_showCancellation, cancellation))
            {
                _isVisible = true;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (ReferenceEquals(_showCancellation, cancellation))
            {
                _showCancellation = null;
                cancellation.Dispose();
            }
        }
    }

    private void CancelPendingShow()
    {
        _showCancellation?.Cancel();
        _showCancellation?.Dispose();
        _showCancellation = null;
    }

    public void Dispose()
    {
        _disposed = true;
        SpinnerService.OnCounterReceived -= CounterUpdated;
        CancelPendingShow();
    }
}
