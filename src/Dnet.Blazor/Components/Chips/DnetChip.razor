@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using System.Timers
@using Dnet.Blazor.Infrastructure.Services.CssBuilder

@implements IDisposable

<div class="dnet-chip dnet-standard-chip dnet-chip-with-trailing-icon dnet-chip-size-@_chipSizeClass"
     style="@_dnetChipStyle"
     role="button"
     tabindex="@(Disabled ? -1 : 0)"
     aria-pressed="@(IsSelected() ? "true" : "false")"
     aria-disabled="@Disabled"
     @onclick="Toggle"
     @onkeydown="HandleKeyDown">
	@if (ChildContent != null)
	{
		@ChildContent
	}
	else
	{
		<div style="display:flex;align-items:center;">
			@if (!string.IsNullOrEmpty(AvatarIcon))
			{
				<div class="dnet-chips-icon-wrapper dnet-m-r-5">
					<span style="--_icon-scale:@_valuesBySize.BackGroundSize;background-size:@_valuesBySize.BackGroundSize" class="dnet-chips-icon @AvatarIcon"></span>
				</div>
			}
			<span>@Value</span>
		</div>
	}
	@if (Removable)
	{
		<button type="button" disabled="@Disabled" @onclick="RemoveChip" @onclick:stopPropagation="true" class="dnet-chip-remove dnet-chip-trailing-icon" aria-label="Remove chip">
			<div class="dnet-chips-icon-wrapper">
				<span style="--_icon-scale:@_valuesBySize.BackGroundSize;background-size:@_valuesBySize.BackGroundSize" class="dnet-chips-icon @(string.IsNullOrEmpty(RemoveIcon) ? "dnet-chips-icon-remove" : @RemoveIcon)"></span>
			</div>
		</button>
	}
</div>

@code {

	[CascadingParameter]
	private DnetChipList Parent { get; set; }

	[Parameter]
	public EventCallback<string> OnSelectionChange { get; set; }

	[Parameter]
	public EventCallback<DnetChip> OnRemoved { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter]
	public string? BackgroungColor { get; set; }

	[Parameter]
	public string? Color { get; set; }

	[Parameter]
	public string? BackgroungColorSelected { get; set; }

	[Parameter]
	public string? ColorSelected { get; set; }

	[Parameter]
	public bool Selectable { get; set; } = true;

	[Parameter]
	public bool Selected { get; set; }

	[Parameter]
	public bool Removable { get; set; } = true;

	[Parameter]
	public string? Value { get; set; }

	[Parameter]
	public ChipSize ChipSize { get; set; } = ChipSize.Small;

	[Parameter]
	public bool Disabled { get; set; }

	[Parameter]
	public string? RemoveIcon { get; set; }

	[Parameter]
	public string? AvatarIcon { get; set; }

	internal int Id { get; set; }

	private bool _selected { get; set; } = false;

	private ValuesBySize _valuesBySize { get; set; } = new();

	private string _dnetChipStyle =>
		new StyleBuilder()
			.AddStyle("background-color", BackgroungColor, when: !IsSelected() && !string.IsNullOrEmpty(BackgroungColor))
			.AddStyle("color", Color, when: !IsSelected() && !string.IsNullOrEmpty(Color))
			.AddStyle("background-color", BackgroungColorSelected, when: IsSelected() && !string.IsNullOrEmpty(BackgroungColorSelected))
			.AddStyle("color", ColorSelected, when: IsSelected() && !string.IsNullOrEmpty(ColorSelected))
		.Build();

	private string _chipSizeClass =>
		ChipSize switch
		{
			ChipSize.Large => "lg",
			ChipSize.Medium => "md",
			ChipSize.ExtraSmall => "xs",
			_ => "sm"
		};

	protected override void OnInitialized()
	{
		_valuesBySize = GetValuesBySize();

		Parent.AddChip(this);
	}

	protected override void OnParametersSet()
	{
		_selected = Selected;
	}

	private ValuesBySize GetValuesBySize()
	{
		var valuesBySize = new ValuesBySize();

		switch (ChipSize)
		{
			case ChipSize.Large:
				valuesBySize.BackGroundSize = "1em";
				break;

			case ChipSize.Medium:
				valuesBySize.BackGroundSize = "1rem";
				break;

			case ChipSize.ExtraSmall:
				valuesBySize.BackGroundSize = "0.8em";
				break;

			default:
				valuesBySize.BackGroundSize = "0.875em";
				break;
		}

		return valuesBySize;
	}

	private async Task Toggle()
	{
		if (Disabled || !SelectThisChip(!IsSelected())) return;

		await Parent.ChipClicked(this);
		StateHasChanged();
	}

	private async Task HandleKeyDown(KeyboardEventArgs args)
	{
		if (args.Key is "Enter" or " ")
		{
			await Toggle();
		}
	}

	public bool IsSelected()
	{
		return _selected;
	}

	public bool SelectThisChip(bool newValue)
	{
		if (Disabled || !Selectable || _selected == newValue) { return false; }

		_selected = newValue;

		return true;
	}

	public async Task RemoveChip()
	{
		if (Disabled || !Removable) { return; }

		Parent.RemoveChip(this);

		await OnRemoved.InvokeAsync(this);
	}

	public void Dispose()
	{
		Parent?.RemoveChip(this);
	}
}
