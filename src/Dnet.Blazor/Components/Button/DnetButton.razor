@using Dnet.Blazor.Infrastructure.Services.CssBuilder
@using Microsoft.AspNetCore.Components.Web

<button @ref="_focusElement" type="@ButtonType" @onclick="ClickAsync" class="@_cssClasses" @attributes="FilteredAdditionalAttributes">
	<span class="dnet-button-wrapper">@ChildContent</span>
	<span class="dnet-button-focus-overlay"></span>
</button>

@code {

	/// <summary>Gets or sets whether the component receives focus after it is rendered.</summary>
	[Parameter]
	public bool InitialFocus { get; set; }

	/// <summary>Gets or sets unmatched HTML attributes applied to the rendered element.</summary>
	[Parameter(CaptureUnmatchedValues = true)]
	public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Raised when the user clicks the component.</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>Gets or sets the HTML button type rendered by the component.</summary>
    [Parameter]
    public string ButtonType { get; set; } = "button";

	/// <summary>Gets or sets the child content rendered by the component.</summary>
	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	private ElementReference _focusElement;

	private string? _cssClasses { get; set; }

    private static readonly IReadOnlyDictionary<string, object> EmptyAttributes = new Dictionary<string, object>();

    private IEnumerable<KeyValuePair<string, object>> FilteredAdditionalAttributes
        => (AdditionalAttributes ?? EmptyAttributes).Where(attribute => !attribute.Key.Equals("class", StringComparison.OrdinalIgnoreCase) && !attribute.Key.Equals("type", StringComparison.OrdinalIgnoreCase));


    protected override void OnParametersSet()
	{
		_cssClasses = GetCssClasses();
	}

	private string GetCssClasses()
	{
		var classes = new CssBuilder("dnet-button")
		.AddClass("dnet-button-initial-focus", when: InitialFocus);

        foreach (var item in (AdditionalAttributes ?? EmptyAttributes).Where(p => p.Key.Equals("class", StringComparison.OrdinalIgnoreCase)))
		{
			classes.AddClass(item.Value.ToString() ?? string.Empty);
		}

		var result = classes.Build();

		return result;
	}

    private Task ClickAsync()
    {
        return OnClick.InvokeAsync();
	}
}
