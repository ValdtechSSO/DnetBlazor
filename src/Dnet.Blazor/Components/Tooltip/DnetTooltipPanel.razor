@using Dnet.Blazor.Components.Tooltip.Infrastructure.Interfaces
@using Dnet.Blazor.Infrastructure.Services.CssBuilder
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div id="@TooltipId" role="tooltip" class="@_cssClasses" style="@_styles">
    <div class="dnet-tooltip-content">
        @Text
        @ContentChild
        @if (ComponentType != null)
        {
            <DynamicComponent Type="@ComponentType" Parameters="@Parameters" />
        }
    </div>
</div>

@code {
    [CascadingParameter] private int OverlayReferenceId { get; set; }

    /// <summary>Gets or sets custom content rendered by the component.</summary>
    [Parameter]
    public RenderFragment? ContentChild { get; set; }

    /// <summary>Gets or sets the component type rendered dynamically.</summary>
    [Parameter]
    public Type? ComponentType { get; set; } = null;

    /// <summary>Gets or sets parameters passed to the dynamically rendered component.</summary>
    [Parameter]
    public IDictionary<string, object>? Parameters { get; set; }

    /// <summary>Gets or sets the text used by this component.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Gets or sets the tooltip color used by this component.</summary>
    [Parameter]
    public string? TooltipColor { get; set; }

    /// <summary>Gets or sets the tooltip foreground used by this component.</summary>
    [Parameter]
    public string? TooltipForeground { get; set; }

    /// <summary>Gets or sets the tooltip class used by this component.</summary>
    [Parameter]
    public string? TooltipClass { get; set; }

    /// <summary>Gets or sets the trigger element used by this component.</summary>
    [Parameter]
    public ElementReference TriggerElement { get; set; }

    /// <summary>Gets or sets the maximum component width.</summary>
    [Parameter]
    public string? MaxWidth { get; set; }

    /// <summary>Gets or sets the maximum component height.</summary>
    [Parameter]
    public string? MaxHeight { get; set; }


    private string? _cssClasses { get; set; }

    private string? _styles { get; set; }

    private string TooltipId => $"dnet-tooltip-{OverlayReferenceId}";


    protected override void OnInitialized()
    {
        UpdateStyles();
    }

    protected override void OnParametersSet()
    {
        UpdateStyles();
    }

    private void UpdateStyles()
    {
        _cssClasses = GetCssClasses();

        _styles = GetStyles();
    }

    private string GetCssClasses()
    {
        var classes = new CssBuilder("dnet-tooltip")
            .AddClass(TooltipClass, !string.IsNullOrEmpty(TooltipClass))
            .Build();

        return classes;
    }

    private string GetStyles()
    {
        var styles = new StyleBuilder()
            .AddStyle("max-height", MaxHeight)
            .AddStyle("max-width", MaxWidth)
            .AddStyle("background", TooltipColor)
            .AddStyle("color", TooltipForeground)
            .Build();

        return styles;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("dnetinterop.addAriaDescribedBy", TriggerElement, TooltipId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("dnetinterop.removeAriaDescribedBy", TriggerElement, TooltipId);
        }
        catch (JSDisconnectedException)
        {
            // The browser session ended before the overlay could be detached.
        }
    }
}
