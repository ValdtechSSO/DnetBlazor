<div class="dnet-property-form-group">
    <span class="dnet-property-name">@Property</span>
    <span class="dnet-property-value">@ChildContent</span>
</div>

@code {
    /// <summary>Gets or sets the property used by this component.</summary>
    [Parameter]
    public string? Property { get; set; }

    /// <summary>Gets or sets the child content rendered by the component.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
