<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Authors>Adrian Mustelier Camino</Authors>
		<Company>Datalnet</Company>
		<Product>Datalnet Blazor Components</Product>
		<Description>Set of Components for Blazor Framework</Description>
		<Copyright>Datalnet</Copyright>
		<PackageTags>Blazor-Components-Datalnet</PackageTags>
		<PackageVersion>6.0.19-rc.2</PackageVersion>
		<PackageProjectUrl>https://datalnet.com/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ValdtechSSO/DnetBlazor</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>
			- PickList uses the shared search field and List background, with controlled input synchronization.
			- PickList searching and clearing preserve the state of a containing EditForm.
			- List and PickList use consistent spacing, aligned controls and responsive pagination.
			- Form clear actions use a subtle outlined circle with an X.
			- Tabs add configurable inner padding, and Stepper examples provide a padded action footer.
			- Checkboxes and radio buttons add 10px between indicators and text while preserving unlabeled controls.
			- Targets .NET 11 RC2.
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<!-- Both catalogs live in the main assembly so WASM can switch languages
	     without downloading a new satellite assembly or reloading the page. -->
	<ItemGroup>
		<EmbeddedResource Update="Localization/DnetStrings.resx" LogicalName="Dnet.Blazor.Localization.DnetStrings.resources" />
		<EmbeddedResource Update="Localization/DnetStrings.en.resx" WithCulture="false" LogicalName="Dnet.Blazor.Localization.DnetEnglishStrings.resources" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components" Version="11.0.0-rc.2.26504.105" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rc.2.26504.105" />
		<PackageReference Include="Microsoft.Extensions.Localization" Version="11.0.0-rc.2.26504.105" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.2.26504.105" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="wwwroot\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Remove="Components\PickList\PickList.razor.css" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Components\Grid\BlgSingleFilter\" />
	</ItemGroup>

</Project>
