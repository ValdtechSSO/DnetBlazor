<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Authors>Adrian Mustelier Camino</Authors>
		<Company>Datalnet</Company>
		<Product>Datalnet Blazor Components</Product>
		<Description>Set of Components for Blazor Framework</Description>
		<Copyright>Datalnet</Copyright>
		<PackageTags>Blazor-Components-Datalnet</PackageTags>
		<PackageVersion>6.0.17-rc.2</PackageVersion>
		<PackageProjectUrl>https://datalnet.com/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ValdtechSSO/DnetBlazor</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>
			- Added DnetPillTabs with optional counts, selection binding, keyboard navigation and RTL support.
			- Added horizontal scrolling with hidden scrollbars and adaptive edge fades.
			- Added a sample, component documentation and simultaneous VS Code launch profiles.
			- Targets .NET 11 RC2.
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components" Version="11.0.0-rc.2.26504.105" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rc.2.26504.105" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="wwwroot\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Remove="Components\PickList\PickList.razor.css" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Components\Grid\BlgSingleFilter\" />
	</ItemGroup>

</Project>
